@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@using LabWebMvc.MVC.Areas.Utils
@model vmPlanoExames
@{
    Layout = "_Layout";
}
<script>
    $(document).ready(function () {
        initBtnVoltar();
        $('#clickSubmit').click(function (event) {
            event.preventDefault();
            $.ajax({
                //url: '@Url.Action("AlterarPlanoExames", "PlanoExames")',
                type: "POST",
                async: true,
                dataType: "json",
                data: $('#form').serialize(),
                success: function (data) {
                    //console.log("data: ", data);
                    var titulo = data['titulo'];
                    var mensagem = data['mensagem'];
                    var actionPos = data['action'];
                    var sucesso = data['sucesso'];
                    titulo = (titulo == null) ? 'Atenção' : data['titulo'];
                    var tipo = 'falha';
                    if (sucesso == true) tipo = 'sucesso';
                    //success: Javascript ::: aqui acontece todas as mensagens de sucesso e não sucesso
                    clickAviso(titulo, mensagem, tipo, actionPos);  //mensagem normal com desvio para outra action (site.js)
                },
                error: function (request, status, error) {
                    //aqui somente acontece no caso de exception/erro do javascript
                    clickAviso('Interrompido', 'Falha na execução', 'critica', actionPos);  //mensagem crítica e com desvio para outra action (site.js)
                }
            });
        })
    });
</script>

@using (Html.BeginForm(FormMethod.Post, new { @class = "form-horizontal", @id = "form", @enctype = "multipart/form-data" }))  //@id="form" é obrigatório para campos chegarem do outro lado
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="lab-form-container lab-refined">

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-clipboard-list"></i> Descrição do Exame
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-full">
                        <label>Descrição do Exame</label>
                        <div class="field-readonly" style="font-weight: 500;">@TempData["Descricao"]</div>
                        @{
                            var geral = new vmGeral();
                            geral.Aviso = Utils.AvisoHtml("Aviso", "A alteração irá atualizar a descrição <b>" + @TempData["Descricao"] + "</b>, em todas as instituições do plano.");
                            @Html.Raw(geral.Aviso)
                        }
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-xl">
                        @if (ViewBag.TipoContaExame == 0)
                        {
                            <label>Descrição conta principal</label>
                        }
                        else
                        {
                            <label>Descrição conta item</label>
                        }
                        @Html.TextBoxFor(p => p.Descricao, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-sliders"></i> Configurações do Item
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-xs">
                        @{
                            ICollection<int> listaEtiquetas = new HashSet<int>();
                        }
                        @for (int i = 0; i <= 10; i++)
                        {
                            listaEtiquetas.Add(i);
                        }
                        <label>Quantidade de Etiquetas (Máximo de 10)</label>
                        @Html.DropDownListFor(p => p.Etiquetas, new SelectList(listaEtiquetas, "Value"), new { style = "width:50px", size = "1" })
                    </div>
                    <div class="field-group w-sm">
                        <label>Prazo Entrega em Dias</label>
                        @Html.TextBoxFor(p => p.PrazoResultadoDias, new { @class = "form-control" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>Colocar na lista de itens de rotina?</label>
                        <div class="radio-group">
                            @for (int i = 0; i < Utils.ListaSN().Count; i++)
                            {
                                int rotinaIndex = Utils.RetornaItem(i, "ListaSN", 0).ToInt32();  //index
                                string rotinaSigla = Utils.RetornaItem(i, "ListaSN", 1);
                                string rotinaDescricao = Utils.RetornaItem(i, "ListaSN", 2);
                                bool check = (rotinaIndex == 0);
                                <span>
                                    @Html.RadioButton("Seleciona", rotinaIndex, check)
                                    <label>@rotinaDescricao</label>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="field-group w-md">
                        <label>Mostrar este item na recepção?</label>
                        <div class="radio-group">
                            @for (int i = 0; i < Utils.ListaSN().Count; i++)
                            {
                                int recepcaoIndex = Utils.RetornaItem(i, "ListaSN", 0).ToInt32();  //index
                                string recepcaoSigla = Utils.RetornaItem(i, "ListaSN", 1);
                                string recepcaoDescricao = Utils.RetornaItem(i, "ListaSN", 2);
                                bool check = (recepcaoIndex == 0);
                                <span>
                                    @Html.RadioButton("NaoMostrar", recepcaoIndex, check)
                                    <label>@recepcaoDescricao</label>
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>Resultado Mínimo Permitido</label>
                        @Html.TextBoxFor(p => p.ResultadoMinimo, new { @class = "form-control", @type = "number", @step = "any" })
                    </div>
                    <div class="field-group w-md">
                        <label>Resultado Máximo Permitido</label>
                        @Html.TextBoxFor(p => p.ResultadoMaximo, new { @class = "form-control", @type = "number", @step = "any" })
                        <div class="field-hint">Intervalo numérico aceito no lançamento de resultados.</div>
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>Gráfico Evolutivo</label>
                        <div class="radio-group">
                            <span>
                                @Html.CheckBoxFor(p => p.GraficoNoItemBool)
                                <label>Mostrar gráfico evolutivo no item de exame</label>
                            </span>
                        </div>
                        <div class="field-hint">Disponível apenas para resultados numéricos ou percentuais.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group" style="margin-top: 16px;">
            <button type="button" id="btnVoltar" class="btn btn-lg btn-secondary lab-btn" style="margin-right: 10px;">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </button>
            <button id="clickSubmit" type="submit" class="btn btn-lg btn-success botao-verde lab-btn">
                Salvar
            </button>
        </div>

    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
