@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@model vmPlanoExames
@{
    Layout = "_Layout";
}
<script>
    $(document).ready(function () {
        initBtnVoltar();
        $(".close").click(function (event) {
            event.preventDefault();
            window.history.back();
        });
    });
</script>
<!-- Trigger/Open The Modal -->
<div id="myModal" class="modal">
    <!-- Modal content -->
    <div class="modal-content">
        <div class="modal-header bg-verde-escuro">
            <h5 class="modal-title">@ViewBag.TextoMenu[0]</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body lab-refined">
            <div class="card-secao card-secao-w-lg">
                <div class="card-secao-header">
                    <i class="fa-solid fa-clipboard-list"></i> Dados do Exame
                </div>
                <div class="card-secao-body">
                    <div class="field-row">
                        <div class="field-group w-md">
                            <label>Conta Exame</label>
                            <div class="field-readonly">@Model.ContaExame</div>
                        </div>
                        <div class="field-group w-md">
                            <label>Tabela de Exames</label>
                            <div class="field-readonly">@Model.Id</div>
                        </div>
                        <div class="field-group w-md">
                            <label>Tabela Preços</label>
                            <div class="field-readonly">@Model.TabelaExamesId</div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-group w-md">
                            <label>Folha</label>
                            <div class="field-readonly">@Model.RefExame</div>
                        </div>
                        <div class="field-group w-md">
                            <label>Principal</label>
                            <div class="field-readonly">@Model.RefItem</div>
                        </div>
                        <div class="field-group w-lg">
                            <label>Item</label>
                            <div class="field-readonly">@Model.Descricao</div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-group w-md">
                            <label>Unidade de Medida</label>
                            <div class="field-readonly">@Model.UnidadeMedida</div>
                        </div>
                        <div class="field-group w-sm">
                            <label>Prazo Entrega em Dias</label>
                            <div class="field-readonly">@Model.PrazoResultadoDias</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer" style="justify-content: center;">
            <button type="button" id="btnVoltar" class="btn btn-secondary lab-btn">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </button>
        </div>
    </div>
</div>
<!-- Meu JS (sempre no final) para poder renderizar junto com a página -->
<script src="@Url.Content("~/js/site.js")" type="text/javascript"></script>
<!-- Fim da página do Modal -->
