@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<partial name='Partials/_PartialMenuMapasTrabalho' />

@*Feito pelo Qoder em 23/08/2026 — Ficha 40 Colunas (portabilidade do FFicha40Colunas.pas):
    filtro das folhas com coletas pendentes, lista de coletas da folha e impressão
    térmica (40 colunas) da ficha única ou de todas as fichas da folha. *@

<!-- Período e Filtro das Folhas -->
<div id="filtrosFicha40" class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-filter"></i> 1º Passo — Filtrar Exames
    </div>
    <div class="card-secao-body">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
            <label style="font: normal 13px calibri, arial, sans-serif;">Data Inicial:</label>
            <input type="date" id="filtroDataInicial"
                   style="width: 150px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

            <label style="font: normal 13px calibri, arial, sans-serif; margin-left: 12px;">Data Final:</label>
            <input type="date" id="filtroDataFinal"
                   style="width: 150px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

            <label style="font: normal 13px calibri, arial, sans-serif; margin-left: 12px;">
                <input type="checkbox" id="filtroSomenteSemResultados" checked /> Somente sem resultados
            </label>

            <button type="button" id="btnFiltrarFolhas" class="btn btn-success btn-sm" style="display: inline-block;">
                <i class="fa-solid fa-filter"></i> Filtrar Exames
            </button>
        </div>
    </div>
</div>

<!-- Folhas de Exame -->
<div class="card-secao" style="margin-top:10px;">
    <div class="card-secao-header">
        <i class="fa-solid fa-table-list"></i> Folhas com Coletas Pendentes — selecione uma folha
    </div>
    <div class="card-secao-body">
        <div class="table-responsive" style="max-height: 220px; overflow-y: auto;">
            <table class="table table-sm table-bordered" style="font-size:13px;">
                <thead style="background-color:#d4edda;">
                    <tr>
                        <th style="width:60%;">Folha de Exame</th>
                        <th style="width:25%;">Última Coleta</th>
                        <th style="width:15%;">Última Conta</th>
                    </tr>
                </thead>
                <tbody id="tabelaFolhasBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Coletas da Folha -->
<div class="card-secao" style="margin-top:10px;">
    <div class="card-secao-header">
        <i class="fa-solid fa-list"></i> 2º Passo — Coletas da Folha Selecionada
    </div>
    <div class="card-secao-body">
        <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
            <table class="table table-sm table-bordered" style="font-size:13px;">
                <thead style="background-color:#cfe2ff;">
                    <tr>
                        <th style="width:18%;">Código de Coleta</th>
                        <th style="width:10%;">Nº Exame</th>
                        <th style="width:12%;">Instituição</th>
                        <th style="width:10%;">Cód. Cliente</th>
                        <th style="width:50%;">Nome do Cliente</th>
                    </tr>
                </thead>
                <tbody id="tabelaColetasBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Impressão Térmica -->
<div class="card-secao" style="margin-top:10px; margin-bottom:150px;">
    <div class="card-secao-header">
        <i class="fa-solid fa-receipt"></i> Impressão Térmica — Ficha 40 Colunas
    </div>
    <div class="card-secao-body">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
            <button type="button" id="btnImprimirFichaUnica" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-print"></i> Imprimir Ficha Única (Selecionada)
            </button>
            <button type="button" id="btnImprimirTodas" class="btn btn-warning btn-sm">
                <i class="fa-solid fa-print"></i> Imprimir Todas as Fichas da Folha
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var folhaSelecionada = '';
        var coletaSelecionada = null;

        // Feito pelo Qoder em 23/08/2026 — campos de data agora são <input type="date">
        // (valor ISO yyyy-MM-dd); o controller continua recebendo dd/MM/yyyy.
        function hojeIso() {
            var d = new Date();
            return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
        }

        function dataBr(valorIso) {
            if (!valorIso) return '';
            var p = valorIso.split('-');
            return p[2] + '/' + p[1] + '/' + p[0];
        }

        function carregarColetas(nomeFolha) {
            folhaSelecionada = nomeFolha;
            coletaSelecionada = null;

            $.ajax({
                url: '/MapasTrabalho/ObterColetasFicha40',
                type: 'POST',
                data: {
                    nomeFolha: nomeFolha,
                    dataInicial: dataBr($('#filtroDataInicial').val()),
                    dataFinal: dataBr($('#filtroDataFinal').val())
                },
                dataType: 'json',
                success: function (data) {
                    var $body = $('#tabelaColetasBody');
                    $body.empty();
                    if (!data.sucesso) { clickAviso('Erro', data.mensagem, 'critica', null); return; }

                    data.coletas.forEach(function (coleta) {
                        var $tr = $('<tr>')
                            .addClass('linha-coleta')
                            .css('cursor', 'pointer')
                            .attr('data-controle', coleta.controleApoio)
                            .attr('data-prefixo', coleta.prefixoConta);
                        $tr.append($('<td>').text(coleta.coletaFormatada));
                        $tr.append($('<td>').text(coleta.examesRealizadosId));
                        $tr.append($('<td>').text(coleta.instituicaoSequencial));
                        $tr.append($('<td>').text(coleta.pacienteId));
                        $tr.append($('<td>').text(coleta.nomePaciente));
                        $body.append($tr);
                    });
                },
                error: function () { clickAviso('Erro', 'Falha de comunicação ao listar as coletas.', 'critica', null); }
            });
        }

        $(document).ready(function () {
            $('#filtroDataInicial').val(hojeIso());
            $('#filtroDataFinal').val(hojeIso());

            $('#btnFiltrarFolhas').on('click', function () {
                $.ajax({
                    url: '/MapasTrabalho/ObterFolhasFicha40',
                    type: 'POST',
                    data: {
                        dataInicial: dataBr($('#filtroDataInicial').val()),
                        dataFinal: dataBr($('#filtroDataFinal').val()),
                        somenteSemResultados: $('#filtroSomenteSemResultados').is(':checked')
                    },
                    dataType: 'json',
                    success: function (data) {
                        var $body = $('#tabelaFolhasBody');
                        $body.empty();
                        $('#tabelaColetasBody').empty();
                        folhaSelecionada = '';
                        coletaSelecionada = null;

                        if (!data.sucesso) { clickAviso('Erro', data.mensagem, 'critica', null); return; }
                        if (!data.folhas || data.folhas.length === 0) {
                            clickAviso('Atenção', 'Nenhuma folha com coletas pendentes no período informado.', 'normal', null);
                            return;
                        }

                        data.folhas.forEach(function (folha) {
                            var $tr = $('<tr>')
                                .addClass('linha-folha')
                                .css('cursor', 'pointer')
                                .attr('data-folha', folha.nomeFolha);
                            $tr.append($('<td>').text(folha.nomeFolha));
                            $tr.append($('<td>').text(folha.controleApoio));
                            $tr.append($('<td>').text(folha.contaExame));
                            $body.append($tr);
                        });
                    },
                    error: function () { clickAviso('Erro', 'Falha de comunicação ao filtrar as folhas.', 'critica', null); }
                });
            });

            $('#tabelaFolhasBody').on('click', '.linha-folha', function () {
                $('#tabelaFolhasBody tr').css('background-color', '');
                $(this).css('background-color', '#d1e7dd');
                carregarColetas($(this).attr('data-folha'));
            });

            $('#tabelaColetasBody').on('click', '.linha-coleta', function () {
                $('#tabelaColetasBody tr').css('background-color', '');
                $(this).css('background-color', '#cfe2ff');
                coletaSelecionada = {
                    controleApoio: $(this).attr('data-controle'),
                    prefixoConta: $(this).attr('data-prefixo')
                };
            });

            $('#btnImprimirFichaUnica').on('click', function () {
                if (!folhaSelecionada) { clickAviso('Atenção', 'Selecione primeiro a folha de exame.', 'normal', null); return; }
                if (!coletaSelecionada) { clickAviso('Atenção', 'Selecione primeiro a coleta na lista.', 'normal', null); return; }

                Swal.fire({
                    title: 'Imprimir Ficha Única',
                    text: 'Deseja Imprimir Ficha Única para "' + folhaSelecionada + '" ?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim, imprimir',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    window.location.href = '/MapasTrabalho/ImprimirFichaQuarentaColunas?controleApoio=' +
                        encodeURIComponent(coletaSelecionada.controleApoio) +
                        '&prefixoConta=' + encodeURIComponent(coletaSelecionada.prefixoConta);
                });
            });

            $('#btnImprimirTodas').on('click', function () {
                if (!folhaSelecionada) { clickAviso('Atenção', 'Selecione primeiro a folha de exame.', 'normal', null); return; }

                Swal.fire({
                    title: 'Imprimir Todas as Fichas',
                    text: 'Deseja Imprimir Todas as Fichas para "' + folhaSelecionada + '" ?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim, imprimir',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    window.location.href = '/MapasTrabalho/ImprimirTodasFichasQuarentaColunas?nomeFolha=' +
                        encodeURIComponent(folhaSelecionada) +
                        '&dataInicial=' + encodeURIComponent(dataBr($('#filtroDataInicial').val())) +
                        '&dataFinal=' + encodeURIComponent(dataBr($('#filtroDataFinal').val()));
                });
            });
        });
    </script>
}

<style>
    /*Feito pelo Qoder em 23/08/2026*/
    #tabelaFolhasBody tr:hover,
    #tabelaColetasBody tr:hover {
        background-color: #f0f8f0;
    }
    @@media (max-width: 768px) {
        #filtrosFicha40 .card-secao-body > div {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
@*..Qoder*@
