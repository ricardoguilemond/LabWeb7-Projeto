@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BLL
@using static BLL.UtilBLL

<partial name='Partials/_PartialMenuMapasTrabalho' />

@*Feito pelo Qoder em 23/08/2026 — Mapa Eletrônico (portabilidade do FProducao.pas):
    lista de contas de exame pendentes no período + lançamento de resultados
    em tela única + impressão térmica da Lista de Coletas (40 colunas). *@

<!-- Filtros do Período -->
<div id="filtrosMapaEletronico" class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-calendar-days"></i> Período do Mapa Eletrônico
    </div>
    <div class="card-secao-body">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
            <label style="font: normal 13px calibri, arial, sans-serif;">Data Inicial:</label>
            <input type="date" id="filtroDataInicial"
                   style="width: 150px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

            <label style="font: normal 13px calibri, arial, sans-serif;">Data Final:</label>
            <input type="date" id="filtroDataFinal"
                   style="width: 150px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

            <button type="button" id="btnCarregarMapa" class="btn btn-success btn-sm" style="display: inline-block;">
                <i class="fa-sharp fa-solid fa-magnifying-glass"></i> Carregar Mapa
            </button>
        </div>
    </div>
</div>

<!-- Grid de Contas Pendentes -->
<div class="card-secao" style="margin-top:10px;">
    <div class="card-secao-header">
        <i class="fa-solid fa-list-check"></i> Itens Pendentes de Resultado (clique para lançar)
    </div>
    <div class="card-secao-body">
        <div class="table-responsive">
            <table id="tabelaItensMapa" class="table table-sm table-bordered table-hover" style="font-size:14px;">
                <thead style="background-color:#d4edda;">
                    <tr>
                        <th style="width:14%;">Conta</th>
                        <th style="width:30%;">Folha de Exame</th>
                        <th style="width:42%;">Descrição do Item</th>
                        <th style="width:14%;">Pendentes</th>
                    </tr>
                </thead>
                <tbody id="tabelaItensMapaBody">
                </tbody>
            </table>
        </div>
        <div id="msgMapaVazio" style="display:none; color:#856404; background-color:#fff3cd; border:1px solid #ffeeba; border-radius:6px; padding:8px; font-size:13px;">
            Não encontrei Exames que façam parte do Mapa Eletrônico!
        </div>
    </div>
</div>

<!-- Painel de Lançamento de Resultados -->
<div id="painelLancamento" style="display:none; margin-top:10px; margin-bottom:150px;">
    <div id="painelItemAnalisado" style="padding:8px 12px; border:1px solid #69c38a; border-radius:6px; background-color:#e8f5e9; font-size:15px; font-weight:bold; line-height:1.6;">
    </div>

    <div style="margin-top:8px; margin-bottom:8px; display:flex; flex-wrap:wrap; gap:6px; align-items:center;">
        <button type="button" id="btnImprimirListaColetas" class="btn btn-success btn-sm">
            <i class="fa-solid fa-print"></i> Imprimir Lista de Coletas
        </button>
        <button type="button" id="btnVoltarMapa" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Voltar ao Mapa
        </button>
        <label style="font: normal 13px calibri, arial, sans-serif; margin-left:12px;">Buscar Coleta:</label>
        <input type="text" id="edtBuscaColeta" placeholder="Número da coleta"
               style="width: 140px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />
    </div>

    <table class="table table-sm table-bordered" style="font-size:14px;">
        <thead style="background-color:#d4edda;">
            <tr>
                <th style="width:14%;">Coleta</th>
                <th style="width:32%;">Paciente</th>
                <th style="width:26%;">Resultado</th>
                <th style="width:12%;">Unidade</th>
                <th style="width:16%;">Referência</th>
            </tr>
        </thead>
        <tbody id="gridLancamentoBody">
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var periodoAtual = { dataInicial: '', dataFinal: '' };
        var contaSelecionada = { contaChave: '', contaMascara: '', descricao: '', refExame: '' };

        // Feito pelo Qoder em 23/08/2026 — campos de data agora são <input type="date">
        // (valor ISO yyyy-MM-dd); o controller continua recebendo dd/MM/yyyy.
        function hojeIso() {
            var d = new Date();
            return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
        }

        function dataBr(valorIso) {
            if (!valorIso) return '';
            var p = valorIso.split('-');
            return p[2] + '/' + p[1] + '/' + p[0];
        }

        function formatarColeta(controle) {
            if (!controle || controle.length < 8) return controle || '';
            var seq = controle.length >= 12 ? controle.substring(8, 12) : controle.substring(8);
            return controle.substring(0, 4) + '.' + controle.substring(4, 6) + '.' + controle.substring(6, 8) + '-' + seq;
        }

        function carregarMapa() {
            periodoAtual.dataInicial = dataBr($('#filtroDataInicial').val());
            periodoAtual.dataFinal = dataBr($('#filtroDataFinal').val());

            $.ajax({
                url: '/MapasTrabalho/ObterItensMapaEletronico',
                type: 'POST',
                data: { dataInicial: periodoAtual.dataInicial, dataFinal: periodoAtual.dataFinal },
                dataType: 'json',
                success: function (data) {
                    var $body = $('#tabelaItensMapaBody');
                    $body.empty();
                    $('#msgMapaVazio').hide();

                    if (!data.sucesso) {
                        clickAviso('Erro', data.mensagem, 'critica', null);
                        return;
                    }

                    if (!data.itens || data.itens.length === 0) {
                        $('#msgMapaVazio').show();
                        return;
                    }

                    data.itens.forEach(function (item) {
                        var $tr = $('<tr>').css('cursor', 'pointer')
                            .attr('data-conta-chave', item.contaChave)
                            .attr('data-conta-mascara', item.contaMascara)
                            .attr('data-descricao', item.descricao)
                            .attr('data-ref-exame', item.refExame);
                        $tr.append($('<td>').text(item.contaMascara));
                        $tr.append($('<td>').text(item.refExame));
                        $tr.append($('<td>').text(item.descricao));
                        $tr.append($('<td>').text(item.pendentes).css('text-align', 'center'));
                        $body.append($tr);
                    });
                },
                error: function () {
                    clickAviso('Erro', 'Falha de comunicação ao carregar o Mapa Eletrônico.', 'critica', null);
                }
            });
        }

        function abrirLancamento($tr) {
            contaSelecionada = {
                contaChave: $tr.attr('data-conta-chave'),
                contaMascara: $tr.attr('data-conta-mascara'),
                descricao: $tr.attr('data-descricao'),
                refExame: $tr.attr('data-ref-exame')
            };

            $('#painelItemAnalisado').html(
                'Conta: ' + contaSelecionada.contaMascara +
                ' - ' + contaSelecionada.descricao +
                ' <span style="font-weight:normal; font-size:13px; color:#555;">(Folha: ' + contaSelecionada.refExame + ')</span>');

            $.ajax({
                url: '/MapasTrabalho/ObterResultadosPendentes',
                type: 'POST',
                data: {
                    contaChave: contaSelecionada.contaChave,
                    dataInicial: periodoAtual.dataInicial,
                    dataFinal: periodoAtual.dataFinal
                },
                dataType: 'json',
                success: function (data) {
                    var $body = $('#gridLancamentoBody');
                    $body.empty();

                    if (!data.sucesso) {
                        clickAviso('Erro', data.mensagem, 'critica', null);
                        return;
                    }

                    if (!data.itens || data.itens.length === 0) {
                        clickAviso('Atenção', 'Não há mais itens pendentes para esta conta no período.', 'normal', null);
                        return;
                    }

                    data.itens.forEach(function (item) {
                        var $tr = $('<tr>').attr('data-item-id', item.id).attr('data-coleta', item.coleta);
                        $tr.append($('<td>').text(formatarColeta(item.coleta)).css('white-space', 'nowrap'));
                        $tr.append($('<td>').text(item.nomePaciente));
                        $tr.append($('<td>').append(
                            $('<input type="text">').addClass('input-resultado')
                                .attr('data-original', '')
                                .css({ width: '95%', padding: '4px', border: '1px solid #69c38a', borderRadius: '6px', fontSize: '14px' })
                        ));
                        $tr.append($('<td>').text(item.unidadeMedida || ''));
                        $tr.append($('<td>').text(item.referencia || ''));
                        $body.append($tr);
                    });

                    $('#painelLancamento').show();
                    $('#gridLancamentoBody .input-resultado').first().focus();
                },
                error: function () {
                    clickAviso('Erro', 'Falha de comunicação ao carregar os itens pendentes.', 'critica', null);
                }
            });
        }

        function salvarLinha($tr, aoConcluir) {
            var itemId = $tr.attr('data-item-id');
            var resultado = $tr.find('.input-resultado').val();

            $.ajax({
                url: '/MapasTrabalho/SalvarResultadoMapa',
                type: 'POST',
                data: { itemId: itemId, resultado: resultado },
                dataType: 'json',
                success: function (data) {
                    if (data.sucesso) {
                        $tr.find('.input-resultado').css('border-color', '#28a745');
                        setTimeout(function () { $tr.fadeOut(300, function () { $tr.remove(); }); }, 400);
                    } else {
                        $tr.find('.input-resultado').css('border-color', '#dc3545');
                        clickAviso('Erro', data.mensagem, 'critica', null);
                    }
                    if (aoConcluir) aoConcluir(data);
                },
                error: function () {
                    clickAviso('Erro', 'Falha de comunicação ao salvar o resultado.', 'critica', null);
                    if (aoConcluir) aoConcluir({ sucesso: false });
                }
            });
        }

        $(document).ready(function () {
            $('#filtroDataInicial').val(hojeIso());
            $('#filtroDataFinal').val(hojeIso());

            $('#btnCarregarMapa').on('click', function () {
                $('#painelLancamento').hide();
                carregarMapa();
            });

            // Abre o lançamento ao clicar (ou Enter sobre) uma linha do mapa.
            $('#tabelaItensMapaBody').on('click', 'tr', function () {
                abrirLancamento($(this));
            });

            // Grava com Enter e pula para a próxima linha (padrão do FProducao).
            $('#gridLancamentoBody').on('keydown', '.input-resultado', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var $tr = $(this).closest('tr');
                    salvarLinha($tr, function () {
                        var $proximo = $('#gridLancamentoBody .input-resultado:visible').first();
                        if ($proximo.length) $proximo.focus();
                    });
                }
            });

            // Grava ao sair do campo se o valor mudou.
            $('#gridLancamentoBody').on('blur', '.input-resultado', function () {
                var $tr = $(this).closest('tr');
                var atual = $(this).val();
                if (atual && atual.trim() !== '') {
                    salvarLinha($tr);
                }
            });

            // Busca de coleta: localiza e destaca a linha digitada (padrão do FProducao).
            $('#edtBuscaColeta').on('keydown', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                var texto = $(this).val().replace(/\D/g, '');
                if (!texto) return;

                var $achado = null;
                $('#gridLancamentoBody tr').each(function () {
                    var coleta = ($(this).attr('data-coleta') || '');
                    if (coleta.indexOf(texto) !== -1) {
                        $achado = $(this);
                        return false;
                    }
                });

                $('#gridLancamentoBody tr').css('background-color', '');
                if ($achado) {
                    $achado.css('background-color', '#fff3cd');
                    $achado.find('.input-resultado').focus();
                }
                $(this).val('');
            });

            $('#btnVoltarMapa').on('click', function () {
                $('#painelLancamento').hide();
                carregarMapa();
            });

            $('#btnImprimirListaColetas').on('click', function () {
                if (!contaSelecionada.contaChave) return;

                Swal.fire({
                    title: 'Imprimir Lista de Coletas',
                    text: 'Deseja Imprimir a Lista de Coletas para "' + contaSelecionada.descricao + '" ?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim, imprimir',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    fetch('/MapasTrabalho/ImprimirListaColetas?contaChave=' + encodeURIComponent(contaSelecionada.contaChave) +
                          '&dataInicial=' + encodeURIComponent(periodoAtual.dataInicial) +
                          '&dataFinal=' + encodeURIComponent(periodoAtual.dataFinal))
                        .then(function (response) { return response.json(); })
                        .then(function (data) {
                            if (!data.sucesso) clickAviso(data.titulo || 'Erro', data.mensagem, 'critica', null);
                        })
                        .catch(function () { clickAviso('Erro', 'Falha de comunicação ao imprimir a Lista de Coletas.', 'critica', null); });
                });
            });

            carregarMapa();
        });
    </script>
}

<style>
    /*Feito pelo Qoder em 23/08/2026*/
    #tabelaItensMapaBody tr:hover {
        background-color: #f0f8f0;
    }
    #gridLancamentoBody tr:hover {
        background-color: #f0f8f0;
    }
    @@media (max-width: 768px) {
        #filtrosMapaEletronico .card-secao-body > div {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
@*..Qoder*@
