@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<partial name='Partials/_PartialMenuMapasTrabalho' />

@*Feito pelo Qoder em 23/08/2026 — Mapa Horizontal (portabilidade do FFichaHorizontal.pas):
    geração em FichasInternas (folhas Marcado) e impressão em PDF A4 paisagem. *@

<!-- Data do Mapa e Geração -->
<div id="filtrosMapaHorizontal" class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-calendar-day"></i> Mapa Horizontal — Data da Coleta
    </div>
    <div class="card-secao-body">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
            <label style="font: normal 13px calibri, arial, sans-serif;">Data do Mapa:</label>
            <input type="date" id="filtroData"
                   style="width: 150px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

            <label style="font: normal 13px calibri, arial, sans-serif; margin-left: 12px;">Resultados:</label>
            <select id="filtroResultados" style="width: 190px; height: 32px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;">
                <option value="1" selected>Somente sem resultados</option>
                <option value="0">Todos (com e sem)</option>
            </select>

            <button type="button" id="btnGerarMapa" class="btn btn-success btn-sm" style="display: inline-block;">
                <i class="fa-sharp fa-solid fa-table-cells-large"></i> Gerar Mapa
            </button>
        </div>
    </div>
</div>

<!-- Folhas de Exame (marcação Marcado) -->
<div class="card-secao" style="margin-top:10px;">
    <div class="card-secao-header">
        <i class="fa-solid fa-table-list"></i> Folhas de Exame — marque as que entram no Mapa Horizontal
    </div>
    <div class="card-secao-body">
        <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
            <table class="table table-sm table-bordered" style="font-size:13px;">
                <thead style="background-color:#d4edda;">
                    <tr>
                        <th style="width:10%;">Marcado</th>
                        <th style="width:90%;">Folha de Exame</th>
                    </tr>
                </thead>
                <tbody id="tabelaFolhasBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Impressão -->
<div class="card-secao" style="margin-top:10px; margin-bottom:150px;">
    <div class="card-secao-header">
        <i class="fa-solid fa-print"></i> Impressão do Mapa Horizontal (PDF A4 Paisagem)
    </div>
    <div class="card-secao-body">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
            <label style="font: normal 13px calibri, arial, sans-serif;">Ordem:</label>
            <select id="filtroOrdem" style="width: 210px; height: 32px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;">
                <option value="0" selected>Código do Exame</option>
                <option value="1">Controle de Coleta</option>
                <option value="2">Sequencial Instituição</option>
            </select>

            <label style="font: normal 13px calibri, arial, sans-serif; margin-left: 12px;">Modelo:</label>
            <select id="filtroModelo" style="width: 220px; height: 32px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;">
                <option value="1" selected>1-A Paginado (folha por página)</option>
                <option value="2">1-B Não Paginado</option>
            </select>

            <button type="button" id="btnImprimirMapa" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-print"></i> Imprimir (PDF)
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Feito pelo Qoder em 23/08/2026 — campo de data agora é <input type="date">
        // (valor ISO yyyy-MM-dd); o controller continua recebendo dd/MM/yyyy.
        function hojeIso() {
            var d = new Date();
            return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
        }

        function dataBr(valorIso) {
            if (!valorIso) return '';
            var p = valorIso.split('-');
            return p[2] + '/' + p[1] + '/' + p[0];
        }

        // Feito pelo Qoder em 23/08/2026 — marcação de folhas persistida em
        // ClasseExames.Marcado (papel do dbgFolhas/Marcador do FFichaHorizontal).
        function carregarFolhas() {
            $.ajax({
                url: '/MapasTrabalho/ObterFolhasAgrupadas',
                type: 'POST',
                dataType: 'json',
                success: function (data) {
                    var $body = $('#tabelaFolhasBody');
                    $body.empty();
                    if (!data.sucesso) { clickAviso('Erro', data.mensagem, 'critica', null); return; }

                    data.folhas.forEach(function (folha) {
                        var $check = $('<input type="checkbox">')
                            .addClass('chk-marcado')
                            .attr('data-classe-id', folha.id)
                            .prop('checked', folha.marcado === 1);
                        var $tr = $('<tr>');
                        $tr.append($('<td>').css('text-align', 'center').append($check));
                        $tr.append($('<td>').text(folha.refExame));
                        $body.append($tr);
                    });
                },
                error: function () { clickAviso('Erro', 'Falha de comunicação ao carregar as folhas.', 'critica', null); }
            });
        }

        $(document).ready(function () {
            $('#filtroData').val(hojeIso());
            carregarFolhas();

            $('#tabelaFolhasBody').on('change', '.chk-marcado', function () {
                var $chk = $(this);
                $.ajax({
                    url: '/MapasTrabalho/AlternarMarcado',
                    type: 'POST',
                    data: { classeExamesId: $chk.attr('data-classe-id') },
                    dataType: 'json',
                    success: function (data) {
                        if (!data.sucesso) {
                            $chk.prop('checked', !$chk.prop('checked'));
                            clickAviso('Erro', data.mensagem, 'critica', null);
                        }
                    },
                    error: function () {
                        $chk.prop('checked', !$chk.prop('checked'));
                        clickAviso('Erro', 'Falha de comunicação ao alternar o marcador.', 'critica', null);
                    }
                });
            });

            $('#btnGerarMapa').on('click', function () {
                Swal.fire({
                    title: 'Gerar Mapa Horizontal',
                    text: 'Gerar o Mapa Horizontal para a data informada? (A tabela de fichas é apagada e regenerada)',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim, gerar',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '/MapasTrabalho/GerarMapaHorizontal',
                        type: 'POST',
                        data: {
                            data: dataBr($('#filtroData').val()),
                            somenteSemResultados: $('#filtroResultados').val() === '1'
                        },
                        dataType: 'json',
                        success: function (data) {
                            clickAviso(data.sucesso ? 'Sucesso' : 'Erro', data.mensagem, data.sucesso ? 'sucesso' : 'critica', null);
                        },
                        error: function () { clickAviso('Erro', 'Falha de comunicação ao gerar o mapa.', 'critica', null); }
                    });
                });
            });

            $('#btnImprimirMapa').on('click', function () {
                Swal.fire({
                    title: 'Imprimir Mapa Horizontal',
                    text: 'Confirma a Impressão do Mapa Horizontal?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sim, imprimir',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    window.location.href = '/MapasTrabalho/ImprimirMapaHorizontal?data=' +
                        encodeURIComponent(dataBr($('#filtroData').val())) +
                        '&ordem=' + $('#filtroOrdem').val() +
                        '&modelo=' + $('#filtroModelo').val();
                });
            });
        });
    </script>
}

<style>
    /*Feito pelo Qoder em 23/08/2026*/
    @@media (max-width: 768px) {
        #filtrosMapaHorizontal .card-secao-body > div {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
@*..Qoder*@
