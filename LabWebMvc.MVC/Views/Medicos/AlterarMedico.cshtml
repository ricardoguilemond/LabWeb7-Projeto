@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@model vmMedicos
@{
    Layout = "_Layout";
}
<script>
    $(document).ready(function () {
        initBtnVoltar();
        $('#clickSubmit').click(function (event) {
            event.preventDefault();
            $.ajax({
                //url: '@Url.Action("AlterarMedico", "Medicos")',
                type: "POST",
                async: true,
                dataType: "json",
                data: $('#form').serialize(),
                success: function (data) {
                    //console.log("data: ", data);
                    var titulo = data['titulo'];
                    var mensagem = data['mensagem'];
                    var actionPos = data['action'];
                    var sucesso = data['sucesso'];
                    titulo = (titulo == null) ? 'Atenção' : data['titulo'];
                    var tipo = 'falha';
                    if (sucesso == true) tipo = 'sucesso';
                    //success: Javascript ::: aqui acontece todas as mensagens de sucesso e não sucesso
                    clickAviso(titulo, mensagem, tipo, actionPos);  //mensagem normal com desvio para outra action (site.js)
                },
                error: function (request, status, error) {
                    //aqui somente acontece no caso de exception/erro do javascript
                    clickAviso('Interrompido', 'Falha na execução', 'critica', '');  //mensagem crítica (site.js)
                }
            });
        })
    });
</script>

@using (Html.BeginForm(FormMethod.Post, new { @class = "form-horizontal", @id = "form", @enctype = "multipart/form-data" }))  //@id-"form" é obrigatório para campos chegarem do doutro lado
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <style>
        .cadastro-clean .form-control { font-size: 12px !important; }
        .cadastro-clean select.form-control { font-size: 12px !important; }
    </style>
    <div class="cadastro-clean" style="max-width: 600px; margin: 20px 0; padding: 24px; border: 1px solid #d4edda; border-radius: 8px; background-color: #fff;">
        <h4 style="color: #333; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 1px solid #e0e0e0;">
            <i class="fa-solid fa-user-doctor" style="color: #69c38a;"></i> Alterar Médico
        </h4>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">*Nome do Médico:</label>
                @Html.TextBoxFor(p => p.NomeMedico, new { @class = "form-control capitalize", @placeholder = "Entre com o nome completo do médico", @required = "required", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">*CRM ou outro documento de Conselho:</label>
                @Html.TextBoxFor(p => p.CRM, new { @class = "form-control capitalize", @placeholder = "Entre com o CRM/Registro do médico", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Especialidade:</label>
                @Html.TextBoxFor(p => p.Especialidade, new { @class = "form-control capitalize", @placeholder = "Entre com a especialidade", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Telefone:</label>
                @Html.TextBoxFor(p => p.Telefone, new { @class = "form-control", @placeholder = "Telefone com DDD", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
                @Html.ValidationMessageFor(p => p.Telefone, null, new { @class = "has-error" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">e-mail:</label>
                @Html.TextBoxFor(p => p.Email, new { @class = "form-control lowercase", @style = "color: blue; border: 1px solid #69c38a; border-radius: 6px;", @placeholder = "e-mail", @type = "email" })
            </div>
            <!--
            Submeter Formulário
            -->
            <div class="form-group" style="margin-top: 20px; text-align: center;">
                <button type="button" id="btnVoltar" class="btn btn-lg btn-secondary" style="margin-right: 10px;">
                    <i class="fa-solid fa-arrow-left"></i> Voltar
                </button>
                <button id="clickSubmit" type="submit" class="btn btn-lg btn-success botao-verde" style="border-radius: 6px;">
                    Salvar
                </button>
            </div>
    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
