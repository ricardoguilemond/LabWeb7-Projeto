@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@model vmMedicos
@{
    Layout = "_Layout";
}
<script>
    $(document).ready(function () {
        initBtnVoltar();
        $('#clickSubmit').click(function (event) {
            event.preventDefault();
            $.ajax({
                //url: '@Url.Action("IncluirMedico", "Medicos")',
                type: "POST",
                async: true,
                dataType: "json",
                data: $('#form').serialize(),
                success: function (data) {
                    //console.log("data: ", data);
                    var titulo = data['titulo'];
                    var mensagem = data['mensagem'];
                    var actionPos = data['action'];
                    var sucesso = data['sucesso'];
                    titulo = (titulo == null) ? 'Atenção' : data['titulo'];
                    var tipo = 'falha';
                    if (sucesso == true) tipo = 'sucesso';
                    //success: Javascript ::: aqui acontece todas as mensagens de sucesso e não sucesso
                    clickAviso(titulo, mensagem, tipo, actionPos);  //mensagem normal com desvio para outra action (site.js)
                },
                error: function (request, status, error) {
                    //aqui somente acontece no caso de exception/erro do javascript
                    clickAviso('Interrompido', 'Falha na execução', 'critica', '');  //mensagem crítica (site.js)
                }
            });
            //Limpa todos os campos do formulário!
            $('#form')[0].reset();
        })
    });
</script>
@using (Html.BeginForm(FormMethod.Post, new { @class = "form-horizontal", @id = "form", @enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="lab-form-container lab-refined">

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-user-doctor"></i> Dados do Médico
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-xl">
                        <label>*Nome do Médico</label>
                        @Html.TextBoxFor(p => p.NomeMedico, new { @class = "form-control capitalize", @placeholder = "Entre com o nome completo do médico", @required = "required" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>*CRM/Registro do médico</label>
                        @Html.TextBoxFor(p => p.CRM, new { @class = "form-control capitalize", @placeholder = "Entre com o CRM do médico", @required = "required" })
                    </div>
                    <div class="field-group w-md">
                        <label>*Especialidade</label>
                        @Html.TextBoxFor(p => p.Especialidade, new { @class = "form-control capitalize", @placeholder = "Entre com a especialidade", @required = "required" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-phone"></i> Contato
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>Telefone com DDD</label>
                        @Html.TextBoxFor(p => p.Telefone, new { @class = "form-control", @placeholder = "Telefone com DDD" })
                        @Html.ValidationMessageFor(p => p.Telefone, null, new { @class = "has-error" })
                    </div>
                    <div class="field-group w-lg">
                        <label>E-mail</label>
                        @Html.TextBoxFor(p => p.Email, new { @class = "form-control lowercase", @style = "color: blue;", @placeholder = "e-mail", @type = "email" })
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group" style="margin-top: 16px;">
            <button type="button" id="btnVoltar" class="btn btn-lg btn-secondary lab-btn" style="margin-right: 10px;">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </button>
            <button id="clickSubmit" type="submit" class="btn btn-lg btn-success botao-verde lab-btn">
                Salvar
            </button>
        </div>

    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
