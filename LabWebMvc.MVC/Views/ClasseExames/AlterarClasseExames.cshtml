                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="field-row" id="divFileAss3">
                    <div class="field-group w-full">
                        <label>Terceira Assinatura ::: Máximo 775x226 pixels (Largura_x_altura)</label>
                        @Html.TextBoxFor(p => p.CaminhoImgAss3, new { @type = "file", @id = "fileAss3", @name = "fileAss3", @value = Model.PathImages })
