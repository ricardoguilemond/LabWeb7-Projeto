@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@model vmInstituicao
@{
    Layout = "_Layout";
}
<style>
    img {
        opacity: 0.4;
    }
    .container {
        position: relative;
        text-align: center;
        color: red;
    }
    .textoRotaciona {
        position: absolute;
        top: 20%;
        left: 30%;
        transform: translate(-20%, -30%);
        font-size: 3.2em;
        font-weight: 500;
        display: block;
        -webkit-transform: rotate(-45deg);
        -moz-transform: rotate(-45deg);
    }
</style>
<script>
    $(document).ready(function () {
        initBtnVoltar();
        $(".close").click(function (event) {
            event.preventDefault();
            window.history.back();
        });
    });
</script>
<!-- Trigger/Open The Modal -->
<div id="myModal" class="modal">
    <!-- Modal content -->
    <div class="modal-content">
        <div class="modal-header bg-verde-escuro">
            <h5 class="modal-title">@ViewBag.TextoMenu[0]</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body lab-refined">
            <div class="card-secao card-secao-w-lg">
                <div class="card-secao-header">
                    <i class="fa-solid fa-building"></i> Dados da Instituição
                </div>
                <div class="card-secao-body">
                    <div class="field-row">
                        <div class="field-group w-sm">
                            <label>Sigla</label>
                            <div class="field-readonly">@Model.Sigla</div>
                        </div>
                        <div class="field-group w-xl">
                            <label>Nome Instituição</label>
                            <div class="field-readonly">@Model.Nome</div>
                        </div>
                        <div class="field-group w-md">
                            <label>CNPJ</label>
                            <div class="field-readonly">@Model.CNPJ</div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-group w-md">
                            <label>Telefone</label>
                            <div class="field-readonly">@Model.Telefone</div>
                        </div>
                        <div class="field-group w-lg">
                            <label>e-mail</label>
                            <div class="field-readonly" style="color: blue;">@Model.Email</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-secao card-secao-w-lg">
                <div class="card-secao-header">
                    <i class="fa-solid fa-image"></i> Configurações de Relatórios
                </div>
                <div class="card-secao-body">
                    <div class="field-row">
                        <div class="field-group w-lg">
                            <label>Título nos Relatórios</label>
                            <div class="field-readonly">@Model.TituloTimbre</div>
                        </div>
                        <div class="field-group w-lg">
                            <label>Subtítulo nos Relatórios</label>
                            <div class="field-readonly">@Model.SubTituloTimbre</div>
                        </div>
                    </div>
                    @if (ViewBag.NomeTimbre != null)
                    {
                        <div class="field-row">
                            <div class="field-group w-full">
                                <label>Imagem Timbre 215x235 (esta acompanha Títulos em relatórios)</label>
                                <div class="container">
                                    @Html.Raw("<div id='imgsT'></div>")
                                    @Html.Raw("<div class='textoRotaciona'>NÃO COPIAR</div>")
                                    @Html.HiddenFor(p => p.Timbre, new { @id = "bytesTimbre" })
                                </div>
                                <div class="field-hint">Nome da imagem: @Model.NomeTimbre</div>
                            </div>
                        </div>
                    }
                    @if (ViewBag.NomeLogomarca != null)
                    {
                        <div class="field-row">
                            <div class="field-group w-full">
                                <label>Imagem Logomarca 670x120 (esta sobrepõe Timbre e Títulos em relatórios)</label>
                                <div class="container">
                                    @Html.Raw("<div id='imgsL'></div>")
                                    @Html.Raw("<div class='textoRotaciona'>NÃO COPIAR</div>")
                                    @Html.HiddenFor(p => p.Logomarca, new { @id = "bytesLogomarca" })
                                </div>
                                <div class="field-hint">Nome da imagem: @Model.NomeLogomarca</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="modal-footer" style="justify-content: center;">
            <button type="button" id="btnVoltar" class="btn btn-secondary lab-btn">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </button>
        </div>
    </div>
</div>
<!-- Meu JS (sempre no final) para poder renderizar junto com a página -->
<script src="@Url.Content("~/js/site.js")" type="text/javascript"></script>
<!-- Fim da página do Modal -->
<Script>
    //Carrega a imagem do Timbre que vem da base de dados em bytes[]
    var arrayTimbre = "data:image/png;base64," + $("#bytesTimbre").val();
    if (arrayTimbre != null && arrayTimbre != "data:image/png;base64,")
        $("#imgsT").fadeIn("fast").html("<img src='" + arrayTimbre + "' style='width:235px; height:215px;' onContextMenu = 'return false;' />");

    //Carrega a imagem da Logomarca que vem da base de dados em bytes[]
    var arrayLogomarca = "data:image/png;base64," + $("#bytesLogomarca").val();
    if (arrayLogomarca != null && arrayLogomarca != "data:image/png;base64,")
        $("#imgsL").fadeIn("fast").html("<img src='" + arrayLogomarca + "' style='width:670px; height:120px;' onContextMenu = 'return false;' />");
</Script>
