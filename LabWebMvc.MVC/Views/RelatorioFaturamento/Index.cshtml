@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BLL
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@model vmRelatorioFaturamento

<partial name='Partials/_PartialMenuRelatorioFaturamento' />

<div id="filtrosRelatorioFaturamento" class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-file-invoice-dollar"></i> Relatório de Faturamento por Período
    </div>
    <div class="card-secao-body">
        @if (TempData["MensagemErro"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["MensagemErro"]
            </div>
        }

        <form id="formRelatorioFaturamento" method="post" asp-action="GerarPdf" asp-controller="RelatorioFaturamento">

            @* Linha 1: Datas + botao Carregar Periodo *@
            <div style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="font: normal 13px calibri, arial, sans-serif; display: block;">Data Inicial:</label>
                    <input type="text" asp-for="DataIni" value="@Model.DataIni.ToString("dd/MM/yyyy")" placeholder="dd/MM/yyyy"
                           style="width: 120px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />
                </div>
                <div>
                    <label style="font: normal 13px calibri, arial, sans-serif; display: block;">Data Final:</label>
                    <input type="text" asp-for="DataFim" value="@Model.DataFim.ToString("dd/MM/yyyy")" placeholder="dd/MM/yyyy"
                           style="width: 120px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />
                </div>
                <div>
                    <label style="font: normal 13px calibri, arial, sans-serif; display: block;">&nbsp;</label>
                    <button type="button" id="btnCarregarPeriodo" class="btn btn-outline-success btn-sm">
                        <i class="fa-solid fa-rotate"></i> Carregar Período
                    </button>
                </div>
            </div>

            @* Linha 2: Instituicoes + Tabelas de Precos *@
            <div style="display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12px; margin-bottom: 12px;">
                <div style="min-width: 280px; flex: 1;">
                    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 3px;">
                        <label style="font: normal 13px calibri, arial, sans-serif; margin: 0;">Instituições:</label>
                        <label style="margin: 0; cursor: pointer; font: normal 12px calibri, arial, sans-serif;">
                            <input type="radio" name="selInst" id="rdInstMarcar" style="cursor: pointer;" />
                            Marcar todas
                        </label>
                        <label style="margin: 0; cursor: pointer; font: normal 12px calibri, arial, sans-serif;">
                            <input type="radio" name="selInst" id="rdInstDesmarcar" style="cursor: pointer;" />
                            Desmarcar todas
                        </label>
                    </div>
                    <div id="listaInstituicoes"
                         style="width: 100%; height: 240px; overflow-y: auto; border: 1px solid #69c38a; border-radius: 6px; padding: 6px; background-color: #fff;">
                        @foreach (var item in Model.Instituicoes)
                        {
                            var idInst = $"inst_{item.Value}";
                            var selecionado = int.TryParse(item.Value, out var id) && Model.InstituicoesSelecionadas.Contains(id);
                            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
                                <input type="checkbox" name="InstituicoesSelecionadas" value="@item.Value" id="@idInst" class="chk-instituicao" @(selecionado ? "checked" : "") />
                                <label for="@idInst" style="margin-bottom: 0; font: normal 13px calibri, arial, sans-serif; cursor: pointer;">@item.Text</label>
                            </div>
                        }
                    </div>
                </div>
                <div style="min-width: 280px; flex: 1;">
                    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 3px;">
                        <label style="font: normal 13px calibri, arial, sans-serif; margin: 0;">Tabelas de Preços:</label>
                        <label style="margin: 0; cursor: pointer; font: normal 12px calibri, arial, sans-serif;">
                            <input type="radio" name="selTab" id="rdTabMarcar" style="cursor: pointer;" />
                            Marcar todas
                        </label>
                        <label style="margin: 0; cursor: pointer; font: normal 12px calibri, arial, sans-serif;">
                            <input type="radio" name="selTab" id="rdTabDesmarcar" style="cursor: pointer;" />
                            Desmarcar todas
                        </label>
                    </div>
                    <div id="listaTabelas"
                         style="width: 100%; height: 240px; overflow-y: auto; border: 1px solid #69c38a; border-radius: 6px; padding: 6px; background-color: #fff;">
                        @foreach (var item in Model.Tabelas)
                        {
                            var idTabela = $"tab_{item.Value}";
                            var selecionado = int.TryParse(item.Value, out var id) && Model.TabelasSelecionadas.Contains(id);
                            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
                                <input type="checkbox" name="TabelasSelecionadas" value="@item.Value" id="@idTabela" class="chk-tabela" @(selecionado ? "checked" : "") />
                                <label for="@idTabela" style="margin-bottom: 0; font: normal 13px calibri, arial, sans-serif; cursor: pointer;">@item.Text</label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Linha 3: Ordenacao, Mostragem de Precos, Layout *@
            <div style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="font: normal 13px calibri, arial, sans-serif; display: block;">Ordenação:</label>
                    <select asp-for="Ordenacao"
                            style="width: 280px; padding: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;">
                        <option value="2">Data, Sigla Instituição + Sequencial</option>
                        <option value="1">Sigla Instituição + Sequencial</option>
                        <option value="0">Alfabética (Nome Paciente)</option>
                    </select>
                </div>
                <div>
                    <label style="font: normal 13px calibri, arial, sans-serif; display: block;">Mostragem de Preços:</label>
                    <select asp-for="MostragemPrecos"
                            style="width: 340px; padding: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;">
                        <option value="2">Não imprimir itens com valores zerados</option>
                        <option value="0">Aceitar zerados nos Exames dos Pacientes</option>
                        <option value="1">Aceitar todos os zerados baseado no Plano de Exames</option>
                    </select>
                </div>
                <div>
                    <label style="font: normal 13px calibri, arial, sans-serif; display: block;">Layout:</label>
                    <select asp-for="DuasColunas"
                            style="width: 160px; padding: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;">
                        <option value="true">Duas colunas</option>
                        <option value="false">Uma coluna</option>
                    </select>
                </div>
            </div>

            @* Linha 4: Incluir Baixados, Formato de Saida, Botao *@
            <div style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <input type="checkbox" asp-for="IncluirBaixados" id="chkIncluirBaixados" />
                    <label for="chkIncluirBaixados" style="font: normal 13px calibri, arial, sans-serif; margin-bottom: 0;">Incluir Baixados (Arquivados)</label>
                </div>
                <div>
                    <label style="font: normal 13px calibri, arial, sans-serif; display: block;">Formato de Saída:</label>
                    <select asp-for="FormatoSaida" id="selFormatoSaida"
                            style="width: 160px; padding: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;">
                        <option value="0">PDF</option>
                        <option value="1">HTML</option>
                        <option value="2">Word (.docx)</option>
                    </select>
                </div>
                <button type="submit" id="btnGerar" class="btn btn-success btn-sm">
                    <i id="icoGerar" class="fa-sharp fa-solid fa-file-pdf"></i> <span id="txtGerar">Gerar PDF</span>
                </button>
                <button type="button" id="btnDiagnostico" class="btn btn-outline-warning btn-sm" title="Diagnóstico temporário: investigar tabelas carregadas">
                    <i class="fa-solid fa-bug"></i> Diagnóstico
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#DataIni, #DataFim").inputmask("99/99/9999");

            // Atualiza ícone e texto do botão conforme o formato selecionado
            var formatoConfig = {
                "0": { ico: "fa-file-pdf",  txt: "Gerar PDF"  },
                "1": { ico: "fa-file-code", txt: "Gerar HTML" },
                "2": { ico: "fa-file-word", txt: "Gerar Word" }
            };

            function atualizarBotao() {
                var val = $("#selFormatoSaida").val();
                var cfg = formatoConfig[val] || formatoConfig["0"];
                $("#icoGerar").attr("class", "fa-sharp fa-solid " + cfg.ico);
                $("#txtGerar").text(cfg.txt);
            }

            // Habilita/desabilita o botao conforme tabela selecionada
            function atualizarEstadoBotao() {
                var temTabela = $("#listaTabelas .chk-tabela:checked").length > 0;
                $("#btnGerar").prop("disabled", !temTabela)
                             .toggleClass("btn-secondary", !temTabela)
                             .toggleClass("btn-success",   temTabela);
            }

            $("#selFormatoSaida").on("change", atualizarBotao);
            atualizarBotao();
            atualizarEstadoBotao();  // estado inicial: desabilitado

            // Botao Carregar Periodo → recarrega Instituicoes
            $("#btnCarregarPeriodo").on("click", function () {
                carregarInstituicoes();
            });

            // IncluirBaixados → tambem recarrega Instituicoes (sem precisar do botao)
            $("#chkIncluirBaixados").on("change", function () {
                carregarInstituicoes();
            });

            // Instituicoes selecionadas → recarrega apenas Tabelas
            $("#listaInstituicoes").on("change", ".chk-instituicao", function () {
                carregarTabelas();
            });

            // Tabela marcada/desmarcada → reavalia botao
            $("#listaTabelas").on("change", ".chk-tabela", function () {
                atualizarEstadoBotao();
            });

            // Radio Marcar/Desmarcar todas - Instituicoes
            $("#rdInstMarcar").on("change", function () {
                $("#listaInstituicoes .chk-instituicao").prop("checked", true).trigger("change");
                carregarTabelas();
                $(this).prop("checked", false);  // reset do radio apos acao
            });
            $("#rdInstDesmarcar").on("change", function () {
                $("#listaInstituicoes .chk-instituicao").prop("checked", false);
                $("#listaTabelas").empty().append('<span style="font: normal 12px calibri, arial, sans-serif; color: #888;">Selecione instituições para carregar tabelas.</span>');
                atualizarEstadoBotao();
                $(this).prop("checked", false);  // reset do radio apos acao
            });

            // Radio Marcar/Desmarcar todas - Tabelas
            $("#rdTabMarcar").on("change", function () {
                $("#listaTabelas .chk-tabela").prop("checked", true);
                atualizarEstadoBotao();
                $(this).prop("checked", false);  // reset do radio apos acao
            });
            $("#rdTabDesmarcar").on("change", function () {
                $("#listaTabelas .chk-tabela").prop("checked", false);
                atualizarEstadoBotao();
                $(this).prop("checked", false);  // reset do radio apos acao
            });

            // Carga inicial: busca as instituicoes do periodo padrao
            carregarInstituicoes();

            $("#formRelatorioFaturamento").on("submit", function (e) {
                e.preventDefault();

                var $form = $(this);
                var $btn = $form.find('button[type="submit"]');
                var textoOriginal = $btn.html();
                $btn.prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin"></i> Gerando...');

                fetch($form.attr("action"), {
                    method: "POST",
                    body: new FormData(this)
                })
                .then(function (response) {
                    if (!response.ok) {
                        return response.text().then(function () {
                            throw new Error("Erro ao gerar relatório. Verifique os filtros e tente novamente.");
                        });
                    }
                    return response.blob();
                })
                .then(function (blob) {
                    var url = window.URL.createObjectURL(blob);
                    window.open(url, "_blank");
                    window.URL.revokeObjectURL(url);
                })
                .catch(function (error) {
                    console.error(error);
                    clickAviso("Atenção", error.message, "aviso", null);
                })
                .finally(function () {
                    $btn.prop("disabled", false).html(textoOriginal);
                });
            });

            function carregarInstituicoes() {
                var dataIni = $("#DataIni").val();
                var dataFim = $("#DataFim").val();
                var incluirBaixados = $("#chkIncluirBaixados").is(":checked");

                // Datas incompletas: aguarda preenchimento total
                if (!dataIni || dataIni.indexOf("_") !== -1 || !dataFim || dataFim.indexOf("_") !== -1) return;

                $.ajax({
                    url: '@Url.Action("CarregarInstituicoes", "RelatorioFaturamento")',
                    type: 'POST',
                    data: { dataIni: dataIni, dataFim: dataFim, incluirBaixados: incluirBaixados },
                    success: function (result) {
                        var $container = $("#listaInstituicoes");
                        $container.empty();

                        if (result.length === 0) {
                            $container.append('<span style="font: normal 12px calibri, arial, sans-serif; color: #888;">Nenhuma instituição encontrada para o período.</span>');
                            $("#listaTabelas").empty().append('<span style="font: normal 12px calibri, arial, sans-serif; color: #888;">Selecione instituições para carregar tabelas.</span>');
                            atualizarEstadoBotao();
                            return;
                        }

                        $.each(result, function (i, item) {
                            var id = 'inst_' + item.value;
                            var html =
                                '<div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">' +
                                '<input type="checkbox" name="InstituicoesSelecionadas" value="' + item.value + '" id="' + id + '" class="chk-instituicao" />' +
                                '<label for="' + id + '" style="margin-bottom: 0; font: normal 13px calibri, arial, sans-serif; cursor: pointer;">' + item.text + '</label>' +
                                '</div>';
                            $container.append(html);
                        });

                        // Limpa tabelas pois as instituições mudaram
                        $("#listaTabelas").empty().append('<span style="font: normal 12px calibri, arial, sans-serif; color: #888;">Selecione instituições para carregar tabelas.</span>');
                        atualizarEstadoBotao();  // tabelas limpas = botao desabilitado
                    },
                    error: function () {
                        console.log("Erro ao carregar instituições.");
                    }
                });
            }

            function carregarTabelas() {
                var dataIni = $("#DataIni").val();
                var dataFim = $("#DataFim").val();
                var instituicoes = $(".chk-instituicao:checked").map(function () {
                    return $(this).val();
                }).get();
                var incluirBaixados = $("#chkIncluirBaixados").is(":checked");

                $.ajax({
                    url: '@Url.Action("CarregarTabelas", "RelatorioFaturamento")',
                    type: 'POST',
                    data: {
                        dataIni: dataIni,
                        dataFim: dataFim,
                        instituicoes: instituicoes,
                        incluirBaixados: incluirBaixados
                    },
                    traditional: true,
                    success: function (result) {
                        var $container = $("#listaTabelas");
                        $container.empty();

                        if (result.length === 0) {
                            $container.append('<span style="font: normal 12px calibri, arial, sans-serif; color: #888;">Nenhuma tabela encontrada para as instituições selecionadas.</span>');
                            atualizarEstadoBotao();
                            return;
                        }

                        $.each(result, function (i, item) {
                            var id = 'tab_' + item.value;
                            var html =
                                '<div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">' +
                                '<input type="checkbox" name="TabelasSelecionadas" value="' + item.value + '" id="' + id + '" class="chk-tabela" />' +
                                '<label for="' + id + '" style="margin-bottom: 0; font: normal 13px calibri, arial, sans-serif; cursor: pointer;">' + item.text + '</label>' +
                                '</div>';
                            $container.append(html);
                        });
                        atualizarEstadoBotao();  // reavalia apos reconstruir a lista
                    },
                    error: function () {
                        console.log("Erro ao carregar tabelas.");
                    }
                });
            }
            // Diagnostico temporario: abre JSON em nova aba com os exames que geraram as tabelas
            $("#btnDiagnostico").on("click", function () {
                var dataIni = $("#DataIni").val();
                var dataFim = $("#DataFim").val();
                var instituicoes = $(".chk-instituicao:checked").map(function () {
                    return $(this).val();
                }).get();
                var incluirBaixados = $("#chkIncluirBaixados").is(":checked");

                var url = '@Url.Action("DiagnosticoTabelas", "RelatorioFaturamento")';
                var $form = $("<form>", {
                    action: url,
                    method: "POST",
                    target: "_blank"
                });

                $form.append($("<input>", { type: "hidden", name: "dataIni", value: dataIni }));
                $form.append($("<input>", { type: "hidden", name: "dataFim", value: dataFim }));
                $.each(instituicoes, function (i, v) {
                    $form.append($("<input>", { type: "hidden", name: "instituicoes", value: v }));
                });
                $form.append($("<input>", { type: "hidden", name: "incluirBaixados", value: incluirBaixados }));

                $("body").append($form);
                $form.submit();
                $form.remove();
            });
        });
    </script>
}
