        @* Feito pelo Qoder em 23/08/2026 — bloco de encerramento do antigo overlay (window.onload + fallback)
           removido: não há mais overlay de página. esconderLoading() agora fecha o loader modal Swal. *@
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                //-----------------------------------------------------------------------------------------------
                //Para saltar de campo em campo (somente input do type=text/TextBoxFor) nos formulários com ENTER
                //-----------------------------------------------------------------------------------------------
                document.body.addEventListener('keydown', function (e) {
        
                    //IGNORA campos de busca de DataTables (permite ENTER funcionar normalmente neles)
                    const tableCompacta = document.getElementById('modeloTableCompacta');
                    const searchInput = document.querySelector("input[type='search']");
                    if (tableCompacta && searchInput && tableCompacta.contains(searchInput)) {
                        console.log("Ignorando campo de busca do DataTable no _Layout");
                        return; // Não interfere
                    }
        
                    if (e.which === 13 || e.key === 'Enter') {
                        const input = e.target;
                        if (!input.matches('input, select')) return;
                        const form = input.closest('form');
                        if (!form) return;
        
                        const focusable = Array.from(form.querySelectorAll(
                            'input[type=text], input[type=date], input[type=email], input[type=number], select'
                        )).filter(el => el.offsetParent !== null); // somente visíveis
        
                        const idx = focusable.indexOf(input);
                        const next = focusable[idx + 1];
                        if (next) next.focus();
        
                        return false; // bloqueia envio automático do form
                    }
                });
                //...
            });
            // coloca seta estilizada em todos os botões de submit dos formulários que usam "button"
            document.addEventListener("DOMContentLoaded", function () {
                document.querySelectorAll('button[type="submit"]').forEach(button => {
                    if (!button.querySelector('.seta-gravacao')) {
                        const seta = document.createElement('span');
                        seta.classList.add('seta-gravacao');
                        button.appendChild(seta);
                    }
                });
            });
            //..
            //Feito pelo Kiro em 02/05/2026
            // F5 e CTRL+F5 devem apenas recarregar a página (comportamento padrão do browser).
            // Não devem acionar salvamento de dados em nenhuma tela do sistema.
            // O listener anterior que acionava o botão .botao-verde foi removido.
            //..Kiro

            // Atualiza o contador de ReCaptcha no rodapé periodicamente
            (function atualizarReCaptcha() {
                const el = document.getElementById("resumo-recaptcha");
                if (!el) return;

                fetch("/ReCaptchaTracker/Total")
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.sucesso && data.total) {
                            el.textContent = "ReCaptcha: " + data.total;
                        }
                    })
                    .catch(() => { /* silencioso */ });

                setTimeout(atualizarReCaptcha, 30000); // a cada 30 segundos
            })();
        </script>
        @RenderSection("Scripts", required: false)
    </div>
</body>
