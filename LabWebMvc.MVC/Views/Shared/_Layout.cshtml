    @*Feito pelo Qoder em 23/08/2026 — Fase 0.5 do plano: envio automático do token antiforgery
        em TODAS as requisições que alteram dados (POST/PUT/DELETE/PATCH), cobrindo $.ajax/$.post
        (e plugins que usam $.ajax internamente, como DataTables) e fetch. GET/HEAD ficam isentos.*@
    <script>
        (function () {
            var tokenMeta = document.querySelector('meta[name="RequestVerificationToken"]');
            var token = tokenMeta ? tokenMeta.getAttribute('content') : '';
            if (!token) return;

            // jQuery: cobre $.ajax, $.post e qualquer plugin que use $.ajax internamente
            if (window.jQuery) {
                jQuery.ajaxSetup({
                    beforeSend: function (xhr, settings) {
                        if (!/^(GET|HEAD)$/i.test(settings.type || 'GET')) {
                            xhr.setRequestHeader('RequestVerificationToken', token);
                        }
                    }
                });
            }

            // fetch: cobre chamadas fetch com métodos que alteram dados
            var originalFetch = window.fetch;
            if (originalFetch) {
                window.fetch = function (input, init) {
                    init = init || {};
                    var method = String(init.method || (input && input.method) || 'GET').toUpperCase();
                    if (method !== 'GET' && method !== 'HEAD') {
                        if (init.headers instanceof Headers) {
                            if (!init.headers.has('RequestVerificationToken')) {
                                init.headers.set('RequestVerificationToken', token);
                            }
                        } else {
                            init.headers = Object.assign({ 'RequestVerificationToken': token }, init.headers || {});
                        }
                    }
                    return originalFetch.call(window, input, init);
                };
            }
        })();
    </script>
