                @* Feito pelo Qoder em 23/08/2026 — loading de página inteira removido; o feedback de
                   carregamento de dados é o indicador do próprio DataTables ("Carregando..."). *@
                <script type="text/javascript">
                    const card = document.createElement("div");
                    //..
                    function func_Dashboard() {
                        const div = document.getElementById("divEscondeMostra");
                        if (!div) return;

                        const computedDisplay = window.getComputedStyle(div).display;
                        const isHidden = (computedDisplay === "none");

                        if (isHidden) {
                            // Mostrar com transição suave
                            div.style.setProperty("display", "block", "important");
                            div.style.opacity = "0";

                            // Força o reflow para que a transição funcione
                            void div.offsetWidth;

                            div.style.transition = "opacity 0.5s ease-in";
                            div.style.opacity = "1";

                            localStorage.setItem("dashboardVisible", "true");
                        } else {
                            // Esconde imediatamente
                            div.style.setProperty("display", "none", "important");
                            div.style.transition = "none";
                            localStorage.setItem("dashboardVisible", "false");
                        }
                    }
                    //..
                    //Feito pelo Qoder em 23/08/2026 — LOADING PADRÃO ÚNICO DO SISTEMA (regra imutável até segunda ordem):
                    // 1) Cargas de dados em grids: indicador do próprio DataTables ("Carregando...");
                    // 2) Operações longas: este loader modal (SweetAlert2), via ShowProgress()/esconderLoading();
                    // 3) EXTINTO o antigo overlay de página inteira (modalLoading + gif carregando-black-palitos),
                    //    que não cobria os ajax das tabelas (daí os 2 loadings simultâneos) e já causou bugs de remoção.
                    var _swalLoadingAtivo = false;
                    function ShowProgress() {
                        _swalLoadingAtivo = true;
                        Swal.fire({
                            title: 'Carregando...',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            didOpen: function () { Swal.showLoading(); }
                        });
                    };
                    function esconderLoading() {
                        if (_swalLoadingAtivo) {
                            _swalLoadingAtivo = false;
                            Swal.close();
                        }
                    };
                    //..Qoder
                </script>
