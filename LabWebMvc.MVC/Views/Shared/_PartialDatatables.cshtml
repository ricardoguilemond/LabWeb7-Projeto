<!--
  JS DATATABLE ::: apoiado em \js\mydatatables.js
-->
<script>
    /* Total de linhas de registros da tabela inteira trazida para a view */
    var totalTabela = document.querySelectorAll('#modeloTable .grid_fundo_opcoes').length;
    /*
    Inicio do Grid
    */
    document.addEventListener('DOMContentLoaded', function () {
        const tableEl = document.querySelector('[name="datatable"]');
        const idTable = tableEl ? tableEl.id : null;
        if (idTable === "modeloTableCompacta") {
            configTableCompacta();   //constrói o DataTable com parâmetros de uma tabela compacta/simples/reduzida
        }
        else {
            configTable();   //constrói o DataTable com parâmetros
        }
    });
</script>
