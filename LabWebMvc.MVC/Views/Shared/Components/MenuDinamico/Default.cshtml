@Html.Raw("<div class='sb-nav-link-icon'><i class='fas fa-info-circle'></i></div>")
Sobre
@Html.Raw("<div class='sb-sidenav-collapse-arrow'><i class='fas fa-angle-down'></i></div>")
@Html.Raw("</a>")
@Html.Raw($"<div class='collapse' id='{menuIdSobre}' aria-labelledby='headingOne' data-bs-parent='#sidenavAccordion'>")
@Html.Raw("<nav class='sb-sidenav-menu-nested nav'>")
<a class="nav-link" href="@Url.Action("NossoSistema", "Home")">Nosso Sistema</a>
<a class="nav-link" href="@Url.Action("Privacy", "Home")">Privacidade</a>
<a class="nav-link" href="@Url.Action("Release", "Release")">Versão do Ambiente</a>
@Html.Raw("</nav>")
@Html.Raw("</div>")

@* Grupo Login/Logout *@
