@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using LabWebMvc.MVC.ViewModel
@model vmManutencaoFaturamento

<partial name='Partials/_PartialMenuManutencaoFaturamento' />

<div class="manut-faturamento-compacta">

<div class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-magnifying-glass"></i> Busca de Exame
    </div>
    <div class="card-secao-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="selInstituicao" class="form-label">Instituição</label>
                <select id="selInstituicao" class="form-select form-select-sm">
                    <option value="">-- Selecione --</option>
                    @foreach (var inst in Model.Instituicoes)
                    {
                        <option value="@inst.Value">@inst.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="txtSequencial" class="form-label">Sequencial</label>
                <input type="text" id="txtSequencial" class="form-control form-control-sm" placeholder="Nº Sequencial" />
            </div>
            <div class="col-md-2">
                <label for="txtCodigoExame" class="form-label">Código Exame</label>
                <input type="number" id="txtCodigoExame" class="form-control form-control-sm" placeholder="Cód. Exame" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm" id="btnCarregar" onclick="buscarExame()">
                    <i class="fa-solid fa-search"></i> Carregar
                </button>
                <a href="/RelatorioFaturamento" class="btn btn-secondary btn-sm" target="_blank">
                    <i class="fa-solid fa-print"></i> Imprimir
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .manut-faturamento-compacta .card-secao-body {
        padding: 0.65rem 1rem;
    }
    .manut-faturamento-compacta .card-secao {
        margin-bottom: 0.5rem;
    }
    .manut-faturamento-compacta .form-label {
        margin-bottom: 0.1rem;
        font-size: 0.8rem;
    }
    .manut-faturamento-compacta .row + .row {
        margin-top: 0.4rem;
    }
    .manut-faturamento-compacta #cardItens .card-secao-body {
        min-height: 45vh;
    }
    .manut-faturamento-compacta #lblFaturadoStatus {
        white-space: nowrap;
    }
    .manut-faturamento-compacta .card-secao-header .form-check {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }
    .manut-faturamento-compacta .card-secao-header .form-check-input {
        margin-top: 0;
    }
    .manut-faturamento-compacta .card-secao-header .form-check-label {
        margin-bottom: 0;
        line-height: 1;
    }
    .manut-faturamento-compacta #cardItens .card-secao-header .form-check-label {
        font-size: 0.85rem;
    }
</style>

<div class="card-secao" id="cardExame" style="display:none;">
    <div class="card-secao-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-file-medical"></i> Dados do Exame</span>
        <div class="d-flex align-items-center flex-shrink-0">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="chkFaturado" disabled />
                <label class="form-check-label fw-bold" for="chkFaturado">Faturado</label>
            </div>
            <small class="ms-2" id="lblFaturadoStatus"></small>
        </div>
    </div>
    <div class="card-secao-body">
        <div class="row g-2">
            <div class="col-md-2">
                <label class="form-label">Código Exame</label>
                <input type="text" id="txtCodigoExameResultado" class="form-control form-control-sm" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">Paciente</label>
                <input type="text" id="txtNomeCliente" class="form-control form-control-sm" readonly />
            </div>
            <div class="col-md-2">
                <label class="form-label">CPF</label>
                <input type="text" id="txtCPF" class="form-control form-control-sm" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Nascimento / Idade</label>
                <input type="text" id="txtNascimentoIdade" class="form-control form-control-sm" readonly />
            </div>
        </div>
        <div class="row g-2">
            <div class="col-md-2">
                <label class="form-label">Instituição</label>
                <input type="text" id="txtInstituicao" class="form-control form-control-sm" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tabela</label>
                <input type="text" id="txtTabela" class="form-control form-control-sm" readonly />
            </div>
            <div class="col-md-1">
                <label class="form-label">Sequencial</label>
                <input type="text" id="txtSequencialResult" class="form-control form-control-sm" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Médico</label>
                <input type="text" id="txtMedico" class="form-control form-control-sm" readonly />
            </div>
            <div class="col-md-2">
                <label class="form-label">Data Exame</label>
                <input type="text" id="txtDataExame" class="form-control form-control-sm" readonly />
            </div>
        </div>
    </div>
</div>

<div class="card-secao" id="cardItens" style="display:none;">
    <div class="card-secao-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-list"></i> Itens do Exame</span>
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="chkExibirComValores" />
            <label class="form-check-label" for="chkExibirComValores">Exibir apenas itens com valores</label>
        </div>
    </div>
    <div class="card-secao-body">
        <style>
            #tblItens tbody tr.linha-folha     { background-color: #d4edda !important; }
            #tblItens tbody tr.linha-principal { background-color: #cce5ff !important; }
            #tblItens tbody tr.linha-item-par  { background-color: #f2f2f2; }
            #tblItens tbody tr.linha-item-impar { background-color: #ffffff; }
            #tblItens tbody td:nth-child(3),
            #tblItens tbody td:nth-child(4) {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            #tblItens tbody td.desc-longa {
                white-space: normal;
                max-width: 500px;
            }
        </style>
        <div class="table-responsive">
            <table id="tblItens" class="display compact stripe table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th style="width:90px;">Tipo Conta</th>
                        <th style="width:130px;">Conta Exame</th>
                        <th style="width:80px;">Ref.Item</th>
                        <th>Descrição</th>
                        <th style="width:120px;">Valor Item</th>
                    </tr>
                </thead>
                <tbody id="tbodyItens">
                </tbody>
            </table>
        </div>
    </div>
</div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var _codigoExameAtual = 0;
        var _faturadoAtual = false;
        var _emCatalogoAtual = false;
        var _itensOriginais = [];

        // Exclusividade dos campos de busca: Sequencial e Código Exame são mutuamente exclusivos
        document.getElementById('txtSequencial').addEventListener('input', function () {
            if (this.value.length > 0) {
                document.getElementById('txtCodigoExame').value = '';
                document.getElementById('txtCodigoExame').disabled = true;
            } else {
                document.getElementById('txtCodigoExame').disabled = false;
            }
        });

        document.getElementById('txtCodigoExame').addEventListener('input', function () {
            if (this.value.length > 0) {
                document.getElementById('txtSequencial').value = '';
                document.getElementById('txtSequencial').disabled = true;
            } else {
                document.getElementById('txtSequencial').disabled = false;
            }
        });

        function buscarExame() {
            var instituicao = document.getElementById('selInstituicao').value;
            var sequencial = document.getElementById('txtSequencial').value.trim();
            var codigoExame = document.getElementById('txtCodigoExame').value.trim();

            if ((!instituicao || !sequencial) && !codigoExame) {
                alert('Informe Instituição + Sequencial ou Código do Exame.');
                return;
            }

            var params = new URLSearchParams();
            if (instituicao) params.append('instituicao', instituicao);
            if (sequencial) params.append('sequencial', sequencial);
            if (codigoExame) params.append('codigoExame', codigoExame);

            fetch('/ManutencaoFaturamento/BuscarExame?' + params.toString())
                .then(r => r.json())
                .then(data => {
                    if (!data.sucesso) {
                        alert(data.mensagem);
                        document.getElementById('cardExame').style.display = 'none';
                        document.getElementById('cardItens').style.display = 'none';
                        return;
                    }
                    preencherExame(data.exame, data.itens);
                })
                .catch(err => {
                    alert('Erro ao buscar exame: ' + err);
                });
        }

        function preencherExame(exame, itens) {
            _codigoExameAtual = exame.codigoExameResultado;
            _faturadoAtual = exame.faturado;
            _emCatalogoAtual = exame.emCatalogoRecebimentos;

            document.getElementById('cardExame').style.display = '';
            document.getElementById('cardItens').style.display = '';

            document.getElementById('txtCodigoExameResultado').value = exame.codigoExameResultado;
            document.getElementById('txtNomeCliente').value = exame.nomeCliente + (exame.codigoCliente ? ' (' + exame.codigoCliente + ')' : '');
            document.getElementById('txtCPF').value = exame.cpf;
            document.getElementById('txtNascimentoIdade').value = exame.nascimentoIdade;
            document.getElementById('txtInstituicao').value =
                (exame.instituicaoId ? exame.instituicaoId + ' - ' : '') +
                exame.instituicaoSigla +
                (exame.instituicaoNome ? ' - ' + exame.instituicaoNome : '');
            document.getElementById('txtTabela').value = exame.siglaTabela + (exame.tabelaNome ? ' - ' + exame.tabelaNome : '');
            document.getElementById('txtSequencialResult').value = exame.sequencialFormatado;
            document.getElementById('txtMedico').value = (exame.crm + ' ' + exame.medicoNome).trim();
            document.getElementById('txtDataExame').value = exame.dataExame;

            // Checkbox Faturado
            var chk = document.getElementById('chkFaturado');
            chk.disabled = false;
            chk.checked = exame.faturado;
            atualizarStatusFaturado(exame.faturado);

            // Preencher tabela de itens
            aplicarFiltroItens(itens);
        }

        function atualizarStatusFaturado(faturado) {
            var lbl = document.getElementById('lblFaturadoStatus');
            if (_emCatalogoAtual) {
                lbl.textContent = '(Em Catálogo de Recebimentos — valores bloqueados)';
                lbl.className = 'text-muted ms-2 text-warning fw-bold';
            } else if (faturado) {
                lbl.textContent = '(Exame faturado — valores bloqueados)';
                lbl.className = 'text-muted ms-2 text-danger';
            } else {
                lbl.textContent = '(Valores editáveis)';
                lbl.className = 'text-muted ms-2 text-success';
            }
        }

        function formatarContaExame(conta) {
            if (!conta || conta.length !== 11) return conta || '';
            // Oculta o prefixo TT (tipo) e exibe FF.CCC.NNNN
            return conta.substring(2, 4) + '.' +
                   conta.substring(4, 7) + '.' +
                   conta.substring(7, 11);
        }

        function aplicarFiltroItens(itens) {
            if (itens) {
                _itensOriginais = itens;
            }
            var apenasComValores = document.getElementById('chkExibirComValores').checked;
            var itensRender = apenasComValores
                ? _itensOriginais.filter(function (i) {
                    var valorStr = (i.valorItem || '0').replace(/\./g, '').replace(',', '.');
                    var valor = parseFloat(valorStr) || 0;
                    return valor > 0;
                  })
                : _itensOriginais;
            preencherItens(itensRender);
        }

        function preencherItens(itens) {
            var tbody = document.getElementById('tbodyItens');
            tbody.innerHTML = '';

            var indiceItem = 0;
            itens.forEach(function (item) {
                var tr = document.createElement('tr');
                tr.setAttribute('data-item-id', item.id);

                if (item.ehFolha) {
                    tr.classList.add('linha-folha');
                } else if (item.ehPrincipal) {
                    tr.classList.add('linha-principal');
                } else {
                    tr.classList.add(indiceItem % 2 === 0 ? 'linha-item-par' : 'linha-item-impar');
                    indiceItem++;
                }

                var tipoConta = item.ehFolha ? 'Folha' : (item.ehPrincipal ? 'Principal' : 'Item');

                var tdTipo = document.createElement('td');
                tdTipo.textContent = tipoConta;
                tdTipo.className = 'text-center';

                var tdConta = document.createElement('td');
                tdConta.textContent = formatarContaExame(item.contaExame);
                tdConta.className = 'text-center';

                var tdRef = document.createElement('td');
                tdRef.textContent = item.refItem;

                var tdDesc = document.createElement('td');
                tdDesc.textContent = item.descricao;
                if (item.descricao && item.descricao.length > 120) {
                    tdDesc.classList.add('desc-longa');
                }

                var tdValor = document.createElement('td');
                tdValor.className = 'text-end';
                if (_faturadoAtual || _emCatalogoAtual) {
                    tdValor.textContent = item.valorItem;
                } else {
                    tdValor.innerHTML = '<span class="valor-display" style="cursor:pointer;" onclick="iniciarEdicao(this, ' + item.id + ', \'' + item.valorItem.replace(',', '.') + '\')" title="Clique para editar">' + item.valorItem + '</span>';
                }

                tr.appendChild(tdTipo);
                tr.appendChild(tdConta);
                tr.appendChild(tdRef);
                tr.appendChild(tdDesc);
                tr.appendChild(tdValor);
                tbody.appendChild(tr);
            });
        }

        // Edição inline do ValorItem
        function iniciarEdicao(span, itemId, valorAtual) {
            if (_faturadoAtual || _emCatalogoAtual) return;

            var input = document.createElement('input');
            input.type = 'number';
            input.step = '0.01';
            input.className = 'form-control form-control-sm text-end';
            input.style.width = '110px';
            input.value = parseFloat(valorAtual.replace('.', '').replace(',', '.')) || 0;

            span.replaceWith(input);
            input.focus();
            input.select();

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var novoValor = parseFloat(input.value) || 0;
                    salvarValorItem(itemId, novoValor, input);
                } else if (e.key === 'Escape') {
                    cancelarEdicao(input, itemId, valorAtual);
                }
            });

            input.addEventListener('blur', function () {
                // Pequeno delay para não conflitar com Enter
                setTimeout(function () {
                    if (document.contains(input)) {
                        cancelarEdicao(input, itemId, valorAtual);
                    }
                }, 200);
            });
        }

        function salvarValorItem(itemId, valor, input) {
            var formData = new FormData();
            formData.append('codigo', itemId);
            formData.append('valorItem', valor);

            fetch('/ManutencaoFaturamento/EditarValorItem', {
                method: 'POST',
                body: formData
            })
                .then(r => r.json())
                .then(data => {
                    if (data.sucesso) {
                        var span = document.createElement('span');
                        span.className = 'valor-display';
                        span.style.cursor = 'pointer';
                        span.title = 'Clique para editar';
                        span.textContent = valor.toFixed(2).replace('.', ',');
                        span.onclick = function () { iniciarEdicao(this, itemId, valor.toFixed(2)); };
                        input.replaceWith(span);
                    } else {
                        alert(data.mensagem);
                        cancelarEdicao(input, itemId, '0');
                    }
                })
                .catch(err => {
                    alert('Erro ao salvar: ' + err);
                });
        }

        function cancelarEdicao(input, itemId, valorAnterior) {
            var span = document.createElement('span');
            span.className = 'valor-display';
            span.style.cursor = 'pointer';
            span.title = 'Clique para editar';
            span.textContent = valorAnterior;
            span.onclick = function () { iniciarEdicao(this, itemId, valorAnterior); };
            input.replaceWith(span);
        }

        // Checkbox Faturado — ao desmarcar, confirma e salva
        document.getElementById('chkFaturado').addEventListener('change', function () {
            var novoEstado = this.checked;

            // Se está desmarcando (desbloqueando), pedir confirmação
            if (!novoEstado && _faturadoAtual) {
                if (!confirm('ATENÇÃO: Você está desbloqueando um exame faturado.\nEsta ação será registrada em log de auditoria.\n\nDeseja continuar?')) {
                    this.checked = true; // reverter
                    return;
                }
            }

            var formData = new FormData();
            formData.append('codigoExame', _codigoExameAtual);
            formData.append('faturado', novoEstado);

            fetch('/ManutencaoFaturamento/AlterarFlagFaturado', {
                method: 'POST',
                body: formData
            })
                .then(r => r.json())
                .then(data => {
                    if (data.sucesso) {
                        _faturadoAtual = data.faturado;
                        atualizarStatusFaturado(data.faturado);
                        // Recarregar itens para aplicar/remover bloqueio
                        recarregarItens();
                    } else {
                        alert(data.mensagem);
                        this.checked = _faturadoAtual; // reverter
                    }
                })
                .catch(err => {
                    alert('Erro ao alterar flag: ' + err);
                    this.checked = _faturadoAtual; // reverter
                });
        });

        function recarregarItens() {
            if (!_codigoExameAtual) return;

            fetch('/ManutencaoFaturamento/CarregarItens?codigoExame=' + _codigoExameAtual)
                .then(r => r.json())
                .then(data => {
                    if (data.sucesso) {
                        aplicarFiltroItens(data.itens);
                    }
                });
        }

        // Enter no campo de busca dispara a busca
        document.getElementById('txtSequencial').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); buscarExame(); }
        });
        document.getElementById('txtCodigoExame').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); buscarExame(); }
        });

        document.getElementById('chkExibirComValores').addEventListener('change', function () {
            aplicarFiltroItens();
        });
    </script>
}
