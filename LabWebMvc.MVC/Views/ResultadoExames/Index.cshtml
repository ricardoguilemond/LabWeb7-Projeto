@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BLL
@using static BLL.UtilBLL
@using LabWebMvc.MVC.Areas.Utils
@inject LabWebMvc.MVC.Models.Db _dbSituacao

<partial name='Partials/_PartialMenuResultadoExames' />

@*Feito pelo Kiro em 06/06/2026*@
<!-- Filtros Backend -->
<div id="filtrosResultadoExames" class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-magnifying-glass"></i> Filtros de Pesquisa
    </div>
    <div class="card-secao-body">
        <form method="get" asp-action="Index" asp-controller="ResultadoExames" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
        <label style="font: normal 13px calibri, arial, sans-serif;">Data Inicial:</label>
        <input type="text" name="dataInicial" id="filtroDataInicial" placeholder="dd/MM/yyyy"
               value="@Context.Request.Query["dataInicial"]"
               style="width: 110px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Data Final:</label>
        <input type="text" name="dataFinal" id="filtroDataFinal" placeholder="dd/MM/yyyy"
               value="@Context.Request.Query["dataFinal"]"
               style="width: 110px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Paciente:</label>
        <input type="text" name="nomePaciente" placeholder="Nome do paciente"
               value="@Context.Request.Query["nomePaciente"]"
               style="width: 160px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Código:</label>
        <input type="text" name="codigoExame" placeholder="Id"
               value="@Context.Request.Query["codigoExame"]"
               style="width: 70px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Sigla Inst.:</label>
        <input type="text" name="siglaInstituicao" placeholder="Sigla"
               value="@Context.Request.Query["siglaInstituicao"]"
               style="width: 80px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Status:</label>
        @{
            string filtroStatus = Context.Request.Query["status"].ToString();
        }
        @*Feito pelo Qoder em 15/08/2026 — removida a opção "Pendente" (0):
            exames pendentes aparecem apenas no Grid de Requisições (Portaria). *@
        @Html.Raw("<select name=\"status\" onchange=\"this.form.submit()\" style=\"width: 110px; height: 32px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;\">" +
            "<option value=\"\">Todos</option>" +
            "<option value=\"1\"" + (filtroStatus == "1" ? " selected" : "") + ">Em Análise</option>" +
            "<option value=\"3\"" + (filtroStatus == "3" ? " selected" : "") + ">Impresso</option>" +
            "<option value=\"5\"" + (filtroStatus == "5" ? " selected" : "") + ">A Repetir</option>" +
            "<option value=\"6\"" + (filtroStatus == "6" ? " selected" : "") + ">Material Inválido</option>" +
            "<option value=\"7\"" + (filtroStatus == "7" ? " selected" : "") + ">Pend. Cadastral</option>" +
            "</select>")

        <button type="submit" class="btn btn-success btn-sm" style="display: inline-block;">
            <i class="fa-sharp fa-solid fa-magnifying-glass"></i> Pesquisar
        </button>
        </form>
    </div>
</div>
@*..Kiro*@

<!-- Grid Header (ExamesRealizados liberados) -->
<div class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-flask-vial"></i> Resultados de Exames
    </div>
    <div class="card-secao-body">
        <div class="table-responsive">
            <table id="modeloTable" name="datatable" data-order='[]' class="display compact order-column stripe table-hover nowrap">
        <thead>
            <tr>
                <th>Cód.Exame</th>
                <th>Paciente</th>
                <th>Sigla Inst.</th>
                <th>Tabela</th>
                <th>Posto</th>
                <th>Seq</th>
                <th>Data Liberação</th>
                <th>Médico</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @* Dados carregados via AJAX pelo DataTables (server-side processing). *@
        </tbody>
        <tfoot>
            <tr>
                <th>Cód.Exame</th>
                <th>Paciente</th>
                <th>Sigla Inst.</th>
                <th>Tabela</th>
                <th>Posto</th>
                <th>Seq</th>
                <th>Data Liberação</th>
                <th>Médico</th>
                <th>Status</th>
            </tr>
        </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var urlParams = new URLSearchParams(window.location.search);

            $('#modeloTable tfoot th').each(function () {
                var title = $(this).text();
                if (title !== 'Status') {
                    $(this).html('<input type="text" placeholder="' + title + '" style="max-width: 106px; padding-left: 4px; border: 1px solid gray; border-radius: 5px;" />');
                } else {
                    $(this).html('');
                }
            });

            var table = $('#modeloTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/ResultadoExames/Listar',
                    type: 'POST',
                    data: function (d) {
                        d.dataInicial = urlParams.get('dataInicial') || '';
                        d.dataFinal = urlParams.get('dataFinal') || '';
                        d.nomePaciente = urlParams.get('nomePaciente') || '';
                        d.codigoExame = urlParams.get('codigoExame') || '';
                        d.siglaInstituicao = urlParams.get('siglaInstituicao') || '';
                        d.status = urlParams.get('status') || '';
                    }
                },
                pageLength: 10,
                order: [[0, 'desc']],
                columns: [
                    { data: 'id', name: 'id' },
                    { data: 'nomePaciente', name: 'nomePaciente', orderable: false },
                    { data: 'siglaInstituicao', name: 'siglaInstituicao', orderable: false },
                    { data: 'siglaTabela', name: 'siglaTabela', orderable: false },
                    { data: 'nomePosto', name: 'nomePosto', orderable: false },
                    { data: 'sequencial', name: 'sequencial', orderable: false },
                    { data: 'dataFim', name: 'dataFim', orderable: false },
                    { data: 'medico', name: 'medico', orderable: false },
                    {
                        data: 'statusTexto',
                        name: 'statusTexto',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            return '<span style="color:' + row.statusCor + '; font-weight:bold;">' + data + '</span>';
                        }
                    }
                ],
                createdRow: function (row, data) {
                    $(row).attr('data-situacao', data.situacao);
                    $(row).attr('data-total-impresso', data.totalImpresso);
                },
                autoWidth: true,
                responsive: true,
                fixedColumns: {
                    left: -1,
                    right: 1
                },
                fixedHeader: {
                    header: true,
                    footer: true
                },
                layout: {
                    topStart: {
                        pageLength: {
                            menu: [[10, 25, 50, 100, 250, 500, -1], [10, 25, 50, 100, 250, 500, "Todos"]]
                        }
                    },
                    topEnd: {
                        search: {
                            placeholder: 'Digite aqui sua busca'
                        }
                    },
                    bottomStart: 'info',
                    bottomEnd: {
                        paging: {
                            numbers: 5
                        }
                    }
                },
                language: {
                    search: "Busca:",
                    lengthMenu: "Mostrar _MENU_ resultados por página",
                    emptyTable: "<b style='color: red;'>Não haviam dados disponíveis para esta consulta</b>",
                    info: "Exibindo: _START_/_END_ de _TOTAL_ registros",
                    infoFiltered: "(Total de _MAX_ registros existentes na base de dados)",
                    infoThousands: ".",
                    thousands: ".",
                    decimal: ",",
                    loadingRecords: "Carregando...",
                    zeroRecords: "<b style='color: red;'>A consulta não retornou dados para o Grid</b>",
                    paginate: {
                        next: "<img src='images/icones/arrow_right_uno.png' width='28%' border='none' />",
                        previous: "<img src='images/icones/arrow_left_uno.png' width='28%' border='none' />",
                        first: "<img src='images/icones/arrow_left.png' width='28%' border='none' />",
                        last: "<img src='images/icones/arrow_right.png' width='28%' border='none' />"
                    }
                },
                initComplete: function () {
                    this.api().columns().every(function () {
                        var that = this;
                        $('input', this.footer()).on('keyup change clear', function () {
                            if (that.search() !== this.value) {
                                that.search(this.value).draw();
                            }
                        });
                    });
                }
            });

            $("input[type='search']")[0].focus();
        });
    </script>
}

<!-- Painel Informativo do Exame Selecionado -->
<div id="painelInfoExame" style="display:none; margin-top:10px; padding:8px 12px; border:1px solid #69c38a; border-radius:6px; background-color:#e8f5e9; font-size:13px; line-height:1.6;">
</div>

@*Feito pelo Kiro em 14/06/2025*@
<div id="botoesAcao" style="display:none; margin-top:8px; margin-bottom:8px;">
    <button type="button" id="btnLiberarExame" class="btn btn-warning btn-sm" style="margin-right:6px;" disabled>
        <i class="fa-solid fa-unlock"></i> Liberar Exame
    </button>
    <button type="button" id="btnImprimirResultado" class="btn btn-success btn-sm" style="margin-right:6px;">
        <i class="fa-solid fa-print"></i> Imprimir Resultado
    </button>
    <button type="button" id="btnBaixarAM" class="btn btn-primary btn-sm" style="margin-right:6px;">
        <i class="fa-solid fa-box-archive"></i> Baixar Arquivo-Morto
    </button>
</div>
@*..Kiro*@

<!-- Grid de Itens Editável -->
<div id="gridItensContainer" style="display:none; margin-top:10px; margin-bottom:150px;">
    <table class="table table-sm table-bordered" style="font-size:13px;">
        <thead style="background-color:#d4edda;">
            <tr>
                <th style="width:12%;">Folha</th>
                <th style="width:20%;">Descrição</th>
                <th style="width:20%;">Resultado</th>
                <th style="width:12%;">Unidade</th>
                <th style="width:24%;">Referência</th>
                <th style="width:12%;">Conta Exame</th>
            </tr>
        </thead>
        <tbody id="gridItensBody">
        </tbody>
    </table>
</div>

<style>
    /*Feito pelo Kiro em 06/06/2026*/
    @@media (max-width: 768px) {
        #filtrosResultadoExames form {
            flex-direction: column;
            align-items: flex-start;
        }
        #filtrosResultadoExames input {
            width: 100% !important;
        }
    }
    tr.detail-parent-highlight {
        background-color: #fff3cd !important;
    }
    tr.detail-parent-highlight td {
        background-color: #fff3cd !important;
    }
    #gridItensBody tr:hover {
        background-color: #f0f8f0;
    }
    #gridItensBody .input-resultado:focus {
        border-color: #69c38a !important;
        outline: none;
        box-shadow: 0 0 3px rgba(105, 195, 138, 0.5);
    }
    /*..Kiro*/
</style>
<script>
    //Feito pelo Kiro em 06/06/2026
    var exameRealizadoIdSelecionado = null; //Feito pelo Kiro em 14/06/2025

    $(document).ready(function () {
        $("#filtroDataInicial, #filtroDataFinal").mask("99/99/9999", { placeholder: " ", autoclear: false });

        // Valores padrão (últimos 30 dias)
        var dataIniInput = $("#filtroDataInicial");
        var dataFimInput = $("#filtroDataFinal");

        if (!dataIniInput.val()) {
            var hoje = new Date();
            var trintaDiasAtras = new Date(hoje);
            trintaDiasAtras.setDate(hoje.getDate() - 30);
            dataIniInput.val(formatarDataBR(trintaDiasAtras));
        }
        if (!dataFimInput.val()) {
            dataFimInput.val(formatarDataBR(new Date()));
        }
    });

    function formatarDataBR(data) {
        var dia = String(data.getDate()).padStart(2, '0');
        var mes = String(data.getMonth() + 1).padStart(2, '0');
        var ano = data.getFullYear();
        return dia + '/' + mes + '/' + ano;
    }

    // Clique na linha do grid header para carregar itens do exame
    $(document).ready(function () {
        $('#modeloTable tbody').on('click', 'tr', function (e) {
            if ($(e.target).closest('.grid_fundo_opcoes').length) return;

            var $row = $(this);
            var exameId = $.trim($row.find('td:first').text());
            if (!exameId) return;

            exameRealizadoIdSelecionado = exameId; //Feito pelo Kiro em 14/06/2025

            // Highlight
            $('#modeloTable tbody tr').removeClass('detail-parent-highlight');
            $row.addClass('detail-parent-highlight');

            carregarItensExame(exameId);
        });
    });

    function carregarItensExame(exameRealizadoId) {
        $.ajax({
            url: '/ResultadoExames/ObterItensExame',
            data: { exameRealizadoId: exameRealizadoId },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (data.sucesso) {
                    renderizarPainelInfo(data.info);
                    renderizarGridItens(data.itens);
                    // Só exibe o botão de Arquivo-Morto se o laudo já foi impresso ao menos 1 vez
                    if (data.info.totalImpresso > 0) {
                        $('#btnBaixarAM').show();
                    } else {
                        $('#btnBaixarAM').hide();
                    }
                    $('#botoesAcao').show(); //Feito pelo Kiro em 14/06/2025
                    atualizarBotaoLiberar();
                } else {
                    clickAviso('Erro', data.mensagem, 'critica', null);
                }
            },
            error: function () {
                clickAviso('Erro de Rede', 'Não foi possível carregar os itens do exame. Talvez seja necessário refazer login.', 'critica', null);
            }
        });
    }

    function renderizarPainelInfo(info) {
        var html = '<strong>Exame Nº ' + info.exameId + '</strong> | ' +
            'Paciente: ' + info.nomePaciente + ' (' + info.pacienteId + ') | ' +
            'Nasc: ' + info.nascimento + ' | ' +
            'CPF: ' + info.cpf + ' | ' +
            'Médico: ' + info.nomeMedico + ' CRM: ' + info.crm + '<br/>' +
            'Instituição: ' + info.siglaInstituicao + ' - ' + info.nomeInstituicao + ' | ' +
            'Tabela: ' + info.siglaTabela + ' | ' +
            'Posto: ' + info.nomePosto + ' | ' +
            'Seq: ' + info.sequencial + ' | ' +
            'Data Exame: ' + info.dataIni + ' | ' +
            'Liberação: ' + info.dataFim + ' | ' +
            'Impressões: ' + info.totalImpresso;
        $('#painelInfoExame').html(html).show();
    }

    function renderizarGridItens(itens) {
        var tbody = '';
        var folhaAnterior = '';
        itens.forEach(function (item) {
            if (item.ehPrincipal) {
                // Item Principal — cabeçalho visual (sem input, cor diferente)
                // Também serve como separador de grupo se a folha mudou
                folhaAnterior = item.folha || item.descricao || '';
                tbody += '<tr class="linha-cabecalho" style="background-color:#ffe0b2; font-weight:bold; pointer-events:none;">' +
                    '<td colspan="6" style="padding-left:8px; color:#bf360c;">' + (item.descricao || item.folha || '-') + '</td>' +
                    '</tr>';
            } else {
                // Se a folha mudou e não veio Principal antes, inserir separador automático
                if (item.folha && item.folha !== folhaAnterior) {
                    folhaAnterior = item.folha;
                    tbody += '<tr class="linha-cabecalho" style="background-color:#cce5ff; font-weight:bold; pointer-events:none;">' +
                        '<td colspan="6" style="padding-left:8px;">' + folhaAnterior + '</td>' +
                        '</tr>';
                }
                tbody += '<tr data-item-id="' + item.id + '">' +
                    '<td style="font-size:12px; color:#555;">' + (item.folha || '-') + '</td>' +
                    '<td style="font-size:12px;">' + (item.descricao || '-') + '</td>' +
                    '<td><input type="text" class="input-resultado" value="' + (item.resultado || '') + '" ' +
                        'style="width:100%; border:1px solid #ccc; border-radius:3px; padding:2px 4px; font-size:12px;" /></td>' +
                    '<td style="font-size:12px;">' + (item.unidadeMedida || '') + '</td>' +
                    '<td style="font-size:12px;">' + (item.referencia || '') + '</td>' +
                    '<td style="font-size:11px; color:#888;">' + (item.contaExame || '') + '</td>' +
                    '</tr>';
            }
        });

        $('#gridItensBody').html(tbody);
        $('#gridItensContainer').show();

        // Foco no primeiro input de resultado VAZIO (ou no primeiro se todos preenchidos)
        var $primeiroVazio = $('#gridItensBody tr:not(.linha-cabecalho) .input-resultado').filter(function() {
            return $(this).val() === '';
        }).first();
        if ($primeiroVazio.length) {
            $primeiroVazio.focus();
        } else {
            $('#gridItensBody tr:not(.linha-cabecalho):first .input-resultado').focus();
        }
    }

    function atualizarBotaoLiberar() {
        var $editaveis = $('#gridItensBody tr:not(.linha-cabecalho) .input-resultado');
        var totalEditaveis = $editaveis.length;
        var totalPreenchidos = $editaveis.filter(function () {
            return $(this).val().trim() !== '';
        }).length;

        $('#btnLiberarExame').prop('disabled', !(totalEditaveis > 0 && totalEditaveis === totalPreenchidos));
    }

    // Handler ENTER no campo Resultado — salva e avança
    $(document).ready(function () {
        $(document).off('keydown.resultadoExames').on('keydown.resultadoExames', '.input-resultado', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                var $tr = $(this).closest('tr');
                salvarItemResultado($tr);

                // Avançar para próxima linha editável (pular cabeçalhos)
                var $next = $tr.nextAll('tr:not(.linha-cabecalho)').first();
                if ($next.length) {
                    $next.find('.input-resultado').focus().select();
                }
            }
        });
    });

    function salvarItemResultado($tr) {
        var itemId = $tr.data('item-id');
        var resultado = $tr.find('.input-resultado').val();

        $.ajax({
            url: '/ResultadoExames/SalvarResultado',
            type: 'POST',
            data: { itemId: itemId, resultado: resultado },
            dataType: 'json',
            success: function (data) {
                if (data.sucesso) {
                    $tr.find('.input-resultado').css('border-color', '#28a745');
                    setTimeout(function () { $tr.find('.input-resultado').css('border-color', '#ccc'); }, 1000);

                    // Atualizar Status no grid header com base na situação retornada
                    var $highlightedRow = $('#modeloTable tbody tr.detail-parent-highlight');
                    if ($highlightedRow.length) {
                        var $statusCell = $highlightedRow.find('td:last');
                        var situacao = data.situacao;
                        var totalImp = data.totalImpresso;

                        var novoTexto = '';
                        var novaCor = '';

                        if (situacao === 1 && totalImp > 0) {
                            // Crítico: impresso mas alterado depois
                            novoTexto = 'Impresso(' + totalImp + '), Em Análise';
                            novaCor = '#CC6600';
                        } else if (situacao === 3) {
                            novoTexto = totalImp > 0 ? 'Impresso(' + totalImp + ')' : 'Impresso';
                            novaCor = 'darkgreen';
                        } else if (situacao === 1) {
                            novoTexto = 'Em Análise';
                            novaCor = 'blue';
                        } else if (situacao === 0) {
                            novoTexto = 'Pendente';
                            novaCor = 'red';
                        }

                        if (novoTexto) {
                            $statusCell.text(novoTexto).css({ 'color': novaCor, 'font-weight': 'bold' });
                        }

                        // Atualizar data-attributes
                        $highlightedRow.attr('data-situacao', situacao);
                        $highlightedRow.attr('data-total-impresso', totalImp);
                    }

                    atualizarBotaoLiberar();
                } else {
                    clickAviso('Erro', data.mensagem, 'critica', null);
                }
            },
            error: function () {
                clickAviso('Erro', 'Falha ao salvar resultado.', 'critica', null);
            }
        });
    }

    //Feito pelo Kiro em 14/06/2025
    // Handler — Imprimir Resultado
    $(document).off('click.impressao').on('click.impressao', '#btnImprimirResultado', function () {
        if (!exameRealizadoIdSelecionado) return;

        fetch('/ResultadoExames/ImprimirResultado?exameRealizadoId=' + exameRealizadoIdSelecionado)
            .then(function(response) {
                var contentType = response.headers.get('content-type');
                if (contentType && contentType.indexOf('application/pdf') !== -1) {
                    return response.blob().then(function(blob) {
                        var url = URL.createObjectURL(blob);
                        window.open(url, '_blank');

                        // Calcular o TotalImpresso real: pegar do painel info e somar 1
                        var painelHtml = $('#painelInfoExame').html();
                        var matchImp = painelHtml.match(/Impressões:\s*(\d+)/);
                        var totalImpNovo = matchImp ? parseInt(matchImp[1]) + 1 : 1;

                        // Atualizar status no grid header para "Impresso(N)"
                        var $highlightedRow = $('#modeloTable tbody tr.detail-parent-highlight');
                        if ($highlightedRow.length) {
                            var $statusCell = $highlightedRow.find('td:last');
                            $highlightedRow.attr('data-total-impresso', totalImpNovo);
                            $highlightedRow.attr('data-situacao', '3');
                            $statusCell.text('Impresso(' + totalImpNovo + ')').css({ 'color': 'darkgreen', 'font-weight': 'bold' });
                        }

                        // Atualizar TotalImpresso no painel info
                        if (matchImp) {
                            $('#painelInfoExame').html(painelHtml.replace(/Impressões:\s*\d+/, 'Impressões: ' + totalImpNovo));
                        }
                    });
                } else {
                    return response.json().then(function(data) {
                        clickAviso('Atenção', data.mensagem || 'Erro ao imprimir resultado.', 'critica', null);
                    });
                }
            })
            .catch(function() {
                clickAviso('Erro', 'Falha na comunicação com o servidor.', 'critica', null);
            });
    });

    // Handler — Baixar Arquivo-Morto
    $(document).off('click.baixarAM').on('click.baixarAM', '#btnBaixarAM', function () {
        if (!exameRealizadoIdSelecionado) return;

        Swal.fire({
            title: 'Confirmar Baixa',
            text: 'Deseja baixar este exame para Arquivo-Morto? Esta ação não pode ser desfeita.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sim, baixar',
            cancelButtonText: 'Cancelar'
        }).then(function(result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/ResultadoExames/BaixarExame',
                    type: 'POST',
                    data: { exameRealizadoId: exameRealizadoIdSelecionado },
                    dataType: 'json',
                    success: function(data) {
                        if (data.sucesso) {
                            // Remover linha do grid header
                            $('#modeloTable tbody tr.detail-parent-highlight').remove();
                            // Esconder painel info e grid itens
                            $('#painelInfoExame').hide();
                            $('#gridItensContainer').hide();
                            $('#botoesAcao').hide();
                            exameRealizadoIdSelecionado = null;
                            clickAviso('Sucesso', data.mensagem, 'sucesso', null);
                        } else {
                            clickAviso('Erro', data.mensagem, 'critica', null);
                        }
                    },
                    error: function() {
                        clickAviso('Erro', 'Falha na comunicação com o servidor.', 'critica', null);
                    }
                });
            }
        });
    });

    // Handler — Liberar Exame
    $(document).off('click.liberarExame').on('click.liberarExame', '#btnLiberarExame', function () {
        if (!exameRealizadoIdSelecionado) return;

        Swal.fire({
            title: 'Confirmar Liberação',
            text: 'Deseja liberar este exame? Após a liberação ele será disponibilizado para faturamento.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sim, liberar',
            cancelButtonText: 'Cancelar'
        }).then(function(result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/ResultadoExames/LiberarExame',
                    type: 'POST',
                    data: { exameRealizadoId: exameRealizadoIdSelecionado },
                    dataType: 'json',
                    success: function(data) {
                        if (data.sucesso) {
                            $('#modeloTable tbody tr.detail-parent-highlight').remove();
                            $('#painelInfoExame').hide();
                            $('#gridItensContainer').hide();
                            $('#botoesAcao').hide();
                            exameRealizadoIdSelecionado = null;
                            clickAviso('Sucesso', data.mensagem, 'sucesso', null);
                        } else {
                            clickAviso('Erro', data.mensagem, 'critica', null);
                        }
                    },
                    error: function() {
                        clickAviso('Erro', 'Falha na comunicação com o servidor.', 'critica', null);
                    }
                });
            }
        });
    });

    //..Kiro
    //..Kiro
</script>
