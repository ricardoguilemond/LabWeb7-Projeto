@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BLL
@using static BLL.UtilBLL
@using LabWebMvc.MVC.Interfaces
@using LabWebMvc.MVC.ViewModel
@model vmListaValidacao<dynamic>
<style>
    .getColorBackNormal {
        color: inherit;
        font-weight: normal;
        background-color: inherit !important;
    }

    /*Feito pelo Kiro em 01/08/2026*/
    .getColorBackFolha {
        color: #006400;
        font-weight: bold;
        background-color: #d4edda !important;
    }

    input.moeda:disabled {
        background-color: #d5d5d5 !important;
        color: #999 !important;
        cursor: not-allowed;
    }
    /*..Kiro*/

    .getColorBackPrincipal {
        color: blue;
        font-weight: bold;
        background-color: #add2fd !important;
    }

    .moeda {
        color: darkblue;
        background-color: white !important;
        border: 2px solid #cccad0 !important;
        border-radius: 2px;
        font-weight: 500;
        height: 21px;
    }

    /*Feito pelo Kiro em 01/08/2026*/
    .table-responsive {
        overflow-x: auto !important;
    }
    /* Truncar texto longo nas colunas de conteúdo */
    #modeloTable td:nth-child(3),
    #modeloTable td:nth-child(5) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; }
    /*..Kiro*/

    .summary {
        color: #646464;
        background-color: #add2fd;
        height: 21px;
    }

    .summary_item {
        color: black;
        background-color: inherit;
        height: 21px;
    }

    .summary_item {
        cursor: pointer;
    }

        .summary_item a {
            position: relative;
            display: inline-block;
        }

            .summary_item a[title]:hover::after {
                content: attr(title);
                position: absolute;
                top: -100%;
                left: 0;
                color: blue;
                background-color: #cccad0;
                padding: 2px;
                padding-left: 4px;
                padding-right: 4px;
                border: 1px solid blue !important;
                border-radius: 3px;
            }
</style>
<div class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-table-list"></i> Seleção de Tabela e Folha
    </div>
    <div class="card-secao-body">
        <div class="form-group">
    @Html.Label("Tabela de Preço?")
    <div style="display: inline-block;">
        @Html.DropDownListFor(x => x.PlanoExames.TabelaExamesId, Model.PlanoExames.TabelaIdList, new { @id = "id_tabela", @class = "itemTabelaExame", onchange = "atualizaBoxTabela(this);" })
        @Html.DropDownListFor(x => x.PlanoExames.TabelaExamesId, Model.PlanoExames.TabelaNomeList, new { @id = "nome_tabela", @class = "itemTabelaExame", onchange = "atualizaBoxTabela(this);" })
    </div>
</div>
<div class="form-group">
    @Html.Label("Folha de Exame?")
    <div style="display: inline-block;">
        @Html.DropDownListFor(x => x.PlanoExames.ClasseExamesId, Model.PlanoExames.FolhaIdList, new { @id = "id_folha", @class = "itemFolhaExame", onchange = "atualizaBoxFolha(this);" })
        @Html.DropDownListFor(x => x.PlanoExames.ClasseExamesId, Model.PlanoExames.FolhaNomeList, new { @id = "nome_folha", @class = "itemFolhaExame", onchange = "atualizaBoxFolha(this);" })
    </div>
</div>
<div style="margin: 8px 0; padding: 6px 12px; background-color: #fff3cd; border: 1px solid #ffc107; border-radius: 6px; font-size: 12px; color: #856404;">
        <i class="fa-solid fa-circle-info"></i> Todo item de exame que receber valor/preço será exibido na recepção para ser lançado em exames dos pacientes.
        </div>
    </div>
</div>
<div class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-list-check"></i> Itens da Folha de Exame
    </div>
    <div class="card-secao-body">
        <div class="table-responsive">
            <table id="modeloTable" name="datatable" data-order='[[ 3, "asc" ]]' class="display compact order-column table-striped table-hover">
        @await Html.PartialAsync("Partials/_PartialPlanoContaItem", Model)
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        //Feito pelo Kiro em 01/08/2026
        // Sobrescreve configTable para esta página com autoWidth:false
        // Correção: no primeiro carregamento o DataTables calcula larguras sobre HTML
        // já renderizado, gerando estilos inline incorretos. A solução é capturar o HTML
        // limpo da tabela ANTES da inicialização do DT e, no primeiro load, destruir a
        // instância e reinicializar sobre HTML limpo (mesma técnica do AJAX).
        var _planoExamesFirstLoad = true;
        var _planoExamesHtmlOriginal = $('#modeloTable').html();

        var _originalConfigTable = typeof configTable === 'function' ? configTable : null;
        configTable = function() {
            // No primeiro carregamento, garante HTML limpo (sem resíduos do DT)
            if (_planoExamesFirstLoad) {
                _planoExamesFirstLoad = false;
                // Se o DataTables já foi inicializado pelo _PartialDatatables, destrói
                if ($.fn.DataTable.isDataTable('#modeloTable')) {
                    $('#modeloTable').DataTable().destroy();
                }
                // Reinjeta o HTML original limpo (sem estilos inline do DT)
                $('#modeloTable').html(_planoExamesHtmlOriginal);
            }

            $('#modeloTable tfoot th').each(function () {
                var title = $(this).text();
                $(this).html('<input type="text" placeholder="' + title + '" style="max-width: 106px; padding-left: 4px; border: 1px solid gray; border-radius: 5px;" />');
            });
            $('#modeloTable').DataTable({
                initComplete: function () {
                    this.api().columns().every(function () {
                        var that = this;
                        $('input', this.footer()).on('keyup change clear', function () {
                            if (that.search() !== this.value) {
                                that.search(this.value).draw();
                            }
                        });
                    });
                },
                autoWidth: false,
                responsive: false,
                columns: [
                    { width: '4%' },    /* Tabela */
                    { width: '7%' },    /* Tipo Conta */
                    { width: '14%' },   /* Principal */
                    { width: '10%' },   /* Conta Exame */
                    { width: '15%' },   /* Descrição do Item */
                    { width: '9%' },    /* Valor Custo R$ */
                    { width: '9%' },    /* Valor Cobrar/Paciente R$ */
                    { width: '11%' },   /* Margem sobre o custo (%) */
                    { width: '11%' },   /* Margem Bruta (%) */
                    { width: '10%' }    /* Opções */
                ],
                layout: {
                    topStart: { pageLength: { menu: [[10, 25, 50, 100, 250, 500, -1], [10, 25, 50, 100, 250, 500, "Todos"]] } },
                    topEnd: { search: { placeholder: 'Digite aqui sua busca' } },
                    bottomStart: 'info',
                    bottomEnd: { paging: { numbers: 5 } }
                },
                "language": {
                    "search": "Busca:",
                    "lengthMenu": "Mostrar _MENU_ resultados por página",
                    "emptyTable": "<b style='color: red;'>Não haviam dados disponíveis para esta consulta</b>",
                    "info": "Exibindo: _START_/_END_ de _TOTAL_ registros",
                    "infoFiltered": "(Total de _MAX_ registros existentes na base de dados)",
                    "infoThousands": ".", "thousands": ".", "decimal": ",",
                    "loadingRecords": "Carregando...",
                    "zeroRecords": "<b style='color: red;'>A consulta não retornou dados para o Grid</b>",
                    "paginate": {
                        "next": "<img src='images/icones/arrow_right_uno.png' width='28%' border='none' />",
                        "previous": "<img src='images/icones/arrow_left_uno.png' width='28%' border='none' />",
                        "first": "<img src='images/icones/arrow_left.png' width='28%' border='none' />",
                        "last": "<img src='images/icones/arrow_right.png' width='28%' border='none' />"
                    }
                }
            }).draw();
        };
        //..Kiro
    </script>
    <div class="toolbar"><partial name='_PartialDatatables' /></div>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/jquery.maskMoney.min.js"></script>
    <script>
        $(document).ready(function () {
            var numeroItemTabela = $(".itemTabelaExame").val(1);
            var numeroItemFolha = $(".itemFolhaExame").val(1);

            //Carrega novo grid de acordo com os boxes
            $('.itemFolhaExame, .itemTabelaExame').change(function (event) {//class from RadioButton
                event.preventDefault();
                numeroItemTabela = $(".itemTabelaExame").val();  //obrigatório porque aqui pega em realtime o número da folha que ESTÁ selecionado no ComboBox!
                numeroItemFolha = $(".itemFolhaExame").val();  //obrigatório porque aqui pega em realtime o número da folha que ESTÁ selecionado no ComboBox!

                //Vamos atualizar o número da folha e chamar depois a partial view que vai atualizar AJAX somente a DIV chamada "contaDiv"
                $.ajax({
                    url: '/PlanoExamesItens?numeroItemFolha=' + numeroItemFolha + "&numeroTabela=" + numeroItemTabela + "&partial=true",
                    type: "GET",
                    async: true,
                    dataType: "html",
                    success: function (data) {
                        $('#modeloTable').DataTable().destroy();
                        $("#modeloTable").html(data);

                        configTable();

                    },
                    failure: function () { alert("Falhou carregamento do Grid"); }
                });
                numeroItemFolha = $(".itemFolhaExame").val(); //atualiza em realtime o número da folha que FOI selecionado no ComboBox!
                numeroItemTabela = $(".itemTabelaExame").val();

            });

            setTimeout(function () {
                restaurarTabelaEFolhaEGrid('PlanoExamesItens', function () {
                    restaurarEstadoGrid('PlanoExamesItens');
                });
            }, 500);
        });
    </script>
    <script type="text/javascript">
        //Declara os dois boxes com o default, e vamos sempre atualizar os dois Ids.
        var TabelaId = 1;
        var FolhaId = 1;
        //Atualiza os dois Combobox do DropDownList
        function atualizaBoxFolha(id) {//recebe o valor e atualiza os combobox da folha de exame
            FolhaId = id.value;
            $("#id_folha").val(FolhaId);
            $("#nome_folha").val(FolhaId);
            $("#id_tabela").val(TabelaId);
            $("#nome_tabela").val(TabelaId);
        }
        //
        function atualizaBoxTabela(id) {//recebe o valor e atualiza os combobox da tabela de preços
            TabelaId = id.value;
            $("#id_tabela").val(TabelaId);
            $("#nome_tabela").val(TabelaId);
            $("#id_folha").val(FolhaId);
            $("#nome_folha").val(FolhaId);
        }
        //
        function clickModelo(x) {
            //"x" é a linha toda da tag (tem que passar a linha TODA de "x")
            //x.id é somente o "id" na tag da linha
            salvarEstadoGrid('PlanoExamesItens', x.id);
            window.location.href = '@Url.Action("ModeloPlanoExamesItens", "PlanoExamesItens")?registroID=' + x.id;
        };
        function clickConsulta(x) {
            salvarEstadoGrid('PlanoExamesItens', x.id);
            var url = "ConsultarPlanoExamesItens?id=" + x.id;
            window.open(url, "_self")
        }
        //Feito pelo Kiro em 20/04/2026
        function clickAlterar(x) {
            salvarEstadoGrid('PlanoExamesItens', x.id);
            var id = x.id;
            var valorCusto = $('#valorCusto' + id).val();
            var valorItem = $('#valorItem' + id).val();
            var url = '@Url.Action("AlterarPlanoExamesItens", "PlanoExamesItens")?id=' + id;
            if (valorCusto) url += '&valorCusto=' + encodeURIComponent(valorCusto);
            if (valorItem) url += '&valorItem=' + encodeURIComponent(valorItem);
            window.location.href = url;
        }
        //..Kiro
        //
        //_PartialPlanoContaItem.cshtml
        function clickSalva(x) {
            var id = x.id;
            var valorCusto = $('#valorCusto' + id).val().replace(".", "").replace(",", ".");
            var valorItem = $('#valorItem' + id).val().replace(".", "").replace(",", ".");
            var idTabela = $("#id_tabela").val();
            var idFolha = $("#id_folha").val();

            //Todos os dados que vamos enviar da linha do grid para o controller
            var parameters = [
                id,
                valorCusto,
                valorItem,
                idTabela,
                idFolha
            ];
            $.ajax({
                url: '@Url.Action("SalvarItemGrid")?parameters=' + parameters,
                type: "GET",
                async: true,
                data: { parameters: parameters },
                dataType: "json",
                success: function (data) {
                    //console.log("data: ", data);
                    var titulo = data['titulo'];
                    var mensagem = data['mensagem'];
                    var actionPos = data['action'];
                    var sucesso = data['sucesso'];
                    titulo = (titulo == null) ? 'Atenção' : data['titulo'];
                    var tipo = 'falha';

                    //Json: Substitui certo na posição do summary
                    $('#summary').html(data['sumario']);   //atualiza o sumário pelo tbody
                    $('#' + data['id']).html(data['linhaMargemSobreCusto']);  //atualiza a margem sobre o custo da linha
                    $('#margemBruta' + data['id']).html(data['linhaMargemBruta']);  //atualiza a margem bruta da linha

                    if (sucesso == true) tipo = 'sucesso';
                    //success: Javascript ::: aqui acontece todas as mensagens de sucesso e não sucesso
                    clickAviso(titulo, mensagem, tipo, actionPos);  //mensagem normal com desvio para outra action (site.js)
                },
                error: function (request, status, error) {
                    //aqui somente acontece no caso de exception/erro do javascript
                    clickAviso('Interrompido', 'Falha na execução', 'critica', actionPos);  //mensagem crítica e com desvio para outra action (site.js)
                },
                failure: function () { alert("Falhou carregamento do Grid"); }
            });
        }

        //Feito pelo Kiro em 20/04/2026
        // Controle de edição: Principal vs Itens (mutuamente exclusivos para valores)
        $(document).on('change keyup', 'input.moeda', function () {
            var grupo = $(this).data('grupo');
            var tipo = $(this).data('tipo');
            if (!grupo || !tipo) return;

            var valor = parseFloat($(this).val().replace('.', '').replace(',', '.')) || 0;

            if (tipo === 'Principal' && valor > 0) {
                // Principal preenchido: desabilita itens do mesmo grupo
                $('input.moeda[data-grupo="' + grupo + '"][data-tipo="Item"]').prop('disabled', true);
            } else if (tipo === 'Principal' && valor === 0) {
                // Principal zerado: verifica se o outro campo da principal também está zerado
                var outroCampoPrincipal = $('input.moeda[data-grupo="' + grupo + '"][data-tipo="Principal"]').not(this);
                var outroValor = parseFloat(outroCampoPrincipal.val()?.replace('.', '').replace(',', '.')) || 0;
                if (outroValor === 0) {
                    $('input.moeda[data-grupo="' + grupo + '"][data-tipo="Item"]').prop('disabled', false);
                }
            } else if (tipo === 'Item' && valor > 0) {
                // Item preenchido: desabilita principal do mesmo grupo
                $('input.moeda[data-grupo="' + grupo + '"][data-tipo="Principal"]').prop('disabled', true);
            } else if (tipo === 'Item' && valor === 0) {
                // Item zerado: verifica se todos os itens do grupo estão zerados
                var algumItemComValor = false;
                $('input.moeda[data-grupo="' + grupo + '"][data-tipo="Item"]').each(function () {
                    var v = parseFloat($(this).val()?.replace('.', '').replace(',', '.')) || 0;
                    if (v > 0) algumItemComValor = true;
                });
                if (!algumItemComValor) {
                    $('input.moeda[data-grupo="' + grupo + '"][data-tipo="Principal"]').prop('disabled', false);
                }
            }
        });
        //..Kiro
    </script>
}
