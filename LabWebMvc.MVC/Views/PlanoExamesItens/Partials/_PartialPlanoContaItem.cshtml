@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using static BLL.UtilBLL
@using ExtensionsMethods.Genericos
@using LabWebMvc.MVC.ViewModel
@using LabWebMvc.MVC.Areas.Utils
@model vmListaValidacao<dynamic>

@Html.Raw("<thead>" +
          "<tr>" +
          "<th>Tabela</th>" +
          "<th>Tipo Conta</th>" +
          "<th>Principal</th>" +
          "<th>Conta Exame</th>" +
          "<th>Descrição do item</th>" +
          "<th>Valor Custo R$</th>" +
          "<th>Vr Paciente R$</th>" +
          "<th>Margem sobre o custo (%)</th>" +
          "<th>Margem Bruta (%)</th>" +
          "<th>Opções</th>" +
          "</tr>" +
          "</thead>" +
          "<tbody id='contaDiv'>")

@foreach (var item in Model.ListaDados)
{
    /* Margens para cada linha do grid! */
    string? margemSobreCusto = UtilsMath.CalcMargemSobreCusto(item.ValorCusto, item.ValorItem, 4, "%");
    string? margemBruta = UtilsMath.CalcMargemBruta(item.ValorCusto, item.ValorItem, 4, "%");
    TempData["linhaMargemSobreCusto"] = margemSobreCusto;
    TempData["linhaMargemBruta"] = margemBruta;

    /* armazena para serem salvos os valores alterados */
    vmPlanoExames plano = new vmPlanoExames()
                {
                    Id = item.Id,
                    ContaExame = item.ContaExame,
                    TabelaExamesId = item.TabelaExamesId,
                    RefItem = item.RefItem,
                    Descricao = item.Descricao,
                    ValorCusto = item.ValorCusto,
                    ValorItem = item.ValorItem
                };

    string strFundo = "<tr class='getColorBackNormal'>";

    string TipoConta = string.Empty;

    @if (Convert.ToInt32(plano.ContaExame.Substring(7, 4)) > 0)  //item
        TipoConta = "Item";

    @if ((Convert.ToInt32(plano.ContaExame.Substring(4, 3)) > 0) && (plano.ContaExame.Substring(7, 4) == "0000"))  //conta principal
    {
        TipoConta = "Principal";
        strFundo = "<tr class='getColorBackPrincipal'>";
    }
    @if (plano.ContaExame.Substring(4, 7) == "0000000")  //conta folha
    {
        TipoConta = "Folha";
        strFundo = "<tr class='getColorBackFolha'>";
    }

    string grupoConta = plano.ContaExame.Substring(0, 7);
    string prefixoFolha = plano.ContaExame.Substring(0, 4);
    string tipoLinha = TipoConta;

    //Feito pelo Kiro em 01/08/2026
    // Regra de desabilitação hierárquica de campos de valor:
    // - Se valor na Folha → desabilita Principais e Itens
    // - Se valor no Principal → desabilita Folha e Itens daquele grupo
    // - Se valor em Item → desabilita Folha e Principal daquele grupo
    bool folhaTemValor = Model.ListaDados.Any(d =>
        ((string)d.ContaExame).StartsWith(prefixoFolha) &&
        ((string)d.ContaExame).Substring(4, 7) == "0000000" &&
        (d.ValorCusto != null && d.ValorCusto > 0 || d.ValorItem != null && d.ValorItem > 0));

    bool campoDesabilitado = false;

    if (TipoConta == "Folha")
    {
        // Folha desabilitada se algum Principal ou Item da mesma folha tem valor
        bool algumFilhoTemValor = Model.ListaDados.Any(d =>
            ((string)d.ContaExame).StartsWith(prefixoFolha) &&
            ((string)d.ContaExame).Substring(4, 7) != "0000000" &&
            (d.ValorCusto != null && d.ValorCusto > 0 || d.ValorItem != null && d.ValorItem > 0));
        campoDesabilitado = algumFilhoTemValor;
    }
    else if (TipoConta == "Principal")
    {
        // Principal desabilitado se a Folha tem valor OU se algum Item do grupo tem valor
        bool itensTemValor = Model.ListaDados.Any(d =>
            ((string)d.ContaExame).StartsWith(grupoConta) &&
            ((string)d.ContaExame).Substring(7, 4) != "0000" &&
            (d.ValorCusto != null && d.ValorCusto > 0 || d.ValorItem != null && d.ValorItem > 0));
        campoDesabilitado = folhaTemValor || itensTemValor;
    }
    else if (TipoConta == "Item")
    {
        // Item desabilitado se a Folha tem valor OU se o Principal do grupo tem valor
        bool principalTemValor = Model.ListaDados.Any(d =>
            ((string)d.ContaExame).StartsWith(grupoConta) &&
            ((string)d.ContaExame).Substring(7, 4) == "0000" &&
            (d.ValorCusto != null && d.ValorCusto > 0 || d.ValorItem != null && d.ValorItem > 0));
        campoDesabilitado = folhaTemValor || principalTemValor;
    }
    //..Kiro

    string disabledAttr = campoDesabilitado ? "disabled" : "";

    @Html.Raw(strFundo +
              "<td style='width: 3%;'>" + plano.TabelaExamesId + "</td>" +
              "<td style='width: 6%;'>" + TipoConta + "</td>" +
              "<td style='width: 12%;'>" + plano.RefItem + "</td>" +
              "<td style='width: 9%;'>" + Utils.FormataConta(plano.ContaExame) + "</td>" +
              "<td style='width: 14%;'>" + plano.Descricao + "</td>")

    @Html.Raw("<td style='width: 8%;'>")
    <input type="text" name="ValorCusto" value="@plano.ValorCusto" onclick="this.value=''" onkeypress="formatarMoedaDecimal(this, ',', event)" class="moeda" id="valorCusto@(plano.Id)" style="width: 80px;" data-grupo="@grupoConta" data-folha="@prefixoFolha" data-tipo="@tipoLinha" @disabledAttr />
    @Html.Raw("</td>")
    @Html.Raw("<td style='width: 8%;'>")
    <input type="text" name="ValorItem" value="@plano.ValorItem" onclick="this.value=''" onkeypress="formatarMoedaDecimal(this, ',', event)" class="moeda" id="valorItem@(plano.Id)" style="width: 80px;" data-grupo="@grupoConta" data-folha="@prefixoFolha" data-tipo="@tipoLinha" @disabledAttr />
    @Html.Raw("</td>")
    @Html.Raw("<td id='" + plano.Id + "' class='linhaMargemSobreCusto' style='width: 10%; white-space: nowrap;'>" + @TempData["linhaMargemSobreCusto"] + "&nbsp;</td>")
    @Html.Raw("<td id='margemBruta" + plano.Id + "' class='linhaMargemBruta' style='width: 10%; white-space: nowrap;'>" + @TempData["linhaMargemBruta"] + "&nbsp;</td>")
    @Html.Raw("<td class='grid_fundo_opcoes'>" +
              "<a id=" + plano.Id + " class='grid_itens' onclick=clickSalva(this) title='Salvar os valores da linha'><i class='fa-solid fa-check'></i></a>" +
              "<a id=" + plano.Id + " class='grid_itens' onclick=clickAlterar(this) title='Alterar em todas as instituições'><i class='fa-sharp fa-solid fa-file-pen'></i></a>" +
              "<a id=" + plano.Id + " class='grid_itens' onclick=clickModelo(this) title='Consulta o modelo da folha'><i class='fa-regular fa-rectangle-list'></i></a>" +
              "<a id=" + plano.Id + " class='grid_itens' onclick=clickConsulta(this) title='Consultar item'><i class='fa-sharp fa-solid fa-display'></i></a>" +
              "</td>" +
              "</tr>")
}
@Html.Raw("</tbody>")
@Html.Raw("<tbody id='summary'>")
@Html.Raw(TempData["Summary"])
@Html.Raw("</tbody>")
@Html.Raw("<tfoot>" +
          "<tr>" +
          "<th>Tabela</th>" +
          "<th>Tipo Conta</th>" +
          "<th>Principal</th>" +
          "<th>Conta Exame</th>" +
          "<th>Descrição do item</th>" +
          "<th>Valor Custo R$</th>" +
          "<th>Vr Paciente R$</th>" +
          "<th>Margem sobre o custo (%)</th>" +
          "<th>Margem Bruta (%)</th>" +
          "<th id='op'>Opções</th>" +
          "</tr>" +
          "</tfoot>")
