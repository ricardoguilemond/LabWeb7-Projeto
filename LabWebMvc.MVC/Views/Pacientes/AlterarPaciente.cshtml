@using LabWebMvc.MVC.Areas.Utils
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@model vmPacientes
@{
    Layout = "_Layout";
}
<script>
    $(document).ready(function () {
        initBtnVoltar();
        $('#clickSubmit').click(function (event) {
            event.preventDefault();
            $.ajax({
                //url: '/Pacientes/AlterarPaciente',
                //url: '@Url.Action("AlterarPaciente", "Pacientes")',
                type: "POST",
                async: true,
                dataType: "json",
                data: $('#form').serialize(),
                success: function (data) {
                    //console.log("data: ", data);
                    var titulo = data['titulo'];
                    var mensagem = data['mensagem'];
                    var actionPos = data['action'];
                    var sucesso = data['sucesso'];
                    titulo = (titulo == null) ? 'Atenção' : data['titulo'];
                    var tipo = 'falha';
                    if (sucesso == true) tipo = 'sucesso';
                    //success: Javascript ::: aqui acontece todas as mensagens de sucesso e não sucesso
                    clickAviso(titulo, mensagem, tipo, actionPos);  //mensagem normal com desvio para outra action (site.js)
                },
                error: function (request, status, error) {
                    //aqui somente acontece no caso de exception/erro do javascript
                    clickAviso('Interrompido', 'Falha na execução', 'critica', actionPos);  //mensagem crítica e com desvio para outra action (site.js)
                }
            });
        })
    });
</script>

@using (Html.BeginForm(FormMethod.Post, new { @class = "form-horizontal", @id = "form", @enctype = "multipart/form-data" }))  //@id-"form" é obrigatório para campos chegarem do doutro lado
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="lab-form-container lab-refined">

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-user-pen"></i> Dados Pessoais
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-xl">
                        <label>*Nome paciente</label>
                        @Html.TextBoxFor(p => p.NomePaciente, new { @class = "form-control capitalize", @placeholder = "Entre com o nome completo do paciente", @required = "required" })
                    </div>
                    <div class="field-group w-sm">
                        <label>*Data Nascimento</label>
                        @*Feito pelo Qoder em 22/08/2026 — data sem horário; sentinela ≤ 01/01/1900 em branco; readonly, POST preserva valor existente (guard no controller)*@
                        <input name="Nascimento" type="text" class="form-control" readonly="readonly" value="@Model.Nascimento.FormataData()" />
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>Sexo</label>
                        <div class="radio-group">
                            @for (int i = 0; i < Utils.ListaGenero().Count; i++)
                            {
                                string sexo = Utils.RetornaItem(i, "Sexo", 1);  //index
                                string nome = Utils.RetornaItem(i, "Sexo", 2);
                                bool check = (sexo == Model.Sexo);

                                <span>
                                    @Html.RadioButton("Sexo", sexo, check)
                                    <label>@nome</label>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="field-group w-md">
                        <label>Estado Civil</label>
                        <div class="radio-group">
                            @for (int i = 0; i < Utils.ListaEstadoCivil().Count; i++)
                            {
                                int index = Utils.RetornaItem(i, "EstadoCivil", 0).ToInt32();
                                string nome = Utils.RetornaItem(i, "EstadoCivil", 1);
                                bool check = (index == Model.EstadoCivil);

                                <span>
                                    @Html.RadioButton("EstadoCivil", index, check)
                                    <label>@nome</label>
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-sm">
                        <label>Tipo de Documento</label>
                        @Html.DropDownListFor(p => p.vmGeral.TipoDocumento, new SelectList(Utils.ListaDocumento(), "Index", "Nome", selectedValue: 0), new { @class = "form-control" })
                    </div>
                    <div class="field-group w-md">
                        <label>Documento (será também o Login do paciente)</label>
                        @Html.TextBoxFor(p => p.CPF, new { @class = "form-control", @placeholder = "Entre com o documento", @required = "required" })
                        <div class="field-hint" style="color: red;">O documento será também o Login do paciente no Site/App</div>
                    </div>
                    <div class="field-group w-md">
                        <label>Órgão Emissor</label>
                        @Html.DropDownListFor(p => p.vmGeral.TipoOrgaoEmissor, new SelectList(Utils.ListaOrgaoEmissor(), "Index", "Nome", selectedValue: 0), new { @class = "form-control" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>Naturalidade</label>
                        @Html.TextBoxFor(p => p.Naturalidade, new { @class = "form-control capitalize", @placeholder = "Naturalidade" })
                    </div>
                    <div class="field-group w-md">
                        <label>Nacionalidade</label>
                        @Html.TextBoxFor(p => p.Nacionalidade, new { @class = "form-control capitalize", @placeholder = "Nacionalidade" })
                    </div>
                    <div class="field-group w-md">
                        <label>Profissão</label>
                        @Html.TextBoxFor(p => p.Profissao, new { @class = "form-control capitalize", @placeholder = "Profissão" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-location-dot"></i> Endereço
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-sm">
                        <label>CEP</label>
                        @Html.TextBoxFor(p => p.CEP, new { @class = "form-control", @placeholder = "CEP" })
                    </div>
                    <div class="field-group w-xl">
                        <label>Logradouro (Rua, Av, Estrada etc)</label>
                        @Html.TextBoxFor(p => p.Logradouro, new { @class = "form-control capitalize", @placeholder = "Logradouro/Rua/Trav" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-xl">
                        <label>Endereço completo</label>
                        @Html.TextBoxFor(p => p.Endereco, new { @class = "form-control capitalize", @placeholder = "Endereço" })
                    </div>
                    <div class="field-group w-sm">
                        <label>Número</label>
                        @Html.TextBoxFor(p => p.Numero, new { @class = "form-control capitalize", @placeholder = "Número" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>Complemento</label>
                        @Html.TextBoxFor(p => p.Complemento, new { @class = "form-control", @placeholder = "Complemento/Apto/Quadra/Lote" })
                    </div>
                    <div class="field-group w-md">
                        <label>Bairro</label>
                        @Html.TextBoxFor(p => p.Bairro, new { @class = "form-control capitalize", @placeholder = "Bairro" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-xl">
                        <label>Cidade/Município</label>
                        @Html.TextBoxFor(p => p.Cidade, new { @class = "form-control capitalize", @placeholder = "Cidade/Município" })
                    </div>
                    <div class="field-group w-xs">
                        <label>UF</label>
                        @Html.DropDownListFor(p => p.vmGeral.TipoUF, new SelectList(Utils.ListaUF(), "UF", "Nome", selectedValue: Model.SessionUF), new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-phone"></i> Contato e Informações Médicas
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>Telefone com DDD</label>
                        @Html.TextBoxFor(p => p.Telefone, new { @class = "form-control", @placeholder = "Telefone com DDD" })
                        @Html.ValidationMessageFor(p => p.Telefone, null, new { @class = "has-error" })
                    </div>
                    <div class="field-group w-lg">
                        <label>e-mail</label>
                        @Html.TextBoxFor(p => p.Email, new { @class = "form-control lowercase", @style = "color: blue;", @placeholder = "e-mail", @type = "email" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-sm">
                        <label>DUM</label>
                        @Html.TextBoxFor(p => p.DUM, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @placeholder = "DUM" })
                    </div>
                    <div class="field-group w-md">
                        <label>Tempo de Gestação</label>
                        @Html.DropDownListFor(p => p.vmGeral.TipoTempoGestacao, new SelectList(Utils.ListaTempoGestacao(), "Index", "Nome", selectedValue: "10"), new { @class = "form-control" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-full">
                        <label>Observação</label>
                        @Html.TextAreaFor(p => p.Observacao, new { @class = "form-control mediumTextBox lab-textarea", @placeholder = "Observação", @rows = "3" })
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group" style="margin-top: 16px;">
            <button type="button" id="btnVoltar" class="btn btn-lg btn-secondary lab-btn" style="margin-right: 10px;">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </button>
            <button id="clickSubmit" type="submit" class="btn btn-lg btn-success botao-verde lab-btn">
                Salvar
            </button>
        </div>

    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
