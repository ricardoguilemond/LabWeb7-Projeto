@using static BLL.UtilBLL
@using LabWebMvc.MVC.Areas.Utils
@using LabWebMvc.MVC.ViewModel
@using static ExtensionsMethods.Genericos.Enumeradores
@model vmPacientes
@{
    Layout = "_Layout";
}
<script>
    $(document).ready(function () {
        initBtnVoltar();
        $(".close").click(function (event) {
            event.preventDefault();
            window.history.back();
        });
    });
</script>
<!-- Trigger/Open The Modal -->
<div id="myModal" class="modal">
    <!-- Modal content -->
    <div class="modal-content">
        <div class="modal-header bg-verde-escuro">
            <h5 class="modal-title">@ViewBag.TextoMenu[0]</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body lab-refined">
            <div class="card-secao card-secao-w-lg">
                <div class="card-secao-header">
                    <i class="fa-solid fa-user-pen"></i> Dados Pessoais
                </div>
                <div class="card-secao-body">
                    <div class="field-row">
                        <div class="field-group w-xl">
                            <label>Nome Paciente</label>
                            <div class="field-readonly">@Model.NomePaciente</div>
                        </div>
                        <div class="field-group w-sm">
                            <label>Data Nascimento</label>
                            <div class="field-readonly">@Model.Nascimento.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="field-group w-xs">
                            <label>Sexo</label>
                            <div class="field-readonly">@Model.Sexo</div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-group w-sm">
                            <label>Tipo de Documento</label>
                            <div class="field-readonly">@Utils.RetornaItem(Model.TipoDocumento, "ListaDocumento", 1)</div>
                        </div>
                        <div class="field-group w-md">
                            @if (Model.TipoDocumento == (int)TipoDocumento.CPF)
                            {
                                <label>CPF</label>
                                <div class="field-readonly">@Model.CPF</div>
                            }
                            else if (Model.TipoDocumento == (int)TipoDocumento.SUS)
                            {
                                <label>SUS</label>
                                <div class="field-readonly">@Model.Identidade</div>
                            }
                            else
                            {
                                <label>Documento</label>
                                <div class="field-readonly">@Model.Identidade</div>
                            }
                        </div>
                        <div class="field-group w-sm">
                            <label>Emissor</label>
                            <div class="field-readonly">@Utils.RetornaItem(Model.vmGeral.TipoOrgaoEmissor, "ListaOrgaoEmissor", 1)</div>
                        </div>
                        <div class="field-group w-sm">
                            <label>Estado Civil</label>
                            <div class="field-readonly">@Utils.RetornaItem(Model.EstadoCivil, "ListaEstadoCivil", 1)</div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-group w-md">
                            <label>Naturalidade</label>
                            <div class="field-readonly">@Model.Naturalidade</div>
                        </div>
                        <div class="field-group w-md">
                            <label>Nacionalidade</label>
                            <div class="field-readonly">@Model.Nacionalidade</div>
                        </div>
                        <div class="field-group w-md">
                            <label>Profissão</label>
                            <div class="field-readonly">@Model.Profissao</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-secao card-secao-w-lg">
                <div class="card-secao-header">
                    <i class="fa-solid fa-location-dot"></i> Endereço
                </div>
                <div class="card-secao-body">
                    <div class="field-row">
                        <div class="field-group w-sm">
                            <label>CEP</label>
                            <div class="field-readonly">@Model.CEP</div>
                        </div>
                        <div class="field-group w-xl">
                            <label>Logradouro</label>
                            <div class="field-readonly">@Model.Endereco</div>
                        </div>
                        <div class="field-group w-sm">
                            <label>Número</label>
                            <div class="field-readonly">@Model.Numero</div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-group w-md">
                            <label>Complemento</label>
                            <div class="field-readonly">@Model.Complemento</div>
                        </div>
                        <div class="field-group w-md">
                            <label>Bairro</label>
                            <div class="field-readonly">@Model.Bairro</div>
                        </div>
                        <div class="field-group w-lg">
                            <label>Município/Cidade</label>
                            <div class="field-readonly">@Model.Cidade</div>
                        </div>
                        <div class="field-group w-xs">
                            <label>UF</label>
                            <div class="field-readonly">@Model.UF</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-secao card-secao-w-lg">
                <div class="card-secao-header">
                    <i class="fa-solid fa-phone"></i> Contato e Informações Médicas
                </div>
                <div class="card-secao-body">
                    <div class="field-row">
                        <div class="field-group w-md">
                            <label>Telefone</label>
                            <div class="field-readonly">@Model.Telefone</div>
                        </div>
                        <div class="field-group w-lg">
                            <label>e-mail</label>
                            <div class="field-readonly" style="color: blue;">@Model.Email</div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-group w-sm">
                            <label>DUM</label>
                            <div class="field-readonly">@Model.DUM</div>
                        </div>
                        <div class="field-group w-sm">
                            <label>Tempo Gestação</label>
                            <div class="field-readonly">@Utils.RetornaItem(Model.vmGeral.TipoTempoGestacao, "ListaTempoGestacao", 1)</div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-group w-full">
                            <label>Observação</label>
                            <div class="field-readonly">@Model.Observacao</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer" style="justify-content: center;">
            <button type="button" id="btnVoltar" class="btn btn-secondary lab-btn">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </button>
        </div>
    </div>
</div>
<!-- Meu JS (sempre no final) para poder renderizar junto com a página -->
<script src="@Url.Content("~/js/site.js")" type="text/javascript"></script>
<!-- Fim da página do Modal -->
