@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using LabWebMvc.MVC.Areas.Utils
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@model vmPacientes
@{
    Layout = "_Layout";
}
<script>
    $(document).ready(function () {
        initBtnVoltar();
        $('#clickSubmit').click(function (event) {
            event.preventDefault();
            $.ajax({
                //url: '@Url.Action("IncluirPaciente", "Pacientes")',
                type: "POST",
                async: true,
                dataType: "json",
                data: $('#form').serialize(),
                success: function (data) {
                    //console.log("data: ", data);
                    var titulo = data['titulo'];
                    var mensagem = data['mensagem'];
                    var actionPos = data['action'];
                    var sucesso = data['sucesso'];
                    titulo = (titulo == null) ? 'Atenção' : data['titulo'];
                    var tipo = 'falha';
                    if (sucesso == true) tipo = 'sucesso';
                    //success: Javascript ::: aqui acontece todas as mensagens de sucesso e não sucesso
                    clickAviso(titulo, mensagem, tipo, actionPos);  //mensagem normal com desvio para outra action (site.js)
                },
                error: function (request, status, error) {
                    //aqui somente acontece no caso de exception/erro do javascript
                    clickAviso('Interrompido', 'Falha na execução', 'critica', actionPos);  //mensagem crítica e com desvio para outra action (site.js)
                }
            });
            //Limpa todos os campos do formulário!
            $('#form')[0].reset();
        })
    });
</script>
@using (Html.BeginForm(FormMethod.Post, new { @class = "form-horizontal", @id = "form", @enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <style>
        .cadastro-clean .form-control { font-size: 12px !important; }
        .cadastro-clean select.form-control { font-size: 12px !important; }
    </style>
    <div class="cadastro-clean" style="max-width: 600px; margin: 20px 0; padding: 24px; border: 1px solid #d4edda; border-radius: 8px; background-color: #fff;">
        <h4 style="color: #333; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 1px solid #e0e0e0;">
            <i class="fa-solid fa-user-plus" style="color: #69c38a;"></i> Incluir Paciente
        </h4>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">*Nome completo do paciente (por favor, sem abreviações!)</label>
                @Html.TextBoxFor(p => p.NomePaciente,new { @class = "form-control capitalize", @placeholder="Entre com o nome completo do paciente", @required="required", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Sexo:</label>
                @for (int i = 0; i < Utils.ListaGenero().Count; i++)
                {
                    string sexo = Utils.RetornaItem(i, "Sexo", 1);  //index
                    string nome = Utils.RetornaItem(i, "Sexo", 2);
                    bool check = Utils.RetornaItem(i, "Sexo", 3).ConvertStringToBool();

                    <div style="display: inline-block;">
                        @Html.RadioButton("Sexo", sexo, check)
                        @Html.Label(nome)
                    </div>
                }
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Tipo de Documento: (CPF é recomendado)</label>
                @Html.DropDownListFor(p => p.vmGeral.TipoDocumento, new SelectList(Utils.ListaDocumento(), "Index", "Nome", selectedValue: 0), new { @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: blue;">O documento será também o Login do paciente no Site/App</label>
                @Html.TextBoxFor(p => p.CPF, new { @class = "form-control", @placeholder="Entre com o documento", @required="required", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
                <label style="font-size: 13px; color: #333;">Órgão Emissor:</label>
                @Html.DropDownListFor(p => p.vmGeral.TipoOrgaoEmissor, new SelectList(Utils.ListaOrgaoEmissor(), "Index", "Nome", selectedValue: 0), new { @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">*Data Nascimento</label>
                @Html.TextBoxFor(p => p.Nascimento, new { @class="form-control", @type="date", @placeholder="Data de nascimento", @required="required", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Estado Civil:</label>
                @for (int i = 0; i < Utils.ListaEstadoCivil().Count; i++)
                {
                    int index = Utils.RetornaItem(i, "EstadoCivil", 0).ToInt32();
                    string nome = Utils.RetornaItem(i, "EstadoCivil", 1);
                    bool check = Utils.RetornaItem(i, "EstadoCivil", 2).ConvertStringToBool();
                    <div style="display: inline-block;">
                        @Html.RadioButton("EstadoCivil", index, check)
                        @Html.Label(nome)
                    </div>
                }
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Naturalidade (Estado que nasceu)</label>
                @Html.TextBoxFor(p => p.Naturalidade, new { @class = "form-control capitalize", @placeholder="Naturalidade", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Naturalidade (país que nasceu)</label>
                @Html.TextBoxFor(p => p.Nacionalidade, new { @class = "form-control capitalize", @placeholder="Nacionalidade", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Profissão</label>
                @Html.TextBoxFor(p => p.Profissao, new { @class = "form-control capitalize", @placeholder="Profissão", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">CEP</label>
                @Html.TextBoxFor(p => p.CEP, new { @class = "form-control", @placeholder="CEP", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Logradouro (Rua, Av, Estrada etc)</label>
                @Html.TextBoxFor(p => p.Logradouro, new { @class = "form-control capitalize", @placeholder = "Logradouro/Rua/Trav", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Endereço completo</label>
                @Html.TextBoxFor(p => p.Endereco, new { @class = "form-control capitalize", @placeholder = "Endereço", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Número</label>
                @Html.TextBoxFor(p => p.Numero, new { @class = "form-control capitalize", @placeholder="Número", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Complemento</label>
                @Html.TextBoxFor(p => p.Complemento, new { @class = "form-control", @placeholder="Complemento/Apto/Quadra/Lote", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Bairro</label>
                @Html.TextBoxFor(p => p.Bairro, new { @class = "form-control capitalize", @placeholder="Bairro", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Cidade</label>
                @Html.TextBoxFor(p => p.Cidade, new { @class = "form-control capitalize", @placeholder="Cidade/Município", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">UF:</label>
                <div style="display: inline-block;">
                    @Html.DropDownListFor(p => p.vmGeral.TipoUF, new SelectList(Utils.ListaUF(), "UF", "Nome", selectedValue: Model.SessionUF), new { @style = "border: 1px solid #69c38a; border-radius: 6px;" })
                </div>
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Telefone com DDD</label>
                @Html.TextBoxFor(p => p.Telefone, new { @class = "form-control", @placeholder="Telefone com DDD", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
                @Html.ValidationMessageFor(p => p.Telefone, null, new { @class="has-error" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">E-mail</label>
                @Html.TextBoxFor(p => p.Email, new { @class = "form-control lowercase", @style="color: blue; border: 1px solid #69c38a; border-radius: 6px;", @placeholder="e-mail", @type="email" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">DUM</label>
                @Html.TextBoxFor(p => p.DUM, new { @class = "form-control", @type="date", @placeholder="DUM", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Tempo de Gestação:</label>
                <div style="display: inline-block;">
                    @Html.DropDownListFor(p => p.vmGeral.TipoTempoGestacao, new SelectList(Utils.ListaTempoGestacao(), "Index", "Nome", selectedValue: "10"), new { @style = "border: 1px solid #69c38a; border-radius: 6px;" })
                </div>
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Observação</label>
                @Html.TextAreaFor(p => p.Observacao, new { @class = "form-control capitalize mediumTextBox", @placeholder="Observação", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <!--
            Submeter Formulário
            -->
            <div class="form-group" style="margin-top: 20px; text-align: center;">
                <button type="button" id="btnVoltar" class="btn btn-lg btn-secondary" style="margin-right: 10px;">
                    <i class="fa-solid fa-arrow-left"></i> Voltar
                </button>
                <button id="clickSubmit" type="submit" class="btn btn-lg btn-success botao-verde" style="border-radius: 6px;">
                    Salvar
                </button>
            </div>
    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
