@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BLL
@using static BLL.UtilBLL
@using LabWebMvc.MVC.Interfaces
@using LabWebMvc.MVC.ViewModel
@using LabWebMvc.MVC.Areas.Utils
@model vmPacientes
<partial name='Partials/_PartialMenuPacientes' />

@*Feito pelo Kiro em 17/05/2026*@
<!-- Filtros Backend de Paciente -->
<div id="filtrosPacientes" class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-filter"></i> Filtros de Busca
    </div>
    <div class="card-secao-body">
    <form method="get" asp-action="Index" asp-controller="Pacientes" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
        <label style="font: normal 13px calibri, arial, sans-serif;">Paciente:</label>
        <input type="text" name="nomePaciente" placeholder="Nome do paciente"
               value="@Context.Request.Query["nomePaciente"]"
               style="width: 180px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">CPF:</label>
        <input type="text" name="cpf" id="filtroCpf" placeholder="000.000.000-00"
               value="@Context.Request.Query["cpf"]"
               style="width: 130px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Nascimento:</label>
        <input type="text" name="dataNascimento" id="filtroDataNascimento" placeholder="dd/MM/yyyy"
               value="@Context.Request.Query["dataNascimento"]"
               style="width: 110px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <button type="submit" class="btn btn-success btn-sm" style="display: inline-block;">
            <i class="fa-sharp fa-solid fa-magnifying-glass"></i> Pesquisar
        </button>
    </form>
    </div>
</div>
@*..Kiro*@

<div class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-user-pen"></i> Pacientes Cadastrados
    </div>
    <div class="card-secao-body">
        <div class="table-responsive">
    <table id="modeloTable" name="datatable" data-order='[[ 0, "desc" ]]' class="display compact order-column stripe table-hover nowrap">
        <thead>
            <tr>
                <th>Id</th>
                <th>Id Externo</th>
                <th>Nome Paciente</th>
                <th>DT Nascimento</th>
                <th>Sexo</th>
                <th>Documento</th>
                <th>Tipo.Doc</th>
                <th>Telefone</th>
                <th>Opções</th>
            </tr>
        </thead>
        <tbody>
            @* Dados carregados via AJAX pelo DataTables (server-side processing). *@
        </tbody>
        <tfoot>
            <tr>
                <th>Id</th>
                <th>Id Externo</th>
                <th>Nome Paciente</th>
                <th>DT Nascimento</th>
                <th>Sexo</th>
                <th>Documento</th>
                <th>Tipo.Doc</th>
                <th>Telefone</th>
                <th id="op">Opções</th>
            </tr>
        </tfoot>
    </table>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Configura os inputs de pesquisa no footer
            $('#modeloTable tfoot th').each(function () {
                var title = $(this).text();
                if (title !== 'Opções') {
                    $(this).html('<input type="text" placeholder="' + title + '" style="max-width: 106px; padding-left: 4px; border: 1px solid gray; border-radius: 5px;" />');
                } else {
                    $(this).html('');
                }
            });

            var urlParams = new URLSearchParams(window.location.search);

            var table = $('#modeloTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/Pacientes/Listar',
                    type: 'POST',
                    data: function (d) {
                        d.nomePaciente = urlParams.get('nomePaciente') || '';
                        d.cpf = urlParams.get('cpf') || '';
                        d.dataNascimento = urlParams.get('dataNascimento') || '';
                    }
                },
                pageLength: 10,
                order: [[0, 'desc']],
                columns: [
                    { data: 'id', name: 'id' },
                    { data: 'idPacienteExterno', name: 'idPacienteExterno', orderable: false },
                    { data: 'nomePaciente', name: 'nomePaciente' },
                    { data: 'nascimento', name: 'nascimento', orderable: false },
                    { data: 'sexo', name: 'sexo', orderable: false },
                    { data: 'documento', name: 'documento', orderable: false },
                    { data: 'tipoDocumento', name: 'tipoDocumento', orderable: false },
                    { data: 'telefone', name: 'telefone', orderable: false },
                    { data: 'acoes', name: 'acoes', orderable: false, searchable: false }
                ],
                autoWidth: true,
                responsive: true,
                fixedColumns: {
                    left: -1,
                    right: 1
                },
                fixedHeader: {
                    header: true,
                    footer: true
                },
                layout: {
                    topStart: {
                        pageLength: {
                            menu: [[10, 25, 50, 100, 250, 500, -1], [10, 25, 50, 100, 250, 500, "Todos"]]
                        }
                    },
                    topEnd: {
                        search: {
                            placeholder: 'Digite aqui sua busca'
                        }
                    },
                    bottomStart: 'info',
                    bottomEnd: {
                        paging: {
                            numbers: 5
                        }
                    }
                },
                language: {
                    search: "Busca:",
                    lengthMenu: "Mostrar _MENU_ resultados por página",
                    emptyTable: "<b style='color: red;'>Não haviam dados disponíveis para esta consulta</b>",
                    info: "Exibindo: _START_/_END_ de _TOTAL_ registros",
                    infoFiltered: "(Total de _MAX_ registros existentes na base de dados)",
                    infoThousands: ".",
                    thousands: ".",
                    decimal: ",",
                    loadingRecords: "Carregando...",
                    zeroRecords: "<b style='color: red;'>A consulta não retornou dados para o Grid</b>",
                    paginate: {
                        next: "<img src='images/icones/arrow_right_uno.png' width='28%' border='none' />",
                        previous: "<img src='images/icones/arrow_left_uno.png' width='28%' border='none' />",
                        first: "<img src='images/icones/arrow_left.png' width='28%' border='none' />",
                        last: "<img src='images/icones/arrow_right.png' width='28%' border='none' />"
                    }
                },
                initComplete: function () {
                    this.api().columns().every(function () {
                        var that = this;
                        $('input', this.footer()).on('keyup change clear', function () {
                            if (that.search() !== this.value) {
                                that.search(this.value).draw();
                            }
                        });
                    });

                    setTimeout(function () {
                        if (typeof restaurarEstadoGrid === 'function') {
                            restaurarEstadoGrid('Pacientes');
                        }
                    }, 500);
                }
            });

            $("input[type='search']")[0].focus();
        });
    </script>
}
