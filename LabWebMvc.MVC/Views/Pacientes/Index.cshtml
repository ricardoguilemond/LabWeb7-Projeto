<script>
    //ACTIONS ICONS
    function clickConsulta(x) {
        salvarEstadoGrid('Pacientes', x.id);
        var url = "ConsultarPaciente?id=" + x.id;
        window.open(url, "_self")
        //window.location.href = '@Url.Action("ConsultarPaciente", "Pacientes")?id=' + x.id;
    }
    function clickExames(x) {
        alert("Em desenvolvimento - Exames Realizados: " + x.id);
        //window.location.href = '@Url.Action("ExamesPaciente", "Pacientes")?id=' + x.id;
    }
    function clickAlterar(x) { //OK
        salvarEstadoGrid('Pacientes', x.id);
        window.location.href = '@Url.Action("AlterarPaciente", "Pacientes")?id=' + x.id;
    }
    function clickDelete(x) {
        //"x" é a linha toda da tag (tem que passar a linha TODA de "x")
        //x.id é somente o "id" na tag da linha
        return clickConfirm(x, null, "Excluir paciente?", null, "ExcluirPaciente");
    };

    //Feito pelo Kiro em 17/05/2026
    // Máscaras dos filtros de paciente
    $(document).ready(function () {
        $("#filtroDataNascimento").mask("99/99/9999", { placeholder: " ", autoclear: false });
        $("#filtroCpf").mask("999.999.999-99", { placeholder: " ", autoclear: false });
    });

    function formatarDataBR(data) {
        var dia = String(data.getDate()).padStart(2, '0');
        var mes = String(data.getMonth() + 1).padStart(2, '0');
        var ano = data.getFullYear();
        return dia + '/' + mes + '/' + ano;
    }
    //..Kiro

    //Feito pelo Kiro em 17/05/2026
    // Detail inline de exames — expand/collapse ao clicar na linha do paciente
    var _carregandoDetailExames = false;

    $(document).ready(function () {
        $(document).off('click.detailExames').on('click.detailExames', '#modeloTable tbody tr', function (e) {
            // Ignorar cliques na coluna de opções
            if ($(e.target).closest('.grid_fundo_opcoes').length) return;
            // Ignorar cliques em linhas de detalhe
            if ($(this).hasClass('detail-row') || $(this).hasClass('detail-header-row')) return;
            // Prevenir clique duplo
            if (_carregandoDetailExames) return;

            var $row = $(this);
            var pacienteId = $.trim($row.find('td:first').text());
            if (!pacienteId) return;

            // Fechar detail anterior (somente um aberto por vez)
            $('#modeloTable tbody tr.detail-item-row').remove();
            $('#modeloTable tbody tr.detail-row, #modeloTable tbody tr.detail-header-row').remove();
            $('#modeloTable tbody tr.detail-parent-highlight').removeClass('detail-parent-highlight');

            // Destacar a linha do paciente clicado
            $row.addClass('detail-parent-highlight');

            // Carregar exames do paciente via AJAX
            carregarExamesPaciente($row, pacienteId);
        });
    });

    // Handler do filtro inline de datas no detail de exames
    $(document).ready(function () {
        $(document).off('click.filtrarDetailExames').on('click.filtrarDetailExames', '#btnFiltrarDetailExames', function (e) {
            e.stopPropagation();

            var $parentRow = $('#modeloTable tbody tr.detail-parent-highlight');
            if (!$parentRow.length) return;

            var pacienteId = $.trim($parentRow.find('td:first').text());
            if (!pacienteId) return;

            var dataInicial = $('#detailDataInicial').val();
            var dataFinal = $('#detailDataFinal').val();

            // Fechar detail atual
            $('#modeloTable tbody tr.detail-item-row').remove();
            $('#modeloTable tbody tr.detail-row, #modeloTable tbody tr.detail-header-row').remove();

            // Recarregar com filtro de datas
            carregarExamesPaciente($parentRow, pacienteId, dataInicial, dataFinal);
        });
    });

    function carregarExamesPaciente($row, pacienteId, dataInicial, dataFinal) {
        _carregandoDetailExames = true;

        var requestData = { pacienteId: pacienteId };
        if (dataInicial) requestData.dataInicial = dataInicial;
        if (dataFinal) requestData.dataFinal = dataFinal;

        $.ajax({
            url: '/Pacientes/ObterExamesPaciente',
            data: requestData,
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (data.sucesso && data.exames && data.exames.length > 0) {
                    renderizarExamesPaciente($row, data.exames, data.examesOcultos || 0, data.totalExames || 0);
                } else if (data.sucesso && (!data.exames || data.exames.length === 0)) {
                    // Nenhum exame encontrado — exibir mensagem inline
                    var msgHtml = '<tr class="detail-row">' +
                        '<td colspan="9" style="text-align:center; color:#888; font-style:italic;">Nenhum exame encontrado para este paciente.</td>' +
                        '</tr>';
                    $row.after(msgHtml);
                }
            },
            error: function () {
                clickAviso('Erro de Rede', 'Não foi possível carregar os exames do paciente. Talvez seja necessário refazer login.', 'critica', null);
                $row.removeClass('detail-parent-highlight');
            },
            complete: function () {
                _carregandoDetailExames = false;
            }
        });
    }

    function renderizarExamesPaciente($row, exames, examesOcultos, totalExames) {
        // Linha de cabeçalho do detail com filtro inline de datas
        var headerHtml = '<tr class="detail-header-row">' +
            '<td colspan="9">' +
            '<div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">' +
            '<strong>Exames Realizados</strong>' +
            '<label style="font-weight:normal; margin:0;">Data Inicial:</label>' +
            '<input type="text" id="detailDataInicial" placeholder="dd/MM/yyyy" style="width:100px; padding-left:4px; border:1px solid #69c38a; border-radius:4px; font-size:12px; height:22px;" />' +
            '<label style="font-weight:normal; margin:0;">Data Final:</label>' +
            '<input type="text" id="detailDataFinal" placeholder="dd/MM/yyyy" style="width:100px; padding-left:4px; border:1px solid #69c38a; border-radius:4px; font-size:12px; height:22px;" />' +
            '<button type="button" id="btnFiltrarDetailExames" class="btn btn-success btn-xs" style="padding:2px 8px; font-size:12px;">' +
            '<i class="fa-sharp fa-solid fa-magnifying-glass"></i> Filtrar' +
            '</button>' +
            '</div>' +
            '</td>' +
            '</tr>';
        $row.after(headerHtml);

        // Aplicar máscaras de data no filtro inline
        $("#detailDataInicial, #detailDataFinal").mask("99/99/9999", { placeholder: " ", autoclear: false });

        var $lastInserted = $row.next();
        exames.forEach(function (exame) {
            // Linha de títulos do exame
            var titulosHtml = '<tr class="detail-row detail-exame-row" style="font-weight:bold;">' +
                '<td style="padding-left:10px;">Cód. Exame</td>' +
                '<td>Data Ini</td>' +
                '<td>Data Fim</td>' +
                '<td>Sigla Inst.</td>' +
                '<td colspan="5">Posto</td>' +
                '</tr>';
            $lastInserted.after(titulosHtml);
            $lastInserted = $lastInserted.next();

            // Linha de dados do exame
            var exameHtml = '<tr class="detail-row detail-exame-row">' +
                '<td style="padding-left:10px;"><strong>Cód. ' + (exame.id || '-') + '</strong></td>' +
                '<td>' + (exame.dataIni || '-') + '</td>' +
                '<td>' + (exame.dataFim || '-') + '</td>' +
                '<td>' + (exame.siglaInstituicao || '-') + '</td>' +
                '<td colspan="5">' + (exame.nomePosto || '-') + '</td>' +
                '</tr>';
            $lastInserted.after(exameHtml);
            $lastInserted = $lastInserted.next();

            // Itens do exame (sub-linhas)
            if (exame.itens && exame.itens.length > 0) {
                // Header dos itens (com Folha e Médico)
                var medicoNomeHtml = exame.medicoId
                    ? '<span class="link-medico-detail" data-medico-id="' + exame.medicoId + '" role="button" tabindex="0">' + (exame.nomeMedico || '-') + '</span>'
                    : (exame.nomeMedico || '-');
                var medicoInfo = medicoNomeHtml + (exame.crm ? ' CRM: ' + exame.crm : '');
                var itensHeaderHtml = '<tr class="detail-item-row" style="font-weight:bold;">' +
                    '<td></td>' +
                    '<td style="padding-left:20px;">Folha</td>' +
                    '<td>Ref. Exame</td>' +
                    '<td>Ref. Item</td>' +
                    '<td>Conta Exame</td>' +
                    '<td>Descrição</td>' +
                    '<td colspan="3" style="text-align:right;">Médico: ' + medicoInfo + '</td>' +
                    '</tr>';
                $lastInserted.after(itensHeaderHtml);
                $lastInserted = $lastInserted.next();

                exame.itens.forEach(function (item) {
                    var itemHtml = '<tr class="detail-item-row">' +
                        '<td></td>' +
                        '<td style="padding-left:20px;">' + (item.folha || '-') + '</td>' +
                        '<td>' + (item.refExame || '-') + '</td>' +
                        '<td>' + (item.refItem || '-') + '</td>' +
                        '<td>' + (item.contaExame || '-') + '</td>' +
                        '<td colspan="4">' + (item.descricao || '-') + '</td>' +
                        '</tr>';
                    $lastInserted.after(itemHtml);
                    $lastInserted = $lastInserted.next();
                });
            }
        });

        // Indicador de exames ocultos (clicável — expande para últimos 12 meses)
        if (examesOcultos > 0) {
            var indicadorHtml = '<tr class="detail-row detail-expandir-row" data-paciente-id="' + $row.find('td:first').text().trim() + '">' +
                '<td colspan="9" style="text-align:center; padding:6px; color:#1a73e8; font-style:italic; cursor:pointer; pointer-events:auto;">' +
                '<i class="fa-solid fa-angles-down"></i> +' + examesOcultos + ' exames anteriores — ver histórico 12 meses (total: ' + totalExames + ')' +
                '</td></tr>';
            $lastInserted.after(indicadorHtml);
        }
    }

    // Handler de clique no indicador de expansão (últimos 12 meses)
    $(document).ready(function () {
        $(document).off('click.expandirExames').on('click.expandirExames', '.detail-expandir-row', function (e) {
            var $indicador = $(this);
            var pacienteId = $indicador.data('paciente-id');
            if (!pacienteId) return;

            // Encontrar a linha do paciente (detail-parent-highlight)
            var $parentRow = $('#modeloTable tbody tr.detail-parent-highlight');
            if (!$parentRow.length) return;

            // Remover detail atual
            $('#modeloTable tbody tr.detail-item-row').remove();
            $('#modeloTable tbody tr.detail-row, #modeloTable tbody tr.detail-header-row').remove();

            // Carregar exames expandidos (últimos 12 meses)
            carregarExamesPacienteExpandido($parentRow, pacienteId);
        });
    });

    function carregarExamesPacienteExpandido($row, pacienteId) {
        _carregandoDetailExames = true;

        $.ajax({
            url: '/Pacientes/ObterExamesPaciente',
            data: { pacienteId: pacienteId, expandir: true },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (data.sucesso && data.exames && data.exames.length > 0) {
                    renderizarExamesPaciente($row, data.exames, 0, 0);
                    // Adicionar link "Recolher exames mostrados" ao final
                    var $ultimaLinha = $('#modeloTable tbody tr.detail-row:last, #modeloTable tbody tr.detail-item-row:last').last();
                    var recolherHtml = '<tr class="detail-row detail-recolher-row" data-paciente-id="' + pacienteId + '">' +
                        '<td colspan="9" style="text-align:center; padding:6px; color:#1a73e8; font-style:italic; cursor:pointer; pointer-events:auto;">' +
                        '<i class="fa-solid fa-angles-up"></i> Recolher exames mostrados' +
                        '</td></tr>';
                    $ultimaLinha.after(recolherHtml);
                } else if (data.sucesso && (!data.exames || data.exames.length === 0)) {
                    var msgHtml = '<tr class="detail-row">' +
                        '<td colspan="9" style="text-align:center; color:#888; font-style:italic;">Nenhum exame encontrado nos últimos 12 meses.</td>' +
                        '</tr>';
                    $row.after(msgHtml);
                }
            },
            error: function () {
                clickAviso('Erro de Rede', 'Não foi possível carregar os exames expandidos.', 'critica', null);
            },
            complete: function () {
                _carregandoDetailExames = false;
            }
        });
    }

    // Handler de clique no link "Recolher exames mostrados"
    $(document).ready(function () {
        $(document).off('click.recolherExames').on('click.recolherExames', '.detail-recolher-row', function (e) {
            var $recolherRow = $(this);
            var pacienteId = $recolherRow.data('paciente-id');
            if (!pacienteId) return;

            var $parentRow = $('#modeloTable tbody tr.detail-parent-highlight');
            if (!$parentRow.length) return;

            // Remover detail atual
            $('#modeloTable tbody tr.detail-item-row').remove();
            $('#modeloTable tbody tr.detail-row, #modeloTable tbody tr.detail-header-row').remove();

            // Recarregar com regra inteligente (modo normal)
            carregarExamesPaciente($parentRow, pacienteId);
        });
    });

    //Feito pelo Kiro em 17/05/2026
    // Handler de clique no nome do médico no detail — abre modal de consulta
    $(document).ready(function () {
        $(document).off('click.medicoDetail').on('click.medicoDetail', '.link-medico-detail', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var medicoId = $(this).data('medico-id');
            if (!medicoId) return;

            var modalUrl = '/Medicos/ModalConsultarMedico?id=' + medicoId;
            $('#modalTriggerMedico').load(modalUrl, function (response, status, xhr) {
                if (status === 'error') {
                    console.error('Erro ao carregar modal do médico. Status:', xhr.status, xhr.statusText);
                    console.error('Resposta:', response);
                    clickAviso('Erro', 'Não foi possível carregar os dados do médico. (HTTP ' + xhr.status + ')', 'critica', null);
                    return;
                }
                var modalEl = document.getElementById('modalConsultarMedico');
                if (modalEl) {
                    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.show();
                } else {
                    console.error('Elemento #modalConsultarMedico não encontrado na resposta.');
                    clickAviso('Erro', 'Modal não encontrado na resposta.', 'critica', null);
                }
            });
        });

        // Suporte à navegação por teclado (ENTER/ESPAÇO)
        $(document).off('keydown.medicoDetail').on('keydown.medicoDetail', '.link-medico-detail', function (e) {
            if (e.which === 13 || e.which === 32) {
                e.preventDefault();
                $(this).trigger('click');
            }
        });
    });
    //..Kiro
</script>

<!-- Container para o modal de consulta de médico -->
<div id="modalTriggerMedico"></div>