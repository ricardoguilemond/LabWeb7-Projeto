@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BLL
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@model vmConsultarExames

<partial name='Partials/_PartialMenuConsultarExames' />

@*Feito pelo Kiro em 17/05/2026*@
<!-- Filtros Backend -->
<div id="filtrosConsultarExames" class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-magnifying-glass"></i> Filtros de Pesquisa
    </div>
    <div class="card-secao-body">
        <form method="get" asp-action="Index" asp-controller="ConsultarExames" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
        <label style="font: normal 13px calibri, arial, sans-serif;">Data do Exame DE:</label>
        <input type="text" name="dataExameDe" placeholder="dd/MM/yyyy" value="@ViewBag.DataExameDe"
               style="width: 110px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />
        <label style="font: normal 13px calibri, arial, sans-serif;">ATÉ:</label>
        <input type="text" name="dataExamePara" placeholder="dd/MM/yyyy" value="@ViewBag.DataExamePara"
               style="width: 110px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Paciente:</label>
        <input type="text" name="nomePaciente" placeholder="Nome do paciente" value="@Context.Request.Query["nomePaciente"]"
               style="width: 160px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Código:</label>
        <input type="text" name="codigoExame" placeholder="Id" value="@Context.Request.Query["codigoExame"]"
               style="width: 70px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Sigla Inst.:</label>
        <input type="text" name="siglaInstituicao" placeholder="Sigla" value="@Context.Request.Query["siglaInstituicao"]"
               style="width: 80px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Instituição:</label>
        <input type="text" name="nomeInstituicao" placeholder="Nome instituição" value="@Context.Request.Query["nomeInstituicao"]"
               style="width: 150px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        <label style="font: normal 13px calibri, arial, sans-serif;">Posto:</label>
        <input type="text" name="nomePosto" placeholder="Nome do posto" value="@Context.Request.Query["nomePosto"]"
               style="width: 140px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;" />

        @*Feito pelo Qoder em 21/04/2026 - filtro Sigla Posto (D8)*@
        <label style="font: normal 13px calibri, arial, sans-serif;">Sigla Posto:</label>
        <input type="text" name="siglaPosto" placeholder="Sigla" value="@Context.Request.Query["siglaPosto"]"
               style="width: 90px; padding-left: 4px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px; text-transform: uppercase;"
               maxlength="20" oninput="this.value=this.value.toUpperCase()" />
        @*..Qoder*@

        <div style="display: flex; align-items: center; gap: 12px; min-height: 30px;">
            <label style="font: normal 13px calibri, arial, sans-serif; margin-bottom: 0;">
                <input type="radio" name="situacaoExame" value="todos" @(ViewBag.SituacaoExame == "todos" ? "checked" : "") onchange="this.form.submit()" /> Todos
            </label>
            <label style="font: normal 13px calibri, arial, sans-serif; margin-bottom: 0;">
                <input type="radio" name="situacaoExame" value="liberados" @(ViewBag.SituacaoExame == "liberados" ? "checked" : "") onchange="this.form.submit()" /> Exames Liberados
            </label>
            <label style="font: normal 13px calibri, arial, sans-serif; margin-bottom: 0;">
                <input type="radio" name="situacaoExame" value="naoLiberados" @(ViewBag.SituacaoExame == "naoLiberados" ? "checked" : "") onchange="this.form.submit()" /> Exames Não Liberados
            </label>
            <label style="font: normal 13px calibri, arial, sans-serif; margin-bottom: 0;">
                <input type="radio" name="situacaoExame" value="pendentes" @(ViewBag.SituacaoExame == "pendentes" ? "checked" : "") onchange="this.form.submit()" /> Exames Pendentes de Resultado
            </label>
            <label style="font: normal 13px calibri, arial, sans-serif; margin-bottom: 0;">
                <input type="radio" name="situacaoExame" value="baixados" @(ViewBag.SituacaoExame == "baixados" ? "checked" : "") onchange="this.form.submit()" /> Exames Baixados
            </label>
        </div>

        <button type="submit" class="btn btn-success btn-sm" style="display: inline-block;">
            <i class="fa-sharp fa-solid fa-magnifying-glass"></i> Pesquisar
        </button>
        </form>
    </div>
</div>

<!-- Grid Header (ExamesRealizados) -->
<div class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-flask-vial"></i> Exames Realizados
    </div>
    <div class="card-secao-body">
        <div class="table-responsive">
            <table id="modeloTable" name="datatable" data-order='[]' class="display compact order-column stripe table-hover nowrap">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tabela</th>
                <th>Sigla Instituição</th>
                <th>Nome Instituição</th>
                <th>Sigla Posto</th>
                <th>Nome Posto</th>
                <th>Nome Paciente</th>
                <th>Data Nascimento</th>
                <th>Seq</th>
                <th>Data do Exame</th>
                <th>Status</th>
                <th>Opções</th>
            </tr>
        </thead>
        <tbody>
            @* Dados carregados via AJAX pelo DataTables (server-side processing). *@
        </tbody>
        <tfoot>
            <tr>
                <th>Id</th>
                <th>Tabela</th>
                <th>Sigla Instituição</th>
                <th>Nome Instituição</th>
                <th>Sigla Posto</th>
                <th>Nome Posto</th>
                <th>Nome Paciente</th>
                <th>Data Nascimento</th>
                <th>Seq</th>
                <th>Data do Exame</th>
                <th>Status</th>
                <th id="op">Opções</th>
            </tr>
        </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#modeloTable tfoot th').each(function () {
                var title = $(this).text();
                if (title !== 'Opções') {
                    $(this).html('<input type="text" placeholder="' + title + '" style="max-width: 106px; padding-left: 4px; border: 1px solid gray; border-radius: 5px;" />');
                } else {
                    $(this).html('');
                }
            });

            var urlParams = new URLSearchParams(window.location.search);

            $('#modeloTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/ConsultarExames/Listar',
                    type: 'POST',
                    data: function (d) {
                        d.dataExameDe = urlParams.get('dataExameDe') || '';
                        d.dataExamePara = urlParams.get('dataExamePara') || '';
                        d.nomePaciente = urlParams.get('nomePaciente') || '';
                        d.codigoExame = urlParams.get('codigoExame') || '';
                        d.siglaInstituicao = urlParams.get('siglaInstituicao') || '';
                        d.nomeInstituicao = urlParams.get('nomeInstituicao') || '';
                        d.siglaPosto = urlParams.get('siglaPosto') || '';
                        d.nomePosto = urlParams.get('nomePosto') || '';
                        d.situacaoExame = urlParams.get('situacaoExame') || 'todos';
                    }
                },
                pageLength: 10,
                order: [[9, 'desc']],
                columns: [
                    { data: 'id', name: 'id' },
                    { data: 'siglaTabela', name: 'siglaTabela', orderable: false },
                    { data: 'siglaInstituicao', name: 'siglaInstituicao', orderable: false },
                    {
                        data: 'nomeInstituicao',
                        name: 'nomeInstituicao',
                        orderable: false,
                        render: function (data, type, row) {
                            if (!data) return '';
                            return data.length > 25 ? data.substring(0, 25) + '...' : data;
                        }
                    },
                    { data: 'siglaPosto', name: 'siglaPosto', orderable: false },
                    {
                        data: 'nomePosto',
                        name: 'nomePosto',
                        orderable: false,
                        render: function (data, type, row) {
                            if (!data) return '';
                            return data.length > 25 ? data.substring(0, 25) + '...' : data;
                        }
                    },
                    { data: 'nomePaciente', name: 'nomePaciente', orderable: false },
                    { data: 'nascimento', name: 'nascimento', orderable: false },
                    { data: 'sequencial', name: 'sequencial', orderable: false },
                    { data: 'dataIni', name: 'dataIni' },
                    {
                        data: 'statusTexto',
                        name: 'statusTexto',
                        orderable: false,
                        render: function (data, type, row) {
                            return '<span style="color:' + row.statusCor + '; font-weight:bold;">' + data + '</span>';
                        }
                    },
                    { data: 'acoes', name: 'acoes', orderable: false, searchable: false }
                ],
                autoWidth: true,
                responsive: true,
                fixedColumns: {
                    left: -1,
                    right: 1
                },
                fixedHeader: {
                    header: true,
                    footer: true
                },
                layout: {
                    topStart: {
                        pageLength: {
                            menu: [[10, 25, 50, 100, 250, 500, -1], [10, 25, 50, 100, 250, 500, "Todos"]]
                        }
                    },
                    topEnd: {
                        search: {
                            placeholder: 'Digite aqui sua busca'
                        }
                    },
                    bottomStart: 'info',
                    bottomEnd: {
                        paging: {
                            numbers: 5
                        }
                    }
                },
                language: {
                    search: "Busca:",
                    lengthMenu: "Mostrar _MENU_ resultados por página",
                    emptyTable: "<b style='color: red;'>Não haviam dados disponíveis para esta consulta</b>",
                    info: "Exibindo: _START_/_END_ de _TOTAL_ registros",
                    infoFiltered: "(Total de _MAX_ registros existentes na base de dados)",
                    infoThousands: ".",
                    thousands: ".",
                    decimal: ",",
                    loadingRecords: "Carregando...",
                    zeroRecords: "<b style='color: red;'>A consulta não retornou dados para o Grid</b>",
                    paginate: {
                        next: "<img src='images/icones/arrow_right_uno.png' width='28%' border='none' />",
                        previous: "<img src='images/icones/arrow_left_uno.png' width='28%' border='none' />",
                        first: "<img src='images/icones/arrow_left.png' width='28%' border='none' />",
                        last: "<img src='images/icones/arrow_right.png' width='28%' border='none' />"
                    }
                },
                initComplete: function () {
                    this.api().columns().every(function () {
                        var that = this;
                        $('input', this.footer()).on('keyup change clear', function () {
                            if (that.search() !== this.value) {
                                that.search(this.value).draw();
                            }
                        });
                    });
                }
            });

            $("input[type='search']")[0].focus();
        });
    </script>
}
@*..Kiro*@
<style>
    tr.detail-row {
        background-color: #f0f8f0 !important;
        font-size: 13px;
        pointer-events: none;
    }
    tr.detail-row td {
        padding: 4px 8px !important;
        border-top: none !important;
        color: #555;
    }
    tr.detail-header-row {
        background-color: #d4edda !important;
        font-size: 13px;
        font-weight: bold;
        pointer-events: none;
    }
    tr.detail-header-row td {
        padding: 5px 8px !important;
        color: #333;
    }
    tr.detail-parent-highlight {
        background-color: #fff3cd !important;
    }
    tr.detail-parent-highlight td {
        background-color: #fff3cd !important;
    }
    /* Moldura preta ao redor do registro selecionado (somente o retangulo externo) */
    /* #modeloTable aumenta especificidade para vencer CSS do DataTables */
    #modeloTable tr.group-border-top td:not(:last-child) {
        border-top: 2px solid #000 !important;
    }
    #modeloTable tr.group-border-top td:first-child {
        border-left: 2px solid #000 !important;
    }
    #modeloTable tr.group-border-top td:nth-last-child(2) {
        border-right: 2px solid #000 !important;
    }
    #modeloTable tr.group-border-side td:first-child {
        border-left: 2px solid #000 !important;
    }
    #modeloTable tr.group-border-side td:last-child {
        border-right: 2px solid #000 !important;
    }
    #modeloTable tr.group-border-bottom td {
        border-bottom: 2px solid #000 !important;
    }
    #modeloTable tr.group-border-bottom td:first-child {
        border-left: 2px solid #000 !important;
    }
    #modeloTable tr.group-border-bottom td:last-child {
        border-right: 2px solid #000 !important;
    }
</style>
<script>
    //Feito pelo Kiro em 17/05/2026
    function clickDeleteExame(x) {
        return clickConfirm(x, null, "Excluir este exame?", null, "ConsultarExames/ExcluirExame");
    }

    // Máscara de data no campo de filtro
    $(document).ready(function () {
        $("input[name='dataExameDe'], input[name='dataExamePara']").mask("99/99/9999", { placeholder: " ", autoclear: false });
    });

    // Master/Detail inline — click na linha do grid header
    $(document).ready(function () {
        $('#modeloTable tbody').on('click', 'tr', function (e) {
            // Ignora cliques na coluna de opções e nas linhas de detalhe
            if ($(e.target).closest('.grid_fundo_opcoes').length) return;
            if ($(this).hasClass('detail-row') || $(this).hasClass('detail-header-row')) return;

            var $row = $(this);
            var id = $row.find('td:first').text();
            if (!id) return;

            // Se clicar na mesma linha já expandida, fecha o detalhe
            if ($row.hasClass('detail-parent-highlight')) {
                $('#modeloTable tbody tr.detail-row, #modeloTable tbody tr.detail-header-row').remove();
                $row.removeClass('detail-parent-highlight group-border-top');
                return;
            }

            // Remove detalhe anterior (se existir)
            $('#modeloTable tbody tr.detail-row, #modeloTable tbody tr.detail-header-row').remove();
            $('#modeloTable tbody tr.detail-parent-highlight').removeClass('detail-parent-highlight group-border-top');

            // Destaca a linha header clicada
            $row.addClass('detail-parent-highlight');

            carregarDetailInline($row, id);
        });
    });

    function carregarDetailInline($headerRow, exameRealizadoId) {
        $.ajax({
            url: 'ConsultarExames/ObterItensExame',
            data: { exameRealizadoId: exameRealizadoId },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (data.sucesso && data.itens && data.itens.length > 0) {
                    renderizarDetailInline($headerRow, data.itens, exameRealizadoId);
                }
            }
        });
    }

    function clickExcluirItemExame(itemId, exameRealizadoId) {
        Swal.fire({
            title: 'Cancelar item de exame?',
            html: 'Este item será excluído permanentemente.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Sim, excluir',
            cancelButtonText: 'Não'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: 'ConsultarExames/ExcluirItemExame',
                    data: { itemId: itemId },
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        if (data.sucesso) {
                            // Remove linhas de detalhe e recarrega
                            $('#modeloTable tbody tr.detail-row, #modeloTable tbody tr.detail-header-row').remove();
                            var $parentRow = $('#modeloTable tbody tr.detail-parent-highlight');
                            if ($parentRow.length) {
                                carregarDetailInline($parentRow, exameRealizadoId);
                            }
                        } else {
                            clickAviso(data.titulo, data.mensagem, 'critica', null);
                        }
                    }
                });
            }
        });
    }

    function renderizarDetailInline($headerRow, itens, exameRealizadoId) {
        // 9 colunas de detalhe: Folha, Principal, ContaExame, Descrição, ValorItem, Etiquetas, Lab.Apoio, Controle Apoio, Ação
        // O grid header tem 12 colunas; o detalhe preenche todas (colspan na descrição e no fechamento).

        // Aplica moldura preta na linha principal (topo do grupo)
        $headerRow.addClass('group-border-top');

        // Linha de cabeçalho do detalhe
        var headerHtml = '<tr class="detail-header-row group-border-side">' +
            '<td>Folha</td>' +
            '<td>Principal</td>' +
            '<td style="white-space:nowrap;">Conta Exame</td>' +
            '<td colspan="3">Descrição do Item</td>' +
            '<td style="white-space:nowrap; text-align:right;">Valor Item</td>' +
            '<td>Etiquetas</td>' +
            //Feito pelo Qoder em 15/08/2026 — Laboratório de Apoio visível apenas no detalhe
            '<td>Lab. Apoio</td>' +
            '<td>Controle Apoio</td>' +
            //..Qoder
            '<td style="text-align:center;">Ação</td>' +
            '<td colspan="1"></td>' +
            '</tr>';
        $headerRow.after(headerHtml);

        // Linhas de detalhe
        var $lastInserted = $headerRow.next();
        itens.forEach(function (item) {
            var rowHtml = '<tr class="detail-row group-border-side">' +
                '<td>' + (item.classeExamesNome || '-') + '</td>' +
                '<td>' + (item.refItem || '-') + '</td>' +
                '<td style="white-space:nowrap;">' + (item.contaExame || '-') + '</td>' +
                '<td colspan="3">' + (item.descricao || '-') + '</td>' +
                '<td style="text-align:right;">' + (item.valorItem || '-') + '</td>' +
                '<td>' + (item.etiquetas || 0) + '</td>' +
                '<td>' + (item.laboratorioApoio || '-') + '</td>' +
                '<td style="white-space:nowrap;">' + (item.controleApoio || '-') + '</td>' +
                '<td style="pointer-events:auto; text-align:center;">' +
                '<a class="grid_itens" style="cursor:pointer; color:#dc3545;" title="Cancelar item" onclick="clickExcluirItemExame(' + item.id + ', ' + exameRealizadoId + ')"><i class="fa-solid fa-trash-can"></i></a>' +
                '</td>' +
                '<td colspan="1"></td>' +
                '</tr>';
            $lastInserted.after(rowHtml);
            $lastInserted = $lastInserted.next();
        });

        // Linha de total após o último item de detalhe
        var total = 0;
        itens.forEach(function (item) {
            var val = item.valorItem ? item.valorItem.replace('.', '').replace(',', '.') : '0';
            var num = parseFloat(val);
            if (!isNaN(num)) total += num;
        });
        var totalFormatado = total.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        var totalHtml = '<tr class="detail-row group-border-bottom" style="font-weight:bold;">' +
            '<td colspan="7"></td>' +
            '<td style="text-align:right; pointer-events:none;">Total: R$ ' + totalFormatado + '</td>' +
            '<td colspan="4"></td>' +
            '</tr>';
        $lastInserted.after(totalHtml);
    }
    //..Kiro
</script>
