@model LabWebMvc.MVC.ViewModel.CargaDados.SelecaoTabelasViewModel

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-secao">
                <div class="card-header">
                    <h4><i class="fa-solid fa-list-check"></i> Seleção de Tabelas para Importação</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Tabelas", "CargaDados", FormMethod.Post, new { @id = "form-tabelas" }))
                    {
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="alert alert-info">
                            <strong>Ordem de importação:</strong> as tabelas serão importadas na ordem abaixo para respeitar as dependências entre elas.
                        </div>

                        <div class="mb-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="marcarTodas(true)">
                                <i class="fa-solid fa-check-square"></i> Marcar todas
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="marcarTodas(false)">
                                <i class="fa-solid fa-square"></i> Desmarcar todas
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">Importar</th>
                                        <th>Ordem</th>
                                        <th>Tabela Firebird</th>
                                        <th>Tabela PostgreSQL</th>
                                        <th>Descrição</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Tabelas.Count; i++)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                @Html.CheckBoxFor(m => m.Tabelas[i].Selecionada, new { @class = "form-check-input tabela-check" })
                                                @Html.HiddenFor(m => m.Tabelas[i].NomeFirebird)
                                                @Html.HiddenFor(m => m.Tabelas[i].NomePostgreSQL)
                                                @Html.HiddenFor(m => m.Tabelas[i].Descricao)
                                                @Html.HiddenFor(m => m.Tabelas[i].Ordem)
                                            </td>
                                            <td>@Model.Tabelas[i].Ordem</td>
                                            <td>@Model.Tabelas[i].NomeFirebird</td>
                                            <td>@Model.Tabelas[i].NomePostgreSQL</td>
                                            <td>@Model.Tabelas[i].Descricao</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-calculator"></i> Gerar Estimativa
                                </button>
                                <a href="@Url.Action("Conexao", "CargaDados")" class="btn btn-secondary">
                                    <i class="fa-solid fa-arrow-left"></i> Voltar
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function marcarTodas(selecionar) {
        document.querySelectorAll('.tabela-check').forEach(function (cb) {
            cb.checked = selecionar;
        });
    }
</script>
