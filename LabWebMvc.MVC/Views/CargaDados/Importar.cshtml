@{
    ViewBag.TextoMenu = "Carga de Dados : Importação";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card-secao">
                <div class="card-header">
                    <h4><i class="fa-solid fa-rotate"></i> Importação Firebird → PostgreSQL</h4>
                </div>
                <div class="card-body">
                    <div id="area-controles" class="mb-4">
                        <button id="btn-iniciar" class="btn btn-success" onclick="iniciarImportacao()">
                            <i class="fa-solid fa-play"></i> Iniciar Importação
                        </button>
                        <button id="btn-cancelar" class="btn btn-danger" style="display:none;" onclick="cancelarImportacao()">
                            <i class="fa-solid fa-stop"></i> Cancelar Tudo
                        </button>
                    </div>

                    <div id="area-progresso" style="display:none;">
                        <div class="mb-2">
                            <strong>Tabela atual:</strong> <span id="tabela-atual">-</span>
                            <span class="ms-3"><strong>Status:</strong> <span id="status-texto">Inicializando...</span></span>
                        </div>

                        <div class="progress" style="height: 30px;">
                            <div id="barra-progresso" class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar" style="width: 0%;">
                                0%
                            </div>
                        </div>

                        <div class="mt-2 text-muted">
                            <span id="registros-texto">0 / 0 registros</span>
                        </div>
                    </div>

                    <div id="area-decisao" class="alert alert-warning mt-3" style="display:none;">
                        <h5><i class="fa-solid fa-triangle-exclamation"></i> Erro na importação</h5>
                        <p id="decisao-mensagem"></p>
                        <button class="btn btn-warning" onclick="definirDecisao(true)">
                            <i class="fa-solid fa-forward"></i> Ignorar e Prosseguir
                        </button>
                        <button class="btn btn-danger" onclick="definirDecisao(false)">
                            <i class="fa-solid fa-ban"></i> Cancelar Tudo
                        </button>
                    </div>

                    <div id="area-resultado" class="mt-3" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/cargadados.js"></script>
}
