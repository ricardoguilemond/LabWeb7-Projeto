@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BLL
@using static BLL.UtilBLL

@*Feito pelo Kiro em 14/07/2025*@
<link href="~/lib/quill/quill.snow.css" rel="stylesheet">

<div style="max-width: 900px; margin: 20px 0; padding: 20px;">
    <h4 style="color: #333; margin-bottom: 16px;">
        <i class="fa-solid fa-file-lines"></i> Referência de Laudo
    </h4>

    <div style="background-color: #f8fff8; border: 1px solid #69c38a; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
        <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-bottom: 12px;">
            <div>
                <label style="font-size: 13px; font-weight: bold;">Conta Exame:</label><br />
                <input type="text" id="txtContaExame" maxlength="11" placeholder="11000000000"
                       value="@(ViewBag.Editando ? ViewBag.Registro.ContaExame : "")"
                       @(ViewBag.Editando ? "readonly" : "")
                       style="width: 140px; padding: 4px 8px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px;
                              @(ViewBag.Editando ? "background-color: #eee;" : "")" />
            </div>
            <div>
                <label style="font-size: 13px; font-weight: bold;">Descrição:</label><br />
                <input type="text" id="txtDescricaoExame"
                       value="@(ViewBag.DescricaoExame)"
                       readonly
                       style="width: 320px; padding: 4px 8px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px; background-color: #eee;" />
            </div>
            <div>
                <label style="font-size: 13px; font-weight: bold;">Tabela:</label><br />
                <select id="cmbTabela" style="width: 200px; padding: 4px 8px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px; height: 28px;">
                    @foreach (var tab in (IEnumerable<dynamic>)ViewBag.Tabelas)
                    {
                        if (ViewBag.Editando && ViewBag.Registro.TabelaExamesId == tab.Id)
                        {
                            @Html.Raw("<option value='" + tab.Id + "' selected>" + tab.NomeTabela + "</option>")
                        }
                        else
                        {
                            @Html.Raw("<option value='" + tab.Id + "'>" + tab.NomeTabela + "</option>")
                        }
                    }
                </select>
            </div>
            <div>
                <label style="font-size: 13px; font-weight: bold;">Alinhamento:</label><br />
                <select id="cmbAlinhamento" style="width: 140px; padding: 4px 8px; border: 1px solid #69c38a; border-radius: 6px; font-size: 13px; height: 28px;">
                    @if (ViewBag.Editando && ViewBag.Registro.AlinhaLaudo == 1)
                    {
                        @Html.Raw("<option value='0'>Esquerda</option>")
                        @Html.Raw("<option value='1' selected>Direita</option>")
                    }
                    else
                    {
                        @Html.Raw("<option value='0' selected>Esquerda</option>")
                        @Html.Raw("<option value='1'>Direita</option>")
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Abas -->
    <div style="margin-bottom: 20px;">
        <div style="display: flex; gap: 0;">
            <button type="button" id="tabEditor" class="tab-btn tab-ativa" onclick="trocarAba('editor')">
                <i class="fa-solid fa-pen-to-square"></i> Editor
            </button>
            <button type="button" id="tabUpload" class="tab-btn" onclick="trocarAba('upload')">
                <i class="fa-solid fa-file-arrow-up"></i> Upload Word
            </button>
        </div>

        <!-- Aba Editor -->
        <div id="abaEditor" style="border: 1px solid #ddd; border-top: none; border-radius: 0 0 8px 8px; padding: 16px;">
            <div id="editorQuill" style="height: 300px;">@Html.Raw(ViewBag.ConteudoHtml ?? "")</div>
        </div>

        <!-- Aba Upload -->
        <div id="abaUpload" style="border: 1px solid #ddd; border-top: none; border-radius: 0 0 8px 8px; padding: 16px; display: none;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <input type="file" id="inputArquivo" accept=".doc,.docx,.rtf" style="font-size: 13px;" />
                <button type="button" id="btnEnviarArquivo" class="btn btn-info btn-sm" style="font-size: 13px;">
                    <i class="fa-solid fa-upload"></i> Enviar
                </button>
            </div>
            <p style="font-size: 12px; color: #666; margin-top: 8px;">Formatos aceitos: .DOC, .DOCX, .RTF</p>
        </div>
    </div>

    <!-- Botão Voltar + Salvar (aba Editor) -->
    <div style="text-align: center; margin: 15px 0;">
        <button type="button" id="btnVoltar" class="btn btn-secondary btn-sm" style="font-size: 13px; margin-right: 8px;">
            <i class="fa-solid fa-arrow-left"></i> Voltar
        </button>
        <button type="button" id="btnSalvar" class="btn btn-success btn-sm" style="font-size: 13px;">
            <i class="fa-solid fa-floppy-disk"></i> Salvar
        </button>
    </div>

    <p style="font-size: 12px; color: #888; margin-top: 10px;">
        <i class="fa-solid fa-circle-info"></i> Para que a alteração reflita na impressão de laudos, efetue login novamente.
    </p>
</div>

<input type="hidden" id="hiddenId" value="@(ViewBag.Editando ? ViewBag.Registro.Id : 0)" />
@*..Kiro*@

<style>
    /*Feito pelo Kiro em 14/07/2025*/
    .tab-btn {
        padding: 8px 16px;
        font-size: 13px;
        border: 1px solid #ddd;
        border-bottom: none;
        background-color: #f5f5f5;
        cursor: pointer;
        border-radius: 6px 6px 0 0;
        color: #555;
    }
    .tab-btn.tab-ativa {
        background-color: #fff;
        border-bottom: 1px solid #fff;
        color: #333;
        font-weight: bold;
    }
    #editorQuill .ql-editor {
        font-size: 13px;
        min-height: 250px;
    }
    /*..Kiro*/
</style>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    //Feito pelo Kiro em 14/07/2025
    initBtnVoltar();
    var quill = new Quill('#editorQuill', {
        theme: 'snow',
        modules: {
            toolbar: [
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'header': [1, 2, 3, false] }],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                [{ 'align': [] }],
                ['clean']
            ]
        }
    });

    function trocarAba(aba) {
        if (aba === 'editor') {
            document.getElementById('abaEditor').style.display = 'block';
            document.getElementById('abaUpload').style.display = 'none';
            document.getElementById('tabEditor').classList.add('tab-ativa');
            document.getElementById('tabUpload').classList.remove('tab-ativa');
            document.getElementById('btnSalvar').style.display = '';
        } else {
            document.getElementById('abaEditor').style.display = 'none';
            document.getElementById('abaUpload').style.display = 'block';
            document.getElementById('tabEditor').classList.remove('tab-ativa');
            document.getElementById('tabUpload').classList.add('tab-ativa');
            document.getElementById('btnSalvar').style.display = 'none';
        }
    }

    // Salvar (aba Editor)
    $(document).off('click.salvarRef').on('click.salvarRef', '#btnSalvar', function () {
        var id = parseInt($("#hiddenId").val()) || 0;
        var contaExame = $("#txtContaExame").val().trim();
        var tabelaExamesId = parseInt($("#cmbTabela").val());
        var alinhaLaudo = parseInt($("#cmbAlinhamento").val());
        var conteudoHtml = quill.root.innerHTML;

        if (!contaExame) {
            clickAviso('Atenção', 'Informe a Conta Exame.', 'aviso', null);
            return;
        }

        $("#btnSalvar").prop('disabled', true).text('Salvando...');
        $.ajax({
            url: '/ExameReferencia/Salvar',
            type: 'POST',
            timeout: 30000,
            contentType: 'application/json',
            data: JSON.stringify({
                id: id,
                contaExame: contaExame,
                tabelaExamesId: tabelaExamesId,
                conteudoHtml: conteudoHtml,
                alinhaLaudo: alinhaLaudo
            }),
            dataType: 'json',
            success: function (data) {
                $("#btnSalvar").prop('disabled', false).html('<i class="fa-solid fa-floppy-disk"></i> Salvar');
                if (data.sucesso) {
                    clickAviso('Sucesso', data.mensagem, 'sucesso', '/ExameReferencia');
                } else {
                    clickAviso('Erro', data.mensagem, 'critica', null);
                }
            },
            error: function (xhr, status, error) {
                $("#btnSalvar").prop('disabled', false).html('<i class="fa-solid fa-floppy-disk"></i> Salvar');
                clickAviso('Erro', 'Falha na comunicação: ' + (xhr.status || '') + ' ' + (error || status || ''), 'critica', null);
            }
        });
    });

    // Upload (aba Upload)
    $(document).off('click.uploadRef').on('click.uploadRef', '#btnEnviarArquivo', function () {
        var arquivo = document.getElementById('inputArquivo').files[0];
        if (!arquivo) {
            clickAviso('Atenção', 'Selecione um arquivo.', 'aviso', null);
            return;
        }

        var id = parseInt($("#hiddenId").val()) || 0;
        var contaExame = $("#txtContaExame").val().trim();
        var tabelaExamesId = parseInt($("#cmbTabela").val());

        if (!contaExame) {
            clickAviso('Atenção', 'Informe a Conta Exame.', 'aviso', null);
            return;
        }

        var formData = new FormData();
        formData.append('id', id);
        formData.append('contaExame', contaExame);
        formData.append('tabelaExamesId', tabelaExamesId);
        formData.append('arquivo', arquivo);

        $("#btnEnviarArquivo").prop('disabled', true).text('Enviando...');
        $.ajax({
            url: '/ExameReferencia/Upload',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'json',
            success: function (data) {
                $("#btnEnviarArquivo").prop('disabled', false).html('<i class="fa-solid fa-upload"></i> Enviar');
                if (data.sucesso) {
                    clickAviso('Sucesso', data.mensagem, 'sucesso', '/ExameReferencia');
                } else {
                    clickAviso('Erro', data.mensagem, 'critica', null);
                }
            },
            error: function () {
                $("#btnEnviarArquivo").prop('disabled', false).html('<i class="fa-solid fa-upload"></i> Enviar');
                clickAviso('Erro', 'Falha na comunicação com o servidor.', 'critica', null);
            }
        });
    });
    //..Kiro
</script>
