@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using LabWebMvc.MVC.Areas.Utils
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@model vmSenhas
@{
    Layout = "_Layout";
}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        initBtnVoltar();
        document.getElementById('clickSubmit').addEventListener('click', function (event) {
            event.preventDefault();
            const form = document.getElementById('form');
            const formData = new FormData(form);
            const params = new URLSearchParams(formData);
            fetch('', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            })
            .then(r => r.json())
            .then(function (data) {
                var titulo = data['titulo'] || 'Atenção';
                var mensagem = data['mensagem'];
                var actionPos = data['action'];
                var tipo = data['sucesso'] ? 'sucesso' : 'falha';
                clickAviso(titulo, mensagem, tipo, actionPos);
            })
            .catch(function () {
                clickAviso('Interrompido', 'Falha na execução', 'critica', null);
            });
            form.reset();
        });
    });
</script>
@using (Html.BeginForm(FormMethod.Post, new { @class = "form-horizontal", @id = "form", @enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="lab-form-container lab-form-narrow lab-refined">

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-user-plus"></i> Dados do Usuário
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-sm">
                        <label>*Nome de Usuário (ate 15 caracteres)</label>
                        @Html.TextBoxFor(p => p.NomeUsuario, new { @class = "form-control", @maxlength = "15", @required = "required" })
                    </div>
                    <div class="field-group w-xl">
                        <label>*Nome Completo</label>
                        @Html.TextBoxFor(p => p.NomeCompleto, new { @class = "form-control", @maxlength = "100", @required = "required" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-sm">
                        <label>*Data de Nascimento</label>
                        @Html.TextBoxFor(p => p.DataNascimento, new { @class = "form-control", @placeholder = "dd/MM/yyyy", @required = "required", @type = "date" })
                    </div>
                    <div class="field-group w-md">
                        <label>*CPF</label>
                        @Html.TextBoxFor(p => p.CPF, new { @class = "form-control", @maxlength = "11", @required = "required" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-lg">
                        <label>*E-mail/login</label>
                        @Html.TextBoxFor(p => p.Email, new { @class = "form-control", @type = "email", @maxlength = "500", @required = "required" })
                    </div>
                    <div class="field-group w-sm">
                        <label>Data de Expiração da Senha</label>
                        @Html.TextBoxFor(p => p.DataExpira, new { @class = "form-control", @type = "date" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-signature"></i> Assinatura e Permissões
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-full">
                        <label>Assinatura/Carimbo (somente se o usuário for profissional credenciado para assinar Laudos)</label>
                        @Html.TextBoxFor(p => p.Assinatura, new { @type = "file", @id = "fileAssinatura", @name = "fileAssinatura", @value = Model.PathImages, @accept = "image/png, image/jpeg" })
                        @Html.Raw("<div id='imgsAssinatura'></div>")
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>*Usa assinatura nos laudos? S/N</label>
                        <div class="radio-group">
                            @for (int i = 0; i < Utils.ListaSN().Count; i++)
                            {
                                int assIndex = Utils.RetornaItem(i, "ListaSN", 0).ToInt32();
                                string assSigla = Utils.RetornaItem(i, "ListaSN", 1);
                                string assDescricao = Utils.RetornaItem(i, "ListaSN", 2);
                                bool check = (assIndex == 0);
                                <span>
                                    @Html.RadioButton("UsarAssinatura", assIndex, check)
                                    <label>@assDescricao</label>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="field-group w-md">
                        <label>*Usuário será administrador do sistema? S/N</label>
                        <div class="radio-group">
                            @for (int i = 0; i < Utils.ListaSN().Count; i++)
                            {
                                int admIndex = Utils.RetornaItem(i, "ListaSN", 0).ToInt32();
                                string admSigla = Utils.RetornaItem(i, "ListaSN", 1);
                                string admDescricao = Utils.RetornaItem(i, "ListaSN", 2);
                                bool check = (admIndex == 0);
                                <span>
                                    @Html.RadioButton("Administrador", admIndex, check)
                                    <label>@admDescricao</label>
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-full">
                        <div class="field-hint">
                            A senha será gerada pelo Sistema e enviada para o Email cadastrado aqui.<br />
                            As permissões deste usuário no Sistema devem ser feitas pela opção do menu "Perfil e Permissões"
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group" style="margin-top: 16px;">
            <button type="button" id="btnVoltar" class="btn btn-lg btn-secondary lab-btn" style="margin-right: 10px;">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </button>
            <button id="clickSubmit" type="submit" class="btn btn-lg btn-success botao-verde lab-btn">
                Salvar
            </button>
        </div>

    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('fileAssinatura').addEventListener('change', function (e) {
            var files = e.target.files;
            var fileName = files[0].name;
            var objURL = URL.createObjectURL(e.target.files[0]);
            var path = e.target.value;
            if (files.length > 0) {
                if (window.FormData !== undefined) {
                    var data = new FormData();
                    data.append("myFile", files[0]);
                    data.append("myPath", path);
                    document.getElementById('nomeAssinatura').value = fileName;
                    document.getElementById('caminhoAssinatura').value = path;
                    const imgBox = document.getElementById('imgsAssinatura');
                    imgBox.innerHTML = "<img src='" + objURL + "' style='width:235px; height:215px;' />";
                    imgBox.style.display = '';
                }
            }
        });
    </script>
}
