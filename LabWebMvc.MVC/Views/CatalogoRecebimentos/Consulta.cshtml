@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using LabWebMvc.MVC.ViewModel
@model vmCatalogoRecebimentoConsulta

<div class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-magnifying-glass"></i> Consulta do Catálogo de Recebimentos
    </div>
    <div class="card-secao-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label for="txtDataIni" class="form-label">Data Inicial</label>
                @* Feito pelo Qoder em 16/08/2026: default = data de hoje *@
                <input type="date" id="txtDataIni" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label for="txtDataFim" class="form-label">Data Final</label>
                @* Feito pelo Qoder em 16/08/2026: default = data de hoje *@
                <input type="date" id="txtDataFim" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label for="selInstituicao" class="form-label">Instituição</label>
                <select id="selInstituicao" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var inst in Model.Instituicoes)
                    {
                        <option value="@inst.Value">@inst.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="selForma" class="form-label">Forma</label>
                <select id="selForma" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var f in Model.FormasRecebimento)
                    {
                        <option value="@f.Value">@f.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="selConta" class="form-label">Conta</label>
                <select id="selConta" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var c in Model.ContasRecebimento)
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="button" id="btnBuscar" class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-search"></i>
                </button>
            </div>
        </div>
        @*Feito pelo Qoder em 16/08/2026 — recebimento consolidado por instituição/período*@
        <div class="row mt-2">
            <div class="col-12 text-end">
                <button type="button" id="btnAbrirReceberConsolidado" class="btn btn-success btn-sm">
                    <i class="fa-solid fa-building-columns"></i> Receber por Instituição/Período
                </button>
            </div>
        </div>
        @*..Qoder*@
    </div>
</div>

<div class="card-secao">
    <div class="card-secao-body">
        <div class="table-responsive">
            <table id="catalogosTable" class="display compact order-column stripe table-hover nowrap" style="width:100%">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Data</th>
                        <th>Instituição</th>
                        @* Feito pelo Qoder em 16/08/2026: coluna de tabela de preços (sigla e nome) *@
                        <th>Tabela de Preços</th>
                        <th>Paciente</th>
                        <th>Período</th>
                        <th>Valor Total</th>
                        <th>Origem</th>
                        <th>Status</th>
                        <th>Opções</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Detalhes -->
<div class="modal fade" id="modalDetalhes" tabindex="-1" aria-labelledby="modalDetalhesLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDetalhesLabel">Detalhes do Recebimento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-3"><label class="form-label">Id</label><input type="text" id="detId" class="form-control form-control-sm" readonly /></div>
                    <div class="col-md-3"><label class="form-label">Data</label><input type="text" id="detData" class="form-control form-control-sm" readonly /></div>
                    <div class="col-md-3"><label class="form-label">Origem</label><input type="text" id="detOrigem" class="form-control form-control-sm" readonly /></div>
                    <div class="col-md-3"><label class="form-label">Status</label><input type="text" id="detStatus" class="form-control form-control-sm" readonly /></div>
                    <div class="col-md-6"><label class="form-label">Instituição</label><input type="text" id="detInstituicao" class="form-control form-control-sm" readonly /></div>
                    <div class="col-md-6"><label class="form-label">Paciente</label><input type="text" id="detPaciente" class="form-control form-control-sm" readonly /></div>
                    <div class="col-md-4"><label class="form-label">Período</label><input type="text" id="detPeriodo" class="form-control form-control-sm" readonly /></div>
                    <div class="col-md-4"><label class="form-label">Valor Total</label><input type="text" id="detValor" class="form-control form-control-sm text-end" readonly /></div>
                    @*Feito pelo Qoder em 16/08/2026 — desconto/acréscimo do recebimento (negativo = desconto, positivo = acréscimo)*@
                    <div class="col-md-4"><label class="form-label">Desconto/Acréscimo</label><input type="text" id="detDesconto" class="form-control form-control-sm text-end" readonly /></div>
                    @*..Qoder*@
                    @*Feito pelo Qoder em 16/08/2026 — soma imutável dos exames (recebimento consolidado)*@
                    <div class="col-md-4"><label class="form-label">Valor Total Devido</label><input type="text" id="detValorDevido" class="form-control form-control-sm text-end" readonly /></div>
                    @*..Qoder*@
                    @*Feito pelo Qoder em 16/08/2026 — cobrança: Instituição ou Paciente*@
                    <div class="col-md-4"><label class="form-label">Cobrança</label><input type="text" id="detCobranca" class="form-control form-control-sm" readonly /></div>
                    @*..Qoder*@
                    <div class="col-md-4"><label class="form-label">Registrado por</label><input type="text" id="detUsuario" class="form-control form-control-sm" readonly /></div>
                </div>

                <ul class="nav nav-tabs" id="detTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-exames-tab" data-bs-toggle="tab" data-bs-target="#tab-exames" type="button">Exames</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-formas-tab" data-bs-toggle="tab" data-bs-target="#tab-formas" type="button">Formas</button>
                    </li>
                </ul>
                <div class="tab-content border border-top-0 p-3" id="detTabsContent">
                    <div class="tab-pane fade show active" id="tab-exames">
                        <table class="table table-sm table-striped">
                            <thead><tr><th>Código</th><th>Sequencial</th><th class="text-end">Valor</th></tr></thead>
                            <tbody id="detExamesBody"></tbody>
                        </table>
                    </div>
                    <div class="tab-pane fade" id="tab-formas">
                        <table class="table table-sm table-striped">
                            <thead><tr><th>Forma</th><th>Conta</th><th class="text-end">Valor</th><th>Data</th><th>Observação</th></tr></thead>
                            <tbody id="detFormasBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@*Feito pelo Qoder em 16/08/2026 — Modal de Baixa de Título Pendente (cobrança à instituição)*@
<div class="modal fade" id="modalReceberPendente" tabindex="-1" aria-labelledby="modalReceberPendenteLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalReceberPendenteLabel"><i class="fa-solid fa-hand-holding-dollar"></i> Receber Título Pendente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hddCatalogoPendenteId" />
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Paciente</label>
                        <input type="text" id="txtPacientePendente" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Valor a Receber</label>
                        <input type="text" id="txtValorPendente" class="form-control form-control-sm text-end fw-bold" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Período (MM/AAAA)</label>
                        <input type="text" id="txtPeriodoPendente" class="form-control form-control-sm" placeholder="MM/AAAA" maxlength="7" />
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-wallet"></i> Formas de Recebimento</span>
                        <button type="button" id="btnAdicionarFormaPendente" class="btn btn-sm btn-success"><i class="fa-solid fa-plus"></i> Adicionar</button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm" id="tblFormasPendente">
                                <thead>
                                    <tr>
                                        <th>Forma</th>
                                        <th>Conta</th>
                                        <th>Valor</th>
                                        <th>Data</th>
                                        <th>Observação</th>
                                        <th style="width:40px;"></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="2" class="text-end">Total Informado:</th>
                                        <th class="text-end" id="lblTotalFormasPendente">0,00</th>
                                        <th colspan="3"></th>
                                    </tr>
                                    <tr>
                                        <th colspan="2" class="text-end">Diferença:</th>
                                        <th class="text-end" id="lblDiferencaPendente">0,00</th>
                                        <th colspan="3"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarReceberPendente" class="btn btn-primary"><i class="fa-solid fa-save"></i> Confirmar Recebimento</button>
            </div>
        </div>
    </div>
</div>
@*..Qoder*@

@*Feito pelo Qoder em 16/08/2026 — Modal de Recebimento Consolidado por Instituição/Período*@
<div class="modal fade" id="modalReceberConsolidado" tabindex="-1" aria-labelledby="modalReceberConsolidadoLabel">
    <div class="modal-dialog modal-xl">
        <!--Feito pelo Qoder em 16/08/2026-->
        <!-- Loading local do modal: o overlay padrão do layout (z-index 99) fica atrás do backdrop do modal. -->
        <div id="loadingConsolidado" class="position-absolute top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center" style="z-index: 1060; background: rgba(255,255,255,0.65); border-radius: .5rem;">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status"></div>
                <div id="lblLoadingConsolidado" class="mt-2 fw-bold text-primary">Carregando...</div>
            </div>
        </div>
        <!--..Qoder-->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalReceberConsolidadoLabel"><i class="fa-solid fa-building-columns"></i> Receber por Instituição/Período</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label class="form-label">Instituição (Sigla)</label>
                        <select id="selInstituicaoConsolidado" class="form-select form-select-sm">
                            <option value="">Selecione</option>
                            @foreach (var inst in Model.Instituicoes)
                            {
                                <option value="@inst.Value">@inst.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Data Inicial</label>
                        <input type="date" id="txtDataIniConsolidado" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Data Final</label>
                        <input type="date" id="txtDataFimConsolidado" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button" id="btnCarregarExamesConsolidado" class="btn btn-primary btn-sm w-100"><i class="fa-solid fa-search"></i> Carregar Exames</button>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-flask"></i> Exames do Período</span>
                        <span id="lblQuantidadeConsolidado" class="badge bg-secondary">0 exames</span>
                    </div>
                    <div class="card-body p-2" style="max-height: 220px; overflow-y: auto;">
                        <table class="table table-sm table-striped mb-0">
                            <thead><tr><th>Sequencial</th><th>Paciente</th><th>Data</th><th>Situação</th><th class="text-end">Valor</th></tr></thead>
                            <tbody id="tblPreviewConsolidadoBody"></tbody>
                        </table>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Valor Total Devido</label>
                        <input type="text" id="txtValorDevidoConsolidado" class="form-control form-control-sm text-end fw-bold" readonly value="0,00" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Desconto/Acréscimo (- desconto / + acréscimo)</label>
                        <input type="text" id="txtAjusteConsolidado" class="form-control form-control-sm text-end" inputmode="decimal" placeholder="0,00" disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Valor Total a ser Pago</label>
                        <input type="text" id="txtValorAPagarConsolidado" class="form-control form-control-sm text-end fw-bold" readonly value="0,00" />
                    </div>
                    <div class="col-12">
                        <div class="border rounded p-2 bg-light">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkDeclaracaoConsolidado" disabled />
                                <label class="form-check-label" for="chkDeclaracaoConsolidado">
                                    Declaro que confere o recebimento pelo total dos exames no período, e que qualquer desconto ou acréscimo não impacta os valores reais devidos e somados dos exames realizados
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Observação (opcional)</label>
                        <textarea id="txtObservacaoConsolidado" class="form-control form-control-sm" rows="2" maxlength="2000"></textarea>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-wallet"></i> Formas de Recebimento</span>
                        <button type="button" id="btnAdicionarFormaConsolidado" class="btn btn-sm btn-success"><i class="fa-solid fa-plus"></i> Adicionar</button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm" id="tblFormasConsolidado">
                                <thead>
                                    <tr>
                                        <th>Forma</th>
                                        <th>Conta</th>
                                        <th>Valor</th>
                                        <th>Data</th>
                                        <th>Observação</th>
                                        <th style="width:40px;"></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="2" class="text-end">Total Informado:</th>
                                        <th class="text-end" id="lblTotalFormasConsolidado">0,00</th>
                                        <th colspan="3"></th>
                                    </tr>
                                    <tr>
                                        <th colspan="2" class="text-end">Diferença:</th>
                                        <th class="text-end" id="lblDiferencaConsolidado">0,00</th>
                                        <th colspan="3"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <!--Feito pelo Qoder em 16/08/2026-->
                <!-- O botão só aparece com declaração marcada + forma(s) adicionada(s) somando o Valor Total a ser Pago. -->
                <button type="button" id="btnConfirmarReceberConsolidado" class="btn btn-primary d-none"><i class="fa-solid fa-save"></i> Confirmar Recebimento</button>
                <!--..Qoder-->
            </div>
        </div>
    </div>
</div>
@*..Qoder*@

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var table;

        $(document).ready(function () {
            table = $('#catalogosTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/CatalogoRecebimentos/ListarCatalogos',
                    type: 'POST',
                    data: function (d) {
                        d.dataIni = $('#txtDataIni').val();
                        d.dataFim = $('#txtDataFim').val();
                        d.instituicaoId = $('#selInstituicao').val();
                        d.formaRecebimentoId = $('#selForma').val();
                        d.contaRecebimentoId = $('#selConta').val();
                    }
                },
                pageLength: 10,
                order: [[0, 'desc']],
                columns: [
                    { data: 'id', name: 'id' },
                    { data: 'dataRecebimento', name: 'dataRecebimento' },
                    { data: 'instituicao', name: 'instituicao' },
                    //Feito pelo Qoder em 16/08/2026
                    { data: 'tabelaPreco', name: 'tabelaPreco', orderable: false },
                    //..Qoder
                    { data: 'paciente', name: 'paciente' },
                    { data: 'periodo', name: 'periodo', orderable: false },
                    { data: 'valorTotal', name: 'valorTotal', className: 'text-end' },
                    { data: 'origem', name: 'origem', orderable: false },
                    //Feito pelo Qoder em 23/08/2026 — título pendente destacado em vermelho
                    {
                        data: 'status', name: 'status', orderable: false,
                        render: function (data) {
                            return data === 'Pendente'
                                ? '<span style="color:red; font-weight:bold;">' + data + '</span>'
                                : data;
                        }
                    },
                    { data: 'acoes', name: 'acoes', orderable: false, searchable: false }
                ],
                language: {
                    url: '/lib/datatables/i18n/pt-BR.json'
                }
            });

            $('#btnBuscar').on('click', function () {
                table.ajax.reload();
            });

            $('#catalogosTable tbody').on('click', '.btn-detalhes', function () {
                var id = $(this).data('id');
                carregarDetalhes(id);
            });

            //Feito pelo Qoder em 16/08/2026 — baixa de título pendente (cobrança à instituição)
            $('#catalogosTable tbody').on('click', '.btn-receber-pendente', function () {
                abrirReceberPendente($(this).data('id'));
            });

            $('#btnAdicionarFormaPendente').on('click', function () {
                adicionarLinhaFormaPendente();
            });

            $('#tblFormasPendente tbody').on('click', '.btn-remover-forma-pendente', function () {
                $(this).closest('tr').remove();
                calcularTotaisFormasPendente();
            });

            $('#tblFormasPendente tbody').on('input', '.forma-valor-pendente', function () {
                calcularTotaisFormasPendente();
            });

            $('#tblFormasPendente tbody').on('focus', '.forma-valor-pendente', function () {
                $(this).val('');
            });

            $('#btnConfirmarReceberPendente').on('click', function () {
                salvarReceberPendente();
            });
            //..Qoder

            //Feito pelo Qoder em 16/08/2026 — recebimento consolidado por instituição/período
            $('#btnAbrirReceberConsolidado').on('click', function () {
                abrirReceberConsolidado();
            });

            $('#btnCarregarExamesConsolidado').on('click', function () {
                carregarExamesConsolidado();
            });

            $('#txtAjusteConsolidado').on('input', function () {
                calcularTotaisConsolidado();
            });

            $('#chkDeclaracaoConsolidado').on('change', function () {
                atualizarConfirmarConsolidado();
            });

            $('#btnAdicionarFormaConsolidado').on('click', function () {
                adicionarLinhaFormaConsolidado();
            });

            $('#tblFormasConsolidado tbody').on('click', '.btn-remover-forma-consolidado', function () {
                $(this).closest('tr').remove();
                calcularTotaisConsolidado();
            });

            $('#tblFormasConsolidado tbody').on('input', '.forma-valor-consolidado', function () {
                calcularTotaisConsolidado();
            });

            $('#btnConfirmarReceberConsolidado').on('click', function () {
                salvarReceberConsolidado();
            });
            //..Qoder
        });

        function carregarDetalhes(id) {
            $.get('/CatalogoRecebimentos/ObterDetalhes/' + id)
                .done(function (res) {
                    if (res.sucesso) {
                        $('#detId').val(res.catalogo.id);
                        $('#detData').val(res.catalogo.dataRecebimento);
                        $('#detOrigem').val(res.catalogo.origemDescricao);
                        $('#detStatus').val(res.catalogo.status);
                        $('#detInstituicao').val(res.catalogo.instituicao);
                        $('#detPaciente').val(res.catalogo.paciente);
                        $('#detPeriodo').val(res.catalogo.periodoFaturamento);
                        $('#detValor').val(res.catalogo.valorTotal.toFixed(2).replace('.', ','));
                        //Feito pelo Qoder em 16/08/2026
                        // Convenção do ajuste: negativo = desconto, positivo = acréscimo
                        // (o banco grava ValorDesconto positivo para desconto).
                        $('#detDesconto').val((-(res.catalogo.valorDesconto || 0)).toFixed(2).replace('.', ','));
                        $('#detValorDevido').val((res.catalogo.valorTotalDevido || 0).toFixed(2).replace('.', ','));
                        $('#detCobranca').val(res.catalogo.cobrancaInstituicao ? 'Instituição' : 'Paciente');
                        //..Qoder
                        $('#detUsuario').val(res.catalogo.usuarioRegistro);

                        var tbodyExames = $('#detExamesBody');
                        tbodyExames.empty();
                        res.exames.forEach(function (e) {
                            tbodyExames.append('<tr>' +
                                '<td>' + e.exameRealizadoId + '</td>' +
                                '<td>' + e.sequencial + '</td>' +
                                '<td class="text-end">' + e.valor.toFixed(2).replace('.', ',') + '</td>' +
                                '</tr>');
                        });

                        var tbodyFormas = $('#detFormasBody');
                        tbodyFormas.empty();
                        res.formas.forEach(function (f) {
                            tbodyFormas.append('<tr>' +
                                '<td>' + f.formaNome + '</td>' +
                                '<td>' + f.contaNome + '</td>' +
                                '<td class="text-end">' + f.valor.toFixed(2).replace('.', ',') + '</td>' +
                                '<td>' + f.dataRecebimento + '</td>' +
                                '<td>' + (f.observacao || '') + '</td>' +
                                '</tr>');
                        });

                        $('#modalDetalhes').modal('show');
                    } else {
                        alert(res.mensagem);
                    }
                })
                .fail(function () {
                    alert('Erro ao carregar detalhes.');
                });
        }

        //Feito pelo Qoder em 16/08/2026 — baixa de título pendente (cobrança à instituição)
        function parseValorPendente(texto) {
            texto = (texto || '').trim();
            if (!texto) return 0;
            if (texto.indexOf(',') >= 0) {
                return parseFloat(texto.replace(/\./g, '').replace(',', '.')) || 0;
            }
            return parseFloat(texto) || 0;
        }

        function opcoesSelectPendente(seletor) {
            var opts = '';
            $(seletor + ' option').each(function () {
                if ($(this).val() !== '') opts += '<option value="' + $(this).val() + '">' + $(this).text() + '</option>';
            });
            return opts;
        }

        function adicionarLinhaFormaPendente() {
            //Feito pelo Qoder em 16/08/2026 — selects iniciam em "Selecione" e valor vazio:
            // todos os campos da linha são obrigatórios e escolhidos pelo usuário.
            var linha = '<tr>' +
                '<td><select class="form-select form-select-sm forma-id-pendente"><option value="0">Selecione</option>' + opcoesSelectPendente('#selForma') + '</select></td>' +
                '<td><select class="form-select form-select-sm conta-id-pendente"><option value="0">Selecione</option>' + opcoesSelectPendente('#selConta') + '</select></td>' +
                '<td><input type="text" inputmode="decimal" class="form-control form-control-sm text-end forma-valor-pendente" value="" placeholder="0,00" /></td>' +
                '<td><input type="date" class="form-control form-control-sm forma-data-pendente" value="' + new Date().toISOString().split('T')[0] + '" /></td>' +
                '<td><input type="text" class="form-control form-control-sm forma-obs-pendente" maxlength="2000" /></td>' +
                '<td><button type="button" class="btn btn-sm btn-danger btn-remover-forma-pendente"><i class="fa-solid fa-trash"></i></button></td>' +
                '</tr>';
            //..Qoder
            $('#tblFormasPendente tbody').append(linha);
        }

        function valorPendenteAtual() {
            return parseValorPendente($('#txtValorPendente').val());
        }

        function calcularTotaisFormasPendente() {
            var total = 0;
            $('#tblFormasPendente tbody tr').each(function () {
                total += parseValorPendente($(this).find('.forma-valor-pendente').val());
            });
            var diferenca = total - valorPendenteAtual();
            $('#lblTotalFormasPendente').text(total.toFixed(2).replace('.', ','));
            $('#lblDiferencaPendente').text(diferenca.toFixed(2).replace('.', ','));
            var cor = Math.abs(diferenca) < 0.01 ? 'text-success' : 'text-danger';
            $('#lblDiferencaPendente').removeClass('text-success text-danger').addClass(cor);
        }

        function abrirReceberPendente(id) {
            $.get('/CatalogoRecebimentos/ObterDetalhes/' + id)
                .done(function (res) {
                    if (!res.sucesso) {
                        clickAviso('Atenção', res.mensagem, 'falha', null);
                        return;
                    }
                    $('#hddCatalogoPendenteId').val(res.catalogo.id);
                    $('#txtPacientePendente').val(res.catalogo.paciente);
                    $('#txtValorPendente').val(res.catalogo.valorTotal.toFixed(2).replace('.', ','));
                    $('#txtPeriodoPendente').val(res.catalogo.periodoFaturamento || '');
                    $('#tblFormasPendente tbody').empty();
                    //Feito pelo Qoder em 16/08/2026 — o box de formas inicia vazio:
                    // a baixa só pode ser salva após o usuário adicionar e preencher as linhas.
                    calcularTotaisFormasPendente();
                    $('#modalReceberPendente').modal('show');
                })
                .fail(function () {
                    clickAviso('Erro', 'Erro ao carregar o título pendente.', 'critica', null);
                });
        }

        function salvarReceberPendente() {
            var catalogoId = parseInt($('#hddCatalogoPendenteId').val()) || 0;
            var periodo = $('#txtPeriodoPendente').val().trim();
            if (!periodo) {
                clickAviso('Atenção', 'Informe o período de faturamento (MM/AAAA).', 'falha', null);
                return;
            }

            var formas = [];
            var formasValidas = true;
            $('#tblFormasPendente tbody tr').each(function () {
                var formaId = parseInt($(this).find('.forma-id-pendente').val()) || 0;
                var contaId = parseInt($(this).find('.conta-id-pendente').val()) || 0;
                var valor = parseValorPendente($(this).find('.forma-valor-pendente').val());
                var data = $(this).find('.forma-data-pendente').val();
                var obs = $(this).find('.forma-obs-pendente').val();
                if (formaId <= 0 || contaId <= 0) {
                    clickAviso('Atenção', 'Selecione a forma e a conta em todas as linhas.', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                //Feito pelo Qoder em 16/08/2026 — valor, data e observação obrigatórios em cada linha
                if (valor <= 0) {
                    clickAviso('Atenção', 'Informe um valor maior que zero em todas as linhas.', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                if (!data) {
                    clickAviso('Atenção', 'Informe a data em todas as linhas.', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                if (!(obs || '').trim()) {
                    clickAviso('Atenção', 'Informe a observação em todas as linhas (use "." se necessário).', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                //..Qoder
                formas.push({
                    FormaRecebimentoId: formaId,
                    ContaRecebimentoId: contaId,
                    Valor: valor,
                    DataRecebimento: data,
                    Observacao: obs
                });
            });

            if (!formasValidas) {
                return;
            }

            if (formas.length === 0) {
                clickAviso('Atenção', 'Informe pelo menos uma forma de recebimento.', 'falha', null);
                return;
            }

            var totalFormas = formas.reduce(function (acc, f) { return acc + f.Valor; }, 0);
            if (Math.abs(totalFormas - valorPendenteAtual()) > 0.01) {
                clickAviso('Atenção', 'A soma das formas deve ser igual ao valor a receber.', 'falha', null);
                return;
            }

            var btn = $('#btnConfirmarReceberPendente');
            if (btn.prop('disabled')) return;
            btn.prop('disabled', true);
            //Feito pelo Qoder em 23/08/2026 — loading padrão único (loader modal Swal)
            if (typeof ShowProgress === 'function') ShowProgress();

            $.ajax({
                url: '/CatalogoRecebimentos/ReceberPendente',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ CatalogoId: catalogoId, PeriodoFaturamento: periodo, Formas: formas }),
                success: function (res) {
                    if (typeof esconderLoading === 'function') esconderLoading(); // fecha o loader antes da mensagem
                    if (res.sucesso) {
                        $('#modalReceberPendente').modal('hide');
                        table.ajax.reload();
                        clickAviso('Sucesso', res.mensagem, 'sucesso', null);
                    } else {
                        clickAviso('Atenção', res.mensagem, 'falha', null);
                    }
                },
                error: function () {
                    if (typeof esconderLoading === 'function') esconderLoading();
                    clickAviso('Erro', 'Erro ao registrar o recebimento.', 'critica', null);
                },
                complete: function () {
                    btn.prop('disabled', false);
                }
            });
        }
        //..Qoder

        //Feito pelo Qoder em 16/08/2026 — recebimento consolidado por instituição/período
        var _valorDevidoConsolidado = 0;
        var _previewConsolidadoCarregado = false;

        function parseValorConsolidado(texto) {
            texto = (texto || '').trim();
            if (!texto) return 0;
            if (texto.indexOf(',') >= 0) {
                return parseFloat(texto.replace(/\./g, '').replace(',', '.')) || 0;
            }
            return parseFloat(texto) || 0;
        }

        function abrirReceberConsolidado() {
            _valorDevidoConsolidado = 0;
            _previewConsolidadoCarregado = false;
            $('#selInstituicaoConsolidado').val($('#selInstituicao').val() || '');
            $('#txtDataIniConsolidado').val($('#txtDataIni').val());
            $('#txtDataFimConsolidado').val($('#txtDataFim').val());
            $('#tblPreviewConsolidadoBody').empty();
            $('#lblQuantidadeConsolidado').text('0 exames');
            $('#txtValorDevidoConsolidado').val('0,00');
            $('#txtAjusteConsolidado').val('').prop('disabled', true);
            $('#txtValorAPagarConsolidado').val('0,00');
            $('#chkDeclaracaoConsolidado').prop('checked', false).prop('disabled', true);
            $('#txtObservacaoConsolidado').val('');
            $('#tblFormasConsolidado tbody').empty();
            calcularTotaisConsolidado();
            $('#modalReceberConsolidado').modal('show');
        }

        //Feito pelo Qoder em 16/08/2026
        // Liga/desliga o overlay de loading dentro do modal do recebimento consolidado.
        function setLoadingConsolidado(ativo, texto) {
            if (texto) $('#lblLoadingConsolidado').text(texto);
            $('#loadingConsolidado').toggleClass('d-none', !ativo).toggleClass('d-flex', ativo);
        }
        //..Qoder

        function carregarExamesConsolidado() {
            var instituicaoId = parseInt($('#selInstituicaoConsolidado').val()) || 0;
            var dataIni = $('#txtDataIniConsolidado').val();
            var dataFim = $('#txtDataFimConsolidado').val();
            if (instituicaoId <= 0) {
                clickAviso('Atenção', 'Selecione a instituição.', 'falha', null);
                return;
            }
            if (!dataIni || !dataFim) {
                clickAviso('Atenção', 'Informe a data inicial e a data final.', 'falha', null);
                return;
            }

            //Feito pelo Qoder em 16/08/2026
            // Loading visível dentro do modal (o overlay do layout fica atrás do backdrop).
            setLoadingConsolidado(true, 'Carregando exames do período...');
            //..Qoder
            $.get('/CatalogoRecebimentos/PreviewRecebimentoConsolidado', { instituicaoId: instituicaoId, dataIni: dataIni, dataFim: dataFim })
                .done(function (res) {
                    if (!res.sucesso) {
                        clickAviso('Atenção', res.mensagem, 'falha', null);
                        return;
                    }
                    if (res.quantidade === 0) {
                        clickAviso('Atenção', 'Nenhum exame disponível para recebimento no período informado.', 'falha', null);
                    }

                    var tbody = $('#tblPreviewConsolidadoBody');
                    tbody.empty();
                    res.exames.forEach(function (e) {
                        //Feito pelo Qoder em 16/08/2026
                        // Situação do exame no período: título pendente de Instituição absorvido
                        // pelo consolidado ou exame ainda fora do catálogo.
                        var situacao = e.tituloPendente
                            ? '<span class="badge bg-warning text-dark" title="Título pendente de Instituição absorvido por este recebimento">Título Pendente</span>'
                            : '<span class="badge bg-secondary" title="Exame liberado ainda não incluído no catálogo">Fora do Catálogo</span>';
                        //..Qoder
                        tbody.append('<tr>' +
                            '<td>' + e.sequencial + '</td>' +
                            '<td>' + e.nomePaciente + '</td>' +
                            '<td>' + e.dataExame + '</td>' +
                            '<td>' + situacao + '</td>' +
                            '<td class="text-end">' + e.valor.toFixed(2).replace('.', ',') + '</td>' +
                            '</tr>');
                    });

                    $('#lblQuantidadeConsolidado').text(res.quantidade + ' exame' + (res.quantidade === 1 ? '' : 's'));
                    _valorDevidoConsolidado = res.valorTotalDevido;
                    _previewConsolidadoCarregado = res.quantidade > 0;
                    $('#txtValorDevidoConsolidado').val(_valorDevidoConsolidado.toFixed(2).replace('.', ','));
                    $('#txtAjusteConsolidado').prop('disabled', !_previewConsolidadoCarregado);
                    $('#chkDeclaracaoConsolidado').prop('disabled', !_previewConsolidadoCarregado);
                    calcularTotaisConsolidado();
                })
                .fail(function () {
                    clickAviso('Erro', 'Erro ao carregar os exames do período.', 'critica', null);
                })
                .always(function () {
                    //Feito pelo Qoder em 16/08/2026
                    setLoadingConsolidado(false);
                    //..Qoder
                });
        }

        function valorAPagarConsolidado() {
            return _valorDevidoConsolidado + parseValorConsolidado($('#txtAjusteConsolidado').val());
        }

        function calcularTotaisConsolidado() {
            var pagar = valorAPagarConsolidado();
            $('#txtValorAPagarConsolidado').val(pagar.toFixed(2).replace('.', ','));

            var total = 0;
            $('#tblFormasConsolidado tbody tr').each(function () {
                total += parseValorConsolidado($(this).find('.forma-valor-consolidado').val());
            });
            var diferenca = total - pagar;
            $('#lblTotalFormasConsolidado').text(total.toFixed(2).replace('.', ','));
            $('#lblDiferencaConsolidado').text(diferenca.toFixed(2).replace('.', ','));
            var cor = Math.abs(diferenca) < 0.01 ? 'text-success' : 'text-danger';
            $('#lblDiferencaConsolidado').removeClass('text-success text-danger').addClass(cor);

            atualizarConfirmarConsolidado();
        }

        function atualizarConfirmarConsolidado() {
            //Feito pelo Qoder em 16/08/2026
            // O botão "Confirmar Recebimento" somente aparece quando:
            //  1) o preview foi carregado; 2) a declaração de conferência está marcada;
            //  3) há pelo menos uma forma de recebimento; 4) a soma das formas completa
            //     o Valor Total a ser Pago (diferença zero).
            var pagar = valorAPagarConsolidado();
            var linhas = 0;
            var totalFormas = 0;
            $('#tblFormasConsolidado tbody tr').each(function () {
                linhas++;
                totalFormas += parseValorConsolidado($(this).find('.forma-valor-consolidado').val());
            });
            var formasCompletas = linhas > 0 && Math.abs(totalFormas - pagar) < 0.01;
            var visivel = _previewConsolidadoCarregado
                && $('#chkDeclaracaoConsolidado').is(':checked')
                && formasCompletas;
            $('#btnConfirmarReceberConsolidado').prop('disabled', false).toggleClass('d-none', !visivel);
            //..Qoder
        }

        function adicionarLinhaFormaConsolidado() {
            // Selects iniciam em "Selecione": todos os campos da linha são obrigatórios.
            var linha = '<tr>' +
                '<td><select class="form-select form-select-sm forma-id-consolidado"><option value="0">Selecione</option>' + opcoesSelectPendente('#selForma') + '</select></td>' +
                '<td><select class="form-select form-select-sm conta-id-consolidado"><option value="0">Selecione</option>' + opcoesSelectPendente('#selConta') + '</select></td>' +
                '<td><input type="text" inputmode="decimal" class="form-control form-control-sm text-end forma-valor-consolidado" value="" placeholder="0,00" /></td>' +
                '<td><input type="date" class="form-control form-control-sm forma-data-consolidado" value="' + new Date().toISOString().split('T')[0] + '" /></td>' +
                '<td><input type="text" class="form-control form-control-sm forma-obs-consolidado" maxlength="2000" /></td>' +
                '<td><button type="button" class="btn btn-sm btn-danger btn-remover-forma-consolidado"><i class="fa-solid fa-trash"></i></button></td>' +
                '</tr>';
            $('#tblFormasConsolidado tbody').append(linha);
            //Feito pelo Qoder em 16/08/2026
            // Nova linha altera a soma das formas: reavalia o botão de confirmar.
            calcularTotaisConsolidado();
            //..Qoder
        }

        function salvarReceberConsolidado() {
            var instituicaoId = parseInt($('#selInstituicaoConsolidado').val()) || 0;
            var dataIni = $('#txtDataIniConsolidado').val();
            var dataFim = $('#txtDataFimConsolidado').val();

            if (!_previewConsolidadoCarregado) {
                clickAviso('Atenção', 'Carregue os exames do período antes de confirmar.', 'falha', null);
                return;
            }
            if (!$('#chkDeclaracaoConsolidado').is(':checked')) {
                clickAviso('Atenção', 'Marque a declaração de conferência do total dos exames.', 'falha', null);
                return;
            }

            var formas = [];
            var formasValidas = true;
            $('#tblFormasConsolidado tbody tr').each(function () {
                var formaId = parseInt($(this).find('.forma-id-consolidado').val()) || 0;
                var contaId = parseInt($(this).find('.conta-id-consolidado').val()) || 0;
                var valor = parseValorConsolidado($(this).find('.forma-valor-consolidado').val());
                var data = $(this).find('.forma-data-consolidado').val();
                var obs = $(this).find('.forma-obs-consolidado').val();
                if (formaId <= 0 || contaId <= 0) {
                    clickAviso('Atenção', 'Selecione a forma e a conta em todas as linhas.', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                if (valor <= 0) {
                    clickAviso('Atenção', 'Informe um valor maior que zero em todas as linhas.', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                if (!data) {
                    clickAviso('Atenção', 'Informe a data em todas as linhas.', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                if (!(obs || '').trim()) {
                    clickAviso('Atenção', 'Informe a observação em todas as linhas (use "." se necessário).', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                formas.push({
                    FormaRecebimentoId: formaId,
                    ContaRecebimentoId: contaId,
                    Valor: valor,
                    DataRecebimento: data,
                    Observacao: obs
                });
            });

            if (!formasValidas) {
                return;
            }

            if (formas.length === 0) {
                clickAviso('Atenção', 'Informe pelo menos uma forma de recebimento.', 'falha', null);
                return;
            }

            var totalFormas = formas.reduce(function (acc, f) { return acc + f.Valor; }, 0);
            if (Math.abs(totalFormas - valorAPagarConsolidado()) > 0.01) {
                clickAviso('Atenção', 'A soma das formas deve ser igual ao Valor Total a ser Pago.', 'falha', null);
                return;
            }

            var btn = $('#btnConfirmarReceberConsolidado');
            if (btn.prop('disabled')) return;
            btn.prop('disabled', true);
            //Feito pelo Qoder em 16/08/2026
            setLoadingConsolidado(true, 'Registrando recebimento consolidado...');
            //..Qoder

            $.ajax({
                url: '/CatalogoRecebimentos/SalvarRecebimentoConsolidado',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    InstituicaoId: instituicaoId,
                    DataIni: dataIni,
                    DataFim: dataFim,
                    DeclaracaoConferencia: true,
                    ValorAjuste: parseValorConsolidado($('#txtAjusteConsolidado').val()),
                    Observacao: $('#txtObservacaoConsolidado').val(),
                    Formas: formas
                }),
                success: function (res) {
                    if (res.sucesso) {
                        $('#modalReceberConsolidado').modal('hide');
                        table.ajax.reload();
                        clickAviso('Sucesso', res.mensagem, 'sucesso', null);
                    } else {
                        clickAviso('Atenção', res.mensagem, 'falha', null);
                    }
                },
                error: function () {
                    clickAviso('Erro', 'Erro ao registrar o recebimento consolidado.', 'critica', null);
                },
                complete: function () {
                    //Feito pelo Qoder em 16/08/2026
                    setLoadingConsolidado(false);
                    //..Qoder
                    atualizarConfirmarConsolidado();
                }
            });
        }
        //..Qoder
    </script>
}
