@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BLL
@using static BLL.UtilBLL
@using LabWebMvc.MVC.Interfaces
@using LabWebMvc.MVC.ViewModel
@model vmPostos
<partial name='Partials/_PartialMenuPostos' />
<div class="card-secao">
    <div class="card-secao-header">
        <i class="fa-solid fa-location-dot"></i> Postos e Anexos
        @*Feito pelo Qoder em 22/08/2026 — botão de inclusão ao lado do título do card (tela sem linha de filtros)*@
        @if (!PartialFiltro.Esconde)
        {
            <a asp-action=@PartialFiltro.ActionButton asp-controller=@PartialFiltro.ControllerButton class="btn btn-success btn-sm" style="display: inline-block;" title="Incluir Postos de Coletas">
                <i class="fa-solid fa-location-dot"></i> Incluir Postos de Coletas
            </a>
        }
    </div>
    <div class="card-secao-body">
        <div class="table-responsive">
    <table id="modeloTable" name="datatable" data-order='[[ 0, "desc" ]]' class="display compact order-column stripe table-hover nowrap">
        <thead>
            <tr>
                <th>Id</th>
                <th>Sigla Inst.</th>
                <th>Nome Inst.</th>
                <th>Sigla Posto</th>
                <th>Nome do Posto/anexo</th>
                <th>Responsável</th>
                <th>Telefone</th>
                <th>Opções</th>
            </tr>
        </thead>
        <tbody>
            @* Dados carregados via AJAX pelo DataTables (server-side processing). *@
        </tbody>
        <tfoot>
            <tr>
                <th>Id</th>
                <th>Sigla Inst.</th>
                <th>Nome Inst.</th>
                <th>Sigla Posto</th>
                <th>Nome do Posto/anexo</th>
                <th>Responsável</th>
                <th>Telefone</th>
                <th id="op">Opções</th>
            </tr>
        </tfoot>
        </table>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#modeloTable tfoot th').each(function () {
                var title = $(this).text();
                if (title !== 'Opções') {
                    $(this).html('<input type="text" placeholder="' + title + '" style="max-width: 106px; padding-left: 4px; border: 1px solid gray; border-radius: 5px;" />');
                } else {
                    $(this).html('');
                }
            });

            $('#modeloTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/Postos/Listar',
                    type: 'POST'
                },
                pageLength: 10,
                order: [[0, 'desc']],
                columns: [
                    { data: 'id', name: 'id' },
                    { data: 'siglaInstituicao', name: 'siglaInstituicao', orderable: false },
                    { data: 'nomeInstituicao', name: 'nomeInstituicao', orderable: false },
                    { data: 'siglaPosto', name: 'siglaPosto', orderable: false },
                    { data: 'nomePosto', name: 'nomePosto' },
                    { data: 'responsavel', name: 'responsavel', orderable: false },
                    { data: 'telefone', name: 'telefone', orderable: false },
                    { data: 'acoes', name: 'acoes', orderable: false, searchable: false }
                ],
                autoWidth: true,
                responsive: true,
                fixedColumns: {
                    left: -1,
                    right: 1
                },
                fixedHeader: {
                    header: true,
                    footer: true
                },
                layout: {
                    topStart: {
                        pageLength: {
                            menu: [[10, 25, 50, 100, 250, 500, -1], [10, 25, 50, 100, 250, 500, "Todos"]]
                        }
                    },
                    topEnd: {
                        search: {
                            placeholder: 'Digite aqui sua busca'
                        }
                    },
                    bottomStart: 'info',
                    bottomEnd: {
                        paging: {
                            numbers: 5
                        }
                    }
                },
                language: {
                    search: "Busca:",
                    lengthMenu: "Mostrar _MENU_ resultados por página",
                    emptyTable: "<b style='color: red;'>Não haviam dados disponíveis para esta consulta</b>",
                    info: "Exibindo: _START_/_END_ de _TOTAL_ registros",
                    infoFiltered: "(Total de _MAX_ registros existentes na base de dados)",
                    infoThousands: ".",
                    thousands: ".",
                    decimal: ",",
                    loadingRecords: "Carregando...",
                    zeroRecords: "<b style='color: red;'>A consulta não retornou dados para o Grid</b>",
                    paginate: {
                        next: "<img src='images/icones/arrow_right_uno.png' width='28%' border='none' />",
                        previous: "<img src='images/icones/arrow_left_uno.png' width='28%' border='none' />",
                        first: "<img src='images/icones/arrow_left.png' width='28%' border='none' />",
                        last: "<img src='images/icones/arrow_right.png' width='28%' border='none' />"
                    }
                },
                initComplete: function () {
                    this.api().columns().every(function () {
                        var that = this;
                        $('input', this.footer()).on('keyup change clear', function () {
                            if (that.search() !== this.value) {
                                that.search(this.value).draw();
                            }
                        });
                    });

                    setTimeout(function () {
                        if (typeof restaurarEstadoGrid === 'function') {
                            restaurarEstadoGrid('Postos');
                        }
                    }, 500);
                }
            });

            $("input[type='search']")[0].focus();
        });
    </script>
}
<script>
    //ACTIONS ICONS
    function clickConsulta(x) {
        salvarEstadoGrid('Postos', x.id);
        var url = "ConsultarPostos?id=" + x.id;
        window.open(url, "_self")
        //window.location.href = '@Url.Action("ConsultarPostos", "Postos")?id=' + x.id;
    }
    function clickAlterar(x) { //OK
        salvarEstadoGrid('Postos', x.id);
        window.location.href = '@Url.Action("AlterarPostos", "Postos")?id=' + x.id;
    }
    function clickDelete(x) {
        //"x" é a linha toda da tag (tem que passar a linha TODA de "x")
        //x.id é somente o "id" na tag da linha
        return clickConfirm(x, null, "Excluir posto/anexo?", null, "ExcluirPostos");
    };
</script>