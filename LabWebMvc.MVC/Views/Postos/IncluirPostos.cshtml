@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@using LabWebMvc.MVC.Areas.Utils
@model vmPostos
@{
    Layout = "_Layout";
}
<script>
    $(document).ready(function () {
        initBtnVoltar();
        // Sincroniza os dois dropdowns de Instituicao
        $('#ddlInstSigla').on('change', function () {
            var val = $(this).val();
            $('#ddlInstNome').val(val);
            $('#InstituicaoId').val(val);
        });
        $('#ddlInstNome').on('change', function () {
            var val = $(this).val();
            $('#ddlInstSigla').val(val);
            $('#InstituicaoId').val(val);
        });

        $('#clickSubmit').click(function (event) {
            event.preventDefault();
            $.ajax({
                //url: '@Url.Action("IncluirPostos", "Postos")',
                type: "POST",
                async: true,
                dataType: "json",
                data: $('#form').serialize(),
                success: function (data) {
                    var titulo = data['titulo'];
                    var mensagem = data['mensagem'];
                    var actionPos = data['action'];
                    var sucesso = data['sucesso'];
                    titulo = (titulo == null) ? 'Atenção' : data['titulo'];
                    var tipo = 'falha';
                    if (sucesso == true) tipo = 'sucesso';
                    //success: Javascript ::: aqui acontece todas as mensagens de sucesso e não sucesso
                    clickAviso(titulo, mensagem, tipo, actionPos);  //mensagem normal com desvio para outra action (site.js)
                },
                error: function (request, status, error) {
                    //aqui somente acontece no caso de exception/erro do javascript
                    clickAviso('Interrompido', 'Falha na execução', 'critica', '');  //mensagem crítica (site.js)
                }
            });
            //Limpa todos os campos do formulário!
            $('#form')[0].reset();
        })
    });
</script>
@using (Html.BeginForm(FormMethod.Post, new { @class = "form-horizontal", @id = "form", @enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="lab-form-container lab-refined">

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-location-dot"></i> Dados do Posto
            </div>
            <div class="card-secao-body">
                @* Feito pelo Qoder em 21/04/2026 - selecção da Instituição e Sigla do Posto *@
                <div class="field-row">
                    <div class="field-group w-xl">
                        <label>*Instituição</label>
                        <div class="d-flex gap-2">
                            <select id="ddlInstSigla" class="form-control" style="width: 30%;" required>
                                <option value="">Sigla</option>
                                @foreach (var item in Model.InstituicoesSigla)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <select id="ddlInstNome" class="form-control" style="width: 70%;">
                                <option value="">Nome da Instituição</option>
                                @foreach (var item in Model.InstituicoesNome)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        @Html.HiddenFor(p => p.InstituicaoId, new { @id = "InstituicaoId" })
                        @Html.ValidationMessageFor(p => p.InstituicaoId, null, new { @class = "has-error" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-sm">
                        <label>*Sigla do Posto</label>
                        @Html.TextBoxFor(p => p.SiglaPosto, new { @class = "form-control", @placeholder = "Máx. 20 caracteres: A-Z 0-9 espaço . _ -", @required = "required", @maxlength = "20", @pattern = "[A-Z0-9 ._\\-]+", @oninput = "this.value=this.value.toUpperCase()" })
                        @Html.ValidationMessageFor(p => p.SiglaPosto, null, new { @class = "has-error" })
                    </div>
                    <div class="field-group w-xl">
                        <label>*Nome completo do posto/anexo</label>
                        @Html.TextBoxFor(p => p.NomePosto, new { @class = "form-control capitalize", @placeholder = "Entre com o nome completo do posto", @required = "required" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-xl">
                        <label>*Responsável</label>
                        @Html.TextBoxFor(p => p.Responsavel, new { @class = "form-control capitalize", @placeholder = "Entre com o nome do responsável pelo posto/anexo", @required = "required" })
                    </div>
                    <div class="field-group w-md">
                        <label>Telefone com DDD</label>
                        @Html.TextBoxFor(p => p.Telefone, new { @class = "form-control", @placeholder = "Telefone com DDD" })
                        @Html.ValidationMessageFor(p => p.Telefone, null, new { @class = "has-error" })
                    </div>
                </div>
                @* ..Qoder *@
            </div>
        </div>

        <div class="card-secao card-secao-w-lg">
            <div class="card-secao-header">
                <i class="fa-solid fa-map-marker-alt"></i> Endereço
            </div>
            <div class="card-secao-body">
                <div class="field-row">
                    <div class="field-group w-sm">
                        <label>CEP</label>
                        @Html.TextBoxFor(p => p.CEP, new { @class = "form-control", @placeholder = "CEP" })
                    </div>
                    <div class="field-group w-xl">
                        <label>Logradouro (Rua, Av, Estrada, etc)</label>
                        @Html.TextBoxFor(p => p.Logradouro, new { @class = "form-control capitalize", @placeholder = "Logradouro/Rua/Trav" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-xl">
                        <label>Endereço</label>
                        @Html.TextBoxFor(p => p.Endereco, new { @class = "form-control capitalize", @placeholder = "Endereço" })
                    </div>
                    <div class="field-group w-sm">
                        <label>Número</label>
                        @Html.TextBoxFor(p => p.Numero, new { @class = "form-control capitalize", @placeholder = "Número" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-md">
                        <label>Complemento</label>
                        @Html.TextBoxFor(p => p.Complemento, new { @class = "form-control", @placeholder = "Complemento/Apto/Quadra/Lote" })
                    </div>
                    <div class="field-group w-md">
                        <label>Bairro</label>
                        @Html.TextBoxFor(p => p.Bairro, new { @class = "form-control capitalize", @placeholder = "Bairro" })
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group w-xl">
                        <label>Cidade</label>
                        @Html.TextBoxFor(p => p.Cidade, new { @class = "form-control capitalize", @placeholder = "Cidade/Município" })
                    </div>
                    <div class="field-group w-xs">
                        <label>UF</label>
                        @Html.DropDownListFor(p => p.vmGeral.TipoUF, new SelectList(Utils.ListaUF(), "UF", "Nome", selectedValue: Model.SessionUF), new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group" style="margin-top: 16px;">
            <button type="button" id="btnVoltar" class="btn btn-lg btn-secondary lab-btn" style="margin-right: 10px;">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </button>
            <button id="clickSubmit" type="submit" class="btn btn-lg btn-success botao-verde lab-btn">
                Salvar
            </button>
        </div>

    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
