@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using static BLL.UtilBLL
@using LabWebMvc.MVC.ViewModel
@using LabWebMvc.MVC.Areas.Utils
@model vmPostos
@{
    Layout = "_Layout";
}
<script>
    $(document).ready(function () {
        initBtnVoltar();
        // Sincroniza os dois dropdowns de Instituicao
        $('#ddlInstSigla').on('change', function () {
            var val = $(this).val();
            $('#ddlInstNome').val(val);
            $('#InstituicaoId').val(val);
        });
        $('#ddlInstNome').on('change', function () {
            var val = $(this).val();
            $('#ddlInstSigla').val(val);
            $('#InstituicaoId').val(val);
        });

        $('#clickSubmit').click(function (event) {
            event.preventDefault();
            $.ajax({
                //url: '@Url.Action("IncluirPostos", "Postos")',
                type: "POST",
                async: true,
                dataType: "json",
                data: $('#form').serialize(),
                success: function (data) {
                    var titulo = data['titulo'];
                    var mensagem = data['mensagem'];
                    var actionPos = data['action'];
                    var sucesso = data['sucesso'];
                    titulo = (titulo == null) ? 'Atenção' : data['titulo'];
                    var tipo = 'falha';
                    if (sucesso == true) tipo = 'sucesso';
                    //success: Javascript ::: aqui acontece todas as mensagens de sucesso e não sucesso
                    clickAviso(titulo, mensagem, tipo, actionPos);  //mensagem normal com desvio para outra action (site.js)
                },
                error: function (request, status, error) {
                    //aqui somente acontece no caso de exception/erro do javascript
                    clickAviso('Interrompido', 'Falha na execução', 'critica', '');  //mensagem crítica (site.js)
                }
            });
            //Limpa todos os campos do formulário!
            $('#form')[0].reset();
        })
    });
</script>
@using (Html.BeginForm(FormMethod.Post, new { @class = "form-horizontal", @id = "form", @enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <style>
        .cadastro-clean .form-control { font-size: 12px !important; }
        .cadastro-clean select.form-control { font-size: 12px !important; }
    </style>
    <div class="cadastro-clean" style="max-width: 600px; margin: 20px 0; padding: 24px; border: 1px solid #d4edda; border-radius: 8px; background-color: #fff;">
        <h4 style="color: #333; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 1px solid #e0e0e0;">
            <i class="fa-solid fa-location-dot" style="color: #69c38a;"></i> Incluir Posto de Coleta
        </h4>
            @* Feito pelo Qoder em 21/04/2026 - selecção da Instituição e Sigla do Posto *@
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">*Instituição</label>
                <div class="d-flex gap-2">
                    <select id="ddlInstSigla" class="form-control" style="width: 30%; border: 1px solid #69c38a; border-radius: 6px;" required>
                        <option value="">Sigla</option>
                        @foreach (var item in Model.InstituicoesSigla)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <select id="ddlInstNome" class="form-control" style="width: 70%; border: 1px solid #69c38a; border-radius: 6px;">
                        <option value="">Nome da Instituição</option>
                        @foreach (var item in Model.InstituicoesNome)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                @Html.HiddenFor(p => p.InstituicaoId, new { @id = "InstituicaoId" })
                @Html.ValidationMessageFor(p => p.InstituicaoId, null, new { @class = "has-error" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">*Sigla do Posto</label>
                @Html.TextBoxFor(p => p.SiglaPosto, new { @class = "form-control", @placeholder = "Máx. 20 caracteres: A-Z 0-9 espaço . _ -", @required = "required", @maxlength = "20", @pattern = "[A-Z0-9 ._\\-]+", @oninput = "this.value=this.value.toUpperCase()", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
                @Html.ValidationMessageFor(p => p.SiglaPosto, null, new { @class = "has-error" })
            </div>
            @* ..Qoder *@
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Nome completo do posto de coleta/anexo/etc</label>
                @Html.TextBoxFor(p => p.NomePosto, new { @class = "form-control capitalize", @placeholder = "Entre com o nome completo do posto", @required = "required", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Responsável</label>
                @Html.TextBoxFor(p => p.Responsavel, new { @class = "form-control capitalize", @placeholder = "Entre com o nome do responsável pelo posto/anexo", @required = "required", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Telefone com DDD</label>
                @Html.TextBoxFor(p => p.Telefone, new { @class = "form-control", @placeholder = "Telefone com DDD", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
                @Html.ValidationMessageFor(p => p.Telefone, null, new { @class = "has-error" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">CEP</label>
                @Html.TextBoxFor(p => p.CEP, new { @class = "form-control", @placeholder = "CEP", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Logradouro (Rua, Av, Estrada, etc)</label>
                @Html.TextBoxFor(p => p.Logradouro, new { @class = "form-control capitalize", @placeholder = "Logradouro/Rua/Trav", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Endereço</label>
                @Html.TextBoxFor(p => p.Endereco, new { @class = "form-control capitalize", @placeholder = "Endereço", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Número</label>
                @Html.TextBoxFor(p => p.Numero, new { @class = "form-control capitalize", @placeholder = "Número", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Complemento</label>
                @Html.TextBoxFor(p => p.Complemento, new { @class = "form-control", @placeholder = "Complemento/Apto/Quadra/Lote", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Bairro</label>
                @Html.TextBoxFor(p => p.Bairro, new { @class = "form-control capitalize", @placeholder = "Bairro", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">Cidade</label>
                @Html.TextBoxFor(p => p.Cidade, new { @class = "form-control capitalize", @placeholder = "Cidade/Município", @style = "border: 1px solid #69c38a; border-radius: 6px;" })
            </div>
            <div class="form-group">
                <label style="font-size: 13px; color: #333;">UF:</label>
                <div style="display: inline-block;">
                    @Html.DropDownListFor(p => p.vmGeral.TipoUF, new SelectList(Utils.ListaUF(), "UF", "Nome", selectedValue: Model.SessionUF))
                </div>
            </div>
            <!--
            Submeter Formulário
            -->
            <div class="form-group" style="margin-top: 20px; text-align: center;">
                <button type="button" id="btnVoltar" class="btn btn-lg btn-secondary" style="margin-right: 10px;">
                    <i class="fa-solid fa-arrow-left"></i> Voltar
                </button>
                <button id="clickSubmit" type="submit" class="btn btn-lg btn-success botao-verde" style="border-radius: 6px;">
                    Salvar
                </button>
            </div>
    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}