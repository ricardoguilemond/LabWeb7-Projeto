@using BLL
@using static BLL.UtilBLL
@using LabWebMvc.MVC.Areas.Controllers
@using LabWebMvc.MVC.Interfaces
@using LabWebMvc.MVC.ViewModel
@model vmRequisitar
@* <!-- Esse Modal é uma tela de pesquisa/consulta de pacientes --> *@
<script>
    $(document).ready(function () {

        // Inicializa DataTables e foca o Search somente após o modal estar visível
        //Feito pelo Qoder em 23/08/2026 — Fase 2.3 do plano: grid convertido para serverSide.
        //A lista deixou de vir renderizada no HTML (teto Take(1000)); as páginas, a busca e a
        //ordenação agora vêm do endpoint ModalPacientesListar.
        function inicializarTabelaPacientes() {
            if (!$.fn.dataTable.isDataTable('#tabelaPacientes')) {
                $('#tabelaPacientes').DataTable({
                    processing: true,
                    serverSide: true,
                    ajax: {
                        url: '@Url.Action("ModalPacientesListar", "Requisitar")',
                        type: 'POST'
                    },
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    order: [[0, 'asc']],
                    columns: [
                        { data: 'nomePaciente', name: 'nomePaciente' },
                        { data: 'cpf', name: 'cpf', orderable: false },
                        { data: 'id', name: 'id' }
                    ],
                    autoWidth: false,
                    layout: {
                        topStart: {
                            search: {
                                placeholder: 'Digite aqui sua busca'
                            }
                        },
                        topEnd: { /* obrigatório ter mesmo sem utilizar, porque desformata o Search */
                        },
                    },
                    language: {
                        search: "Busca:",
                        lengthMenu: "Mostrar _MENU_ resultados por página",
                        emptyTable: "<b style='color: red;'>Não haviam dados disponíveis para esta consulta</b>",
                        info: "Exibindo: _START_/_END_ de _TOTAL_ registros",
                        infoFiltered: "(Total de _MAX_ registros existentes na base de dados)",
                        infoThousands: ".",
                        thousands: ".",
                        decimal: ",",
                        loadingRecords: "Carregando...",
                        zeroRecords: "<b style='color: red;'>A consulta não retornou dados para o Grid</b>",
                        paginate: {
                            next: "<img src='images/icones/arrow_right_uno.png' width='28%' border='none' />",
                            previous: "<img src='images/icones/arrow_left_uno.png' width='28%' border='none' />",
                            first: "<img src='images/icones/arrow_left.png' width='28%' border='none' />",
                            last: "<img src='images/icones/arrow_right.png' width='28%' border='none' />"
                        }
                    },
                    // Mantém a estrutura de seleção original (checkbox chk_nome + clique na linha)
                    createdRow: function (row, data) {
                        $(row).attr('id', 'tr_' + data.nomePaciente)
                              .attr('name', 'trModal')
                              .attr('title', 'Selecionar')
                              .css('width', '90%');
                    },
                    rowCallback: function (row, data) {
                        $('td:eq(0)', row).css('width', '58%')
                            .html('<input id="chk_' + data.nomePaciente + '" name="input" type="checkbox" /> ' + data.nomePaciente);
                        $('td:eq(1)', row).css('width', '12%').attr('id', data.cpf);
                        $('td:eq(2)', row).attr('id', data.id);
                    }
                });
            } else {
                $('#tabelaPacientes').DataTable().columns.adjust();
            }
        }
        //..Qoder

        document.getElementById('modeloTableModalPaciente').addEventListener('shown.bs.modal', function () {
            inicializarTabelaPacientes();
            var inputBusca = document.querySelector('#modeloTableModalPaciente input[type="search"]');
            if (inputBusca) inputBusca.focus();
        });

        // Ao fechar o modal (qualquer forma), move o foco para Sigla da Instituição se um paciente já foi preenchido
        document.getElementById('modeloTableModalPaciente').addEventListener('hidden.bs.modal', function () {
            if ($('#buscaNomePaciente').val().trim().length > 0) {
                setTimeout(function () {
                    var campo = document.getElementById('buscaSiglaInstituicao');
                    if (campo) campo.focus();
                }, 100);
            }
        });

        // Função para preencher o formulário com os dados do paciente selecionado
        function preencherFormularioPaciente(vm) {
            var $conteudo = $("#conteudoPaciente");

            $conteudo.find("#pacienteId").val(vm.pacienteId);
            $conteudo.find("#pacienteIdVisivel").val(vm.pacienteId > 0 ? vm.pacienteId : '');
            $conteudo.find("#buscaNomePaciente").val(vm.nomePaciente);

            // Limpa mensagem de validação do campo nome após preenchimento pelo modal
            var $campoPaciente = $conteudo.find("#buscaNomePaciente");
            $campoPaciente.removeClass('input-validation-error');
            $campoPaciente.siblings('div.has-error, span.field-validation-error').hide().text('');
            $campoPaciente.siblings('div.field-validation-error').hide().text('');

            $conteudo.find("#Nascimento").val(vm.nascimento);
            $conteudo.find("#CPFPaciente").val(vm.cpfPaciente);
            $conteudo.find("#Telefone").val(vm.telefone);
            $conteudo.find("#Email").val(vm.email);

            $conteudo.find("#Mae").val(vm.nomeMae);
            $conteudo.find("#Naturalidade").val(vm.naturalidade);
            $conteudo.find("#Nacionalidade").val(vm.nacionalidade);
            $conteudo.find("#Profissao").val(vm.profissao);
            $conteudo.find("#CEP").val(vm.cep);
            $conteudo.find("#Logradouro").val(vm.logradouro);
            $conteudo.find("#Endereco").val(vm.endereco);
            $conteudo.find("#Numero").val(vm.numero);
            $conteudo.find("#Complemento").val(vm.complemento);
            $conteudo.find("#Bairro").val(vm.bairro);
            $conteudo.find("#Cidade").val(vm.cidade);
            $conteudo.find("#Observacao").val(vm.observacao);

            $conteudo.find("select[name='vmGeral.TipoUF']").val(vm.uf);
            $conteudo.find("select[name='vmGeral.TipoTempoGestacao']").val(vm.tempoGestacao);

            $conteudo.find("input[name='Sexo'][value='" + vm.sexo + "']").prop("checked", true);
            $conteudo.find("input[name='EstadoCivil'][value='" + vm.estadoCivil + "']").prop("checked", true);

            $conteudo.find("input[name='VmPacientes.DUM']").val(vm.dum);
        }

        // Seleciona o paciente: chama AJAX, fecha o modal e move o foco
        function selecionarPaciente(nomePaciente) {
            if (!nomePaciente || nomePaciente.length === 0) return;

            $.ajax({
                url: '@Url.Action("RetornoDoModalPacientes", "Requisitar")',
                type: "GET",
                data: { id: nomePaciente },
                cache: false,
                dataType: "json",
                success: function (data) {
                    if (!data || !data.vm || !data.vm.nomePaciente) {
                        clickAviso('Atenção', 'Não trouxe dados nesta busca', 'falha');
                        return;
                    }
                    preencherFormularioPaciente(data.vm);
                    fecharModalEFocar();
                },
                error: function () {
                    clickAviso('Interrompido', 'Falha no carregamento dos dados', 'falha');
                }
            });
        }

        // Fecha o modal de pacientes e move o foco para Sigla da Instituição
        function fecharModalEFocar() {
            var modalEl = document.getElementById('modeloTableModalPaciente');
            // Tenta fechar via instância Bootstrap 5 (qualquer forma que tenha sido aberto)
            var modalInst = bootstrap.Modal.getInstance(modalEl);
            if (modalInst) {
                modalInst.hide();
            } else {
                // Fallback: fecha via jQuery Bootstrap
                $(modalEl).modal('hide');
            }
            // Aguarda a animação de fechamento (~300ms) antes de focar
            setTimeout(function () {
                var campo = document.getElementById('buscaSiglaInstituicao');
                if (campo) campo.focus();
            }, 400);
        }

        // ENTER no campo de busca do DataTables: seleciona a primeira linha visível
        $(document).on("keydown", "#modeloTableModalPaciente input[type='search']", function (event) {
            if (event.keyCode === 13) {
                event.preventDefault();
                event.stopPropagation();

                var table = $('#tabelaPacientes').DataTable();
                var linhasVisiveis = table.rows({ filter: 'applied' }).nodes();

                if (linhasVisiveis.length > 0) {
                    var nomePaciente = $(linhasVisiveis[0]).find('td:eq(0)').clone()
                        .children('input').remove().end().text().trim();
                    selecionarPaciente(nomePaciente);
                } else {
                    clickAviso('Atenção', 'Nenhum paciente encontrado com esse nome', 'falha');
                }
            }
        });

        // Clique em linha do tbody do modal de pacientes
        $(document).on('click', '#modeloTableModalPaciente tbody tr', function () {
            var $checkbox = $(this).find("input[type='checkbox']");
            if ($checkbox.length === 0) return; // ignora linhas sem checkbox (thead, mensagem vazia)

            // Desmarca todos e marca o atual
            $('#tabelaPacientes input[type="checkbox"]').prop('checked', false);
            $checkbox.prop('checked', true);

            var nomePaciente = $checkbox.attr('id').replace('chk_', '');
            selecionarPaciente(nomePaciente);
        });
    });
</script>
<div class="modal fade" id="modeloTableModalPaciente" tabindex="-1" aria-labelledby="tituloModalPaciente" aria-hidden="true" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-top modal-dialog-largo">
        <div class="modal-content shadow rounded">
            <div class="modal-header bg-verde-escuro">
                <h5 class="modal-title" id="tituloModalPaciente">@ViewBag.TextoMenu[0]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tabelaPacientes" name="datatable" class="table table-striped table-hover table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th><div class="theadModal">Nome Paciente</div></th>
                                <th><div class="theadModal">CPF</div></th>
                                <th class="text-end"><div class="theadModal">Id</div></th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Fase 2.3 do plano: linhas renderizadas via AJAX (serverSide) pelo ModalPacientesListar *@
                        </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<!-- Fim da página do Modal -->
