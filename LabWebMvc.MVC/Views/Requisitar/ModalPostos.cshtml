@using BLL
@using static BLL.UtilBLL
@using LabWebMvc.MVC.Interfaces
@using LabWebMvc.MVC.ViewModel
@model vmRequisitar
@* <!-- Esse Modal é uma tela de pesquisa/consulta de postos de coletas --> *@
<script>
    $(document).ready(function () {

        //Constrói o Modal
        configTableModal('#tabelaPostos');

        // Feito pelo Qoder em 21/04/2026 — foca o campo de busca ao abrir o modal
        document.getElementById('modeloTableModalPostos').addEventListener('shown.bs.modal', function () {
            var inputBusca = document.querySelector('#modeloTableModalPostos input[type="search"]');
            if (inputBusca) inputBusca.focus();
        });
        // ..Qoder

        function preencherFormularioPostos(vm) {
            var $conteudo = $("#conteudoPosto");
            $conteudo.find("#buscaNomePosto").val(vm.nomePostos);     // Feito pelo Qoder em 21/04/2026 — corrigido: era #buscaNomePostos (inexistente)
            $conteudo.find("#postoId").val(vm.PostoId);               // Feito pelo Qoder em 21/04/2026 — corrigido: era #PostoId (case errado)
        }

        function ajaxFunction(valorSelecionado) {
            if (valorSelecionado.length > 0) {
                $.ajax({
                    url: '@Url.Action("RetornoDoModalPostos", "Requisitar")',
                    type: "GET",
                    data: { id: valorSelecionado }, // ATENÇÃO: o valor "id" aqui é a Sigla!
                    cache: false,
                    dataType: "json",
                    success: function (data) {
                        if (!data.vm.nomePostos) {
                            clickAviso('Atenção', 'Não trouxe dados nesta busca', 'falha');
                            return;
                        }

                        // Preenchendo os campos após retornar do Controller
                        preencherFormularioPostos(data.vm);
                    },
                    error: function () {
                        clickAviso('Interrompido', 'Falha no carregamento dos dados', 'falha');
                    },
                }).done(function () {
                    ModalManager.fechar('modeloTableModalPostos');
                });
            }
        }
        //..

        // Feito pelo Qoder em 21/04/2026 — ENTER seleciona a primeira linha visível do DataTables
        $(document).on("keydown", "#modeloTableModalPostos input[type='search']", function (event) {
            if (event.keyCode === 13) {
                event.preventDefault();
                var table = $('#tabelaPostos').DataTable();
                var linhasVisiveis = table.rows({ filter: 'applied' }).nodes();

                if (linhasVisiveis.length > 0) {
                    // td:eq(0) contém checkbox + NomePosto; o id do td é o próprio NomePosto
                    var nomePosto = $(linhasVisiveis[0]).find('td:eq(0)').attr('id');
                    ajaxFunction(nomePosto);
                    ModalManager.fechar('modeloTableModalPostos');
                } else {
                    clickAviso('Atenção', 'Nenhum posto encontrado com essa busca', 'falha');
                }
            }
        });
        // ..Qoder
        //..

        //Controlando o input checkbox pelo TR e TD
        $(document).on('click', '#modeloTableModalPostos tbody tr', function (event) {
            var $checkbox = $(this).find("input[type='checkbox']");
            if ($checkbox.length === 0) return;

            $checkbox.closest('table').find("input[type='checkbox']").prop('checked', false);
            $checkbox.prop('checked', true);

            var valorSelecionado = $checkbox.attr('id').replace('chk_', '');
            ajaxFunction(valorSelecionado);
            ModalManager.fechar('modeloTableModalPostos');
        });
        //..
    });
</script>
<div class="modal fade" id="modeloTableModalPostos" tabindex="-1" aria-labelledby="tituloModalPostos" aria-hidden="true">
    <div class="modal-dialog modal-dialog-top modal-dialog-largo">
        <div class="modal-content shadow rounded">
            <div class="modal-header bg-verde-escuro">
                <h5 class="modal-title" id="tituloModalPostos">@ViewBag.TextoMenu[0]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="table-responsive">
                    <table id="tabelaPostos" name="datatable" class="table table-striped table-hover table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Nome Posto de Coleta</th>
                                <th class="text-end">Id</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.ListaPostos != null)
                            {
                                @foreach (var item in ViewBag.ListaPostos)
                                {
                                    <tr id="tr_@item.NomePosto" name="trModal" title="Selecionar" style="width: 90%;">
                                        <td id="@item.NomePosto" style="width:10%;"><input id="chk_@item.NomePosto" name="input" type="checkbox" /> @item.NomePosto</td>
                                        <td id="@item.Id"> @item.Id</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3">Nenhum registro encontrado.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Fim da página do Modal -->
