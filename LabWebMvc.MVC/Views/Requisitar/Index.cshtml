        background-color: #add2fd !important;
    }

    .moeda {
        color: darkblue;
        background-color: white !important;
        border: 2px solid #cccad0 !important;
        border-radius: 2px;
        font-weight: 500;
        height: 21px;
    }

    /* CSS EXCLUSIVO DESTA PÁGINA COM OS TABS */
    .nav-link-tabs { /* nav-link-tabs herda de nav-link para evitar alterações no nav-link em outras partes do sistema */
        font-weight: 300;
        background-color: white;
        border: 1px solid white;
        border-bottom-color: #55c57a;
        border-radius: 0.7em 0.7em 0 0;
        min-width: 220px !important;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.3);
    }

        .nav-link-tabs:hover { /* altera a cor da fonte no hover do tab */
            color: black;
        }

    .nav-pills .nav-link-tabs.active { /* intensidade da cor da fonte no tab ativo */
        font-weight: 400;
    }

    .nav-link-tabs.active { /* formata as bordas dos tabs */
        color: white;
        background-color: #55c57a;
        border-radius: 0.7em 0.7em 0 0;
    }

    .nav-item .nav-item-tabs {
    }

    .tab-content {
        padding-bottom: 1.3rem;
        position: relative;
    }

    ul {
        list-style: none;
        margin-top: 1rem;
        padding-inline-start: 0;
    }
</style>
<script>
    $(document).ready(function () {
        /**************************************************************************************** */
        // OK:SUBMIT NO ÚNICO FORM COM VÁRIOS EVENTOS EM OUTRAS "PARTIAL TELAS" DISTRIBUÍDAS
        /**************************************************************************************** */
        $('#clickSubmit, #clickImprimeCupom').on("click", function (event) {
            event.preventDefault();
            var listaCupom = [];

            $('tr[name="itemLancarCupom"]').each(function(){
                var id = $(this).attr('id');
                var descricao = $(this).find('.td-descricao').text();
                var valor = $(this).find('.td-valor').text();
                listaCupom.push({ Id: id, Descricao: descricao, ValorItem: valor });
            });

            //Feito pelo Kiro em 01/05/2026
            // Exibe loading enquanto salva e prepara o cupom
            Swal.fire({
                title: 'Aguarde...',
                html: 'Salvando requisição e preparando cupom',
                imageUrl: '../images/icones/attention-icon.png',
                imageHeight: 80,
                showConfirmButton: false,
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => { Swal.showLoading(); }
            });
            //..Kiro

            $.ajax({
                url: '@Url.Action("SalvarRequisicao", "Requisitar")',
                type: "POST",
                async: true,
                data: $('#formRequisitar').serialize(),
                success: function (data) {
                    var titulo = data['titulo'] ?? 'Atenção';
                    var mensagem = data['mensagem'];
                    var actionPos = data['action'];
                    var sucesso = data['sucesso'];
                    var tipo = sucesso ? 'sucesso' : 'falha';
            
                    //Se salvou com sucesso, solicita impressão do cupom via backend
                    if (sucesso === true && data.pacienteId) {
                        const idPaciente = data.pacienteId;
                        const tabelaExamesId = data.tabelaExamesId || 0;
                        const urlCupom = `/Requisitar/CupomRequisicao?idPaciente=${idPaciente}&tabelaExamesId=${tabelaExamesId}`;
            
                        $.ajax({
                            url: urlCupom,
                            type: "GET",
                            success: function (resultado) {
                                // O backend imprime diretamente via ImpressoraWindows (PrintDocument).
                                // Aqui apenas verificamos o status retornado.
                                Swal.close();
                                if (resultado.sucesso !== true) {
                                    clickAviso('Impressão', resultado.mensagem || 'Falha ao imprimir cupom.', 'falha');
                                }
                            },
                            error: function (request, status, error) {
                                Swal.close();
                                clickAviso('Erro', 'Falha na comunicação com o servidor de impressão', 'critica');  
                            }
                        });
                    } else {
                        // Sem impressão: fecha o loading e exibe mensagem
                        Swal.close();
                    }
            
                    //Atualiza a grid e exibe mensagem
                    $('#modeloTableRequisitar').DataTable().ajax.reload();

                    // Limpa o formulário após salvar com sucesso
                    if (sucesso === true) {
                        $('#buttonLimpaFormulario').trigger('click');
                        //Feito pelo Kiro em 02/05/2026
                        // Esvazia o cupom em tela e no servidor após salvamento
                        fetch('/PartialMontarItensCupom?id=0', { method: 'GET' })
                        .then(function (r) { return r.text(); })
                        .then(function (html) {
                            document.getElementById('conteudoItensCupomCaixa').innerHTML = html;
                        });
                        // Reseta o TabelaExamesIdOriginal (não é mais edição)
                        $('#tabelaExamesIdOriginal').val(0);
                        // Reseta o ExameRealizadoId (não é mais edição)
                        $('#exameRealizadoId').val(0);
                        //..Kiro
                    }
                    clickAviso(titulo, mensagem, tipo, actionPos);
                },
                error: function (request, status, error) {
                    Swal.close();
                    var detalhe = request.responseText ? request.responseText.substring(0, 200) : status;
                    clickAviso('Interrompido', 'Falha na execução: ' + detalhe, 'critica', null);
                }
            });
        });
        //..

    });  //Fim do $(document).ready
</script>
<!-- Só para indicar que este FORM está englobando TODAS as partials e também as "partials aninhadas" -->
<form id="formRequisitar" name="formRequisitar" asp-action="SalvarRequisicao" asp-controller="Requisitar" method="post">
    <!-- TRIGGER DO MODAL para todos os eventos de tela que são acionados por esta tela ou outras que são chamadas a partir desta -->
    <!-- QUALQUER MODAL ACIONADO APARECE AQUI NESTA POSIÇÃO -->
    <div id="modalTriggerPaciente"></div>
    <div id="modalTriggerInstituicao"></div>
    <div id="modalTriggerPosto"></div>
    <div id="modalTriggerMedico"></div>
    <div id="modalTriggerTabela"></div>
    <!-- Fim da trigger -->
    @{
        int i = 0;
    }
    @if (Model.ListaCupom == null)
    {
        <input type="hidden" name="ListaCupom[0].Id" value="0" />
        <input type="hidden" name="ListaCupom[0].Descricao" value="" />
        <input type="hidden" name="ListaCupom[0].ValorItem" value="0.00" />
    }
    else
    {
        i = Model.ListaCupom.Count;

        @foreach (var item in Model.ListaCupom)
        {
            <input type="hidden" name="ListaCupom[@i].Id" value="@item.Id" />
            <input type="hidden" name="ListaCupom[@i].Descricao" value="@item.Descricao" />
            <input type="hidden" name="ListaCupom[@i].ValorItem" value="@item.ValorItem" />
            i++;
        }
    }

    <div class="row">
        <div class="col-xl-5">
            <div class="card-secao">
                <div class="card-secao-header"><i class="fa-solid fa-user"></i> Dados do Paciente</div>
                <div class="card-secao-body">
                    <div class="tab-content" id="pills-tabContent">
                        <!-- opções das abas: -->
                        <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                            <li class="nav-item-tabs" role="presentation">
                                <button class="nav-link-tabs active" id="pills-simples-ttab" data-bs-toggle="pill" type="button">Formulário Simples</button>
                            </li>
                            <li class="nav-item-tabs" role="presentation">
                                <button class="nav-link-tabs" id="pills-completo-ttab" data-bs-toggle="pill" type="button">Formulário Completo</button>
                            </li>
                        </ul>
                        <div id="conteudoPartialFormulario"><partial name='Partials/_PartialFormulario'></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-7">
            <div class="card-secao">
                <div class="card-secao-header"><i class="fa-solid fa-flask-vial"></i> Dados dos Serviços</div>
                <div class="card-secao-body">
                    <div id="conteudoPartialExames"><partial name='Partials/_PartialExames'></div>
                </div>
            </div>
        </div>
    </div>
    <!--
    Submeter Formulário — botão oculto; o botão visível é #clickImprimeCupom em _PartialExames
    -->
    <div class="botao-centralizado" style="display:none;">
        <button id="clickSubmit" type="button" class="btn btn-lg btn-success botao-verde">
            Salvar Requisição de Exames
        </button>
    </div>
</form>
<div class="row">
    <div id="conteudo"><partial name='Partials/_PartialRequisitar' model='new List<vmRequisitarSimplificado>()'></div>
</div>
