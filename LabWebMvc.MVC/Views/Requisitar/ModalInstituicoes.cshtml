@using BLL
@using static BLL.UtilBLL
@using LabWebMvc.MVC.Interfaces
@using LabWebMvc.MVC.ViewModel
@model vmRequisitar
@* <!-- Esse Modal é uma tela de pesquisa/consulta de instituições --> *@
<script>
    $(document).ready(function () {

        // Inicializa DataTables e foca o Search somente após o modal estar visível
        document.getElementById('modeloTableModalInstituicao').addEventListener('shown.bs.modal', function () {
            if (!$.fn.dataTable.isDataTable('#tabelaInstituicao')) {
                configTableModal('#tabelaInstituicao');
            } else {
                $('#tabelaInstituicao').DataTable().columns.adjust();
            }
            var inputBusca = document.querySelector('#modeloTableModalInstituicao input[type="search"]');
            if (inputBusca) inputBusca.focus();
        });

        // Ao fechar o modal, move o foco para o próximo campo (Posto de Coleta)
        document.getElementById('modeloTableModalInstituicao').addEventListener('hidden.bs.modal', function () {
            if ($('#buscaSiglaInstituicao').val().trim().length > 0) {
                setTimeout(function () {
                    var campo = document.getElementById('buscaNomePosto');
                    if (campo) campo.focus();
                }, 100);
            }
        });

        function preencherFormularioInstituicao(vm) {
            var $conteudo = $("#conteudoInstituicao");
            //Feito pelo Qoder em 31/05/2026 - se a Instituição mudou, reseta o Posto antes; em seguida habilita o input.
            var idAnterior = parseInt($conteudo.find("#instituicaoId").val()) || 0;
            var idNovo = parseInt(vm.instituicaoId) || 0;
            if (idAnterior !== idNovo && typeof window.resetarPosto === 'function') {
                window.resetarPosto();
            }
            //..Qoder
            $conteudo.find("#buscaSiglaInstituicao").val(vm.siglaInstituicao);
            $conteudo.find("#buscaNomeInstituicao").val(vm.nomeInstituicao);
            $conteudo.find("#instituicaoId").val(vm.instituicaoId);  //o valor "id" aqui é o Id da primary key retornado!
            //Feito pelo Qoder em 31/05/2026 - habilita o input de Posto agora que há Instituição.
            if (idNovo > 0 && typeof window.habilitarPosto === 'function') {
                window.habilitarPosto(true);
            }
            //..Qoder
        }

        function ajaxFunction(valorSelecionado) {
            if (valorSelecionado.length > 0) {
                $.ajax({
                    url: '@Url.Action("RetornoDoModalInstituicoes", "Requisitar")',
                    type: "GET",
                    data: { id: valorSelecionado }, // ATENÇÃO: o valor "id" aqui é a Sigla!
                    cache: false,
                    dataType: "json",
                    success: function (data) {
                        if (!data.vm.siglaInstituicao || !data.vm.nomeInstituicao) {
                            clickAviso('Atenção', 'Não trouxe dados nesta busca', 'falha');
                            return;
                        }

                        // Preenchendo os campos após retornar do Controller
                        preencherFormularioInstituicao(data.vm);
                    },
                    error: function () {
                        clickAviso('Interrompido', 'Falha no carregamento dos dados', 'falha');
                    },
                }).done(function () {
                    ModalManager.fechar('modeloTableModalInstituicao');
                });
            }
        }
        //..

        // Feito pelo Qoder em 21/04/2026 — ENTER seleciona a primeira linha visível do DataTables
        $(document).on("keydown", "#modeloTableModalInstituicao input[type='search']", function (event) {
            if (event.keyCode === 13) {
                event.preventDefault();
                var table = $('#tabelaInstituicao').DataTable();
                var linhasVisiveis = table.rows({ filter: 'applied' }).nodes();

                if (linhasVisiveis.length > 0) {
                    // td:eq(0) contém checkbox + Sigla; pega o id do td que é a própria Sigla
                    var siglaInstituicao = $(linhasVisiveis[0]).find('td:eq(0)').attr('id');
                    ajaxFunction(siglaInstituicao);
                    ModalManager.fechar('modeloTableModalInstituicao');
                } else {
                    clickAviso('Atenção', 'Nenhuma instituição encontrada com essa busca', 'falha');
                }
            }
        });
        // ..Qoder
        //..

        //Controlando o input checkbox pelo TR e TD
        $(document).on('click', '#modeloTableModalInstituicao tbody tr', function (event) {
            var $checkbox = $(this).find("input[type='checkbox']");
            if ($checkbox.length === 0) return; // ignora thead e linhas sem checkbox

            $checkbox.closest('table').find("input[type='checkbox']").prop('checked', false);
            $checkbox.prop('checked', true);

            var valorSelecionado = $checkbox.attr('id').replace('chk_', '');
            ajaxFunction(valorSelecionado);
            ModalManager.fechar('modeloTableModalInstituicao');
        });
        //..
    });
</script>
<div class="modal fade" id="modeloTableModalInstituicao" tabindex="-1" aria-labelledby="tituloModalInstituicao" aria-hidden="true">
    <div class="modal-dialog modal-dialog-top modal-dialog-largo">
        <div class="modal-content shadow rounded">
            <div class="modal-header bg-verde-escuro">
                <h5 class="modal-title" id="tituloModalInstituicao">@ViewBag.TextoMenu[0]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="card-secao">
                    <div class="card-secao-body">
                        <div class="table-responsive">
                            <table id="tabelaInstituicao" name="datatable" class="table table-striped table-hover table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th><div class="theadModal">Sigla</div></th>
                                <th><div class="theadModal">Nome</div></th>
                                <th class="text-end"><div class="theadModal">Id</div></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ListaInstituicoes != null)
                            {
                                @foreach (var item in Model.ListaInstituicoes)
                                {
                                    <tr id="tr_@item.Sigla" name="trModal" title="Selecionar" style="width: 90%;">
                                        <td id="@item.Sigla" style="width:10%;"><input id="chk_@item.Sigla" name="input" type="checkbox" /> @item.Sigla</td>
                                        <td id="@item.Sigla" style="width:60%;"> @item.Nome</td>
                                        <td id="@item.Id"> @item.Id</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3">Nenhum registro encontrado.</td>
                                </tr>
                            }
                        </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<!-- Fim da página do Modal -->

