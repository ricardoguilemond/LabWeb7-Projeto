@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using static BLL.UtilBLL
@using LabWebMvc.MVC.Interfaces.Collections
@using LabWebMvc.MVC.ViewModel
@model vmRequisitar
<style>
    .tb-cupom {
        width: 100%;
    }

    .tr-todo {
        width: 100%;
    }

    .td-descricao {
        width: 90%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .td-valor {
        width: 10%;
        text-align: right;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .td-negrito {
        font-weight: bold;  
    }

    .tr-foot-fundo {
        background-color: #c4d7b3 !important;
    }
</style>
<script>
    //Feito pelo Qoder em 12/08/2026
    // Reinicializa o DataTable do cupom sempre que a partial for renderizada.
    // O localStorage anterior impedia a reexecução após recargas via AJAX.
    $(document).ready(function () {
        if ($.fn.dataTable.isDataTable('#modeloTableCupom')) {
            $('#modeloTableCupom').DataTable().destroy();
        }
        configTableCupom();
    }); //FIM do $(document).ready
    //..Qoder
</script>
<div class="table-responsive">
    <table id="modeloTableCupom" name="datatable" data-order='[[ 0, "asc" ]]' class="display compact order-column table-striped table-hover nowrap tb-cupom" style="margin-top: 4px;">
        <thead>
            <tr>
                <th><span style="font-size: 12px !important;">Exame</span></th>
                <th><span style="font-size: 12px !important;">Valor</span></th>
            </tr>
        </thead>
        <tbody id="conteudoItensCupomCaixa"><partial name='Partials/_PartialMontarItensCupom'></partial></tbody> <!-- monta apenas os registros dentro do grid do cupom -->
    </table>
</div>
