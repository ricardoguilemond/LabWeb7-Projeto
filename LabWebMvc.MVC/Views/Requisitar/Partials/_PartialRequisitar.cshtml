    //Feito pelo Qoder em 16/08/2026
    // Converte valor digitado no padrão brasileiro: com vírgula, o ponto é milhar
    // ("1.234,56"); sem vírgula, o ponto é aceito como separador decimal ("52.54").
    function parseValorPortaria(texto) {
        texto = (texto || '').trim();
        if (!texto) return 0;
        if (texto.indexOf(',') >= 0) {
            return parseFloat(texto.replace(/\./g, '').replace(',', '.')) || 0;
        }
        return parseFloat(texto) || 0;
    }
    //..Qoder

    //Feito pelo Qoder em 16/08/2026
    // Modo "cobrar da Instituição": oculta o cartão de formas e renomeia o total a receber.
    function aplicarModoCobrancaInstituicao() {
        var marcado = $('#chkCobrarInstituicaoPortaria').is(':checked');
        $('#cardFormasPortaria').toggle(!marcado);
        $('#lblTotalReceberPortaria').text(marcado ? 'Valor a Cobrar da Instituição' : 'Total a Receber');
    }
    //..Qoder

    function calcularTotaisFormasPortaria() {
        var total = 0;
        $('#tblFormasPortaria tbody tr').each(function () {
            var valor = parseValorPortaria($(this).find('.forma-valor-portaria').val());
            total += valor;
        });

        var valorTotalTexto = $('#txtValorTotalPortaria').val().replace('.', '').replace(',', '.');
        var valorTotal = parseFloat(valorTotalTexto) || 0;
        //Feito pelo Qoder em 16/08/2026 — diferença calculada sobre o total a receber (total - desconto)
        var desconto = parseValorPortaria($('#txtDescontoPortaria').val());
        var totalEsperado = Math.max(valorTotal - desconto, 0);
        $('#txtTotalReceberPortaria').val(totalEsperado.toFixed(2).replace('.', ','));
        var diferenca = total - totalEsperado;
        //..Qoder

        $('#lblTotalFormasPortaria').text(total.toFixed(2).replace('.', ','));
        $('#lblDiferencaPortaria').text(diferenca.toFixed(2).replace('.', ','));

        var cor = diferenca === 0 ? 'text-success' : 'text-danger';
        $('#lblDiferencaPortaria').removeClass('text-success text-danger').addClass(cor);
    }

    function salvarRecebimentoPortaria() {
        if (!_dadosExamePortaria) {
            clickAviso('Erro', 'Dados do exame não carregados.', 'critica', null);
            return;
        }

        var exameRealizadoId = parseInt($('#hddExameRealizadoIdPortaria').val()) || 0;
        var pacienteId = parseInt($('#hddPacienteIdPortaria').val()) || 0;
        var instituicaoId = parseInt($('#hddInstituicaoIdPortaria').val()) || 0;
        var valorTotalTexto = $('#txtValorTotalPortaria').val().replace('.', '').replace(',', '.');
        var valorTotal = parseFloat(valorTotalTexto) || 0;

        //Feito pelo Qoder em 16/08/2026 — desconto concedido: a soma das formas confere com o total a receber
        var desconto = parseValorPortaria($('#txtDescontoPortaria').val());
        if (desconto < 0) {
            clickAviso('Atenção', 'O desconto não pode ser negativo.', 'falha', null);
            return;
        }
        if (desconto > valorTotal) {
            clickAviso('Atenção', 'O desconto não pode ser maior que o valor total do exame.', 'falha', null);
            return;
        }
        var totalEsperado = valorTotal - desconto;
        //..Qoder

        //Feito pelo Qoder em 16/08/2026 — cobrança à instituição: sem formas no ato
        var cobrarInstituicao = $('#chkCobrarInstituicaoPortaria').is(':checked');
        var formas = [];
        if (!cobrarInstituicao) {
            var formasValidas = true;
            $('#tblFormasPortaria tbody tr').each(function () {
                var formaId = parseInt($(this).find('.forma-id-portaria').val()) || 0;
                var contaId = parseInt($(this).find('.conta-id-portaria').val()) || 0;
                var valor = parseValorPortaria($(this).find('.forma-valor-portaria').val());
                var data = $(this).find('.forma-data-portaria').val();
                var obs = $(this).find('.forma-obs-portaria').val();

                if (formaId <= 0 || contaId <= 0) {
                    clickAviso('Atenção', 'Selecione a forma e a conta em todas as linhas.', 'falha', null);
                    formasValidas = false;
                    return false;
                }

                //Feito pelo Qoder em 16/08/2026 — valor, data e observação obrigatórios em cada linha
                if (valor <= 0) {
                    clickAviso('Atenção', 'Informe um valor maior que zero em todas as linhas.', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                if (!data) {
                    clickAviso('Atenção', 'Informe a data em todas as linhas.', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                if (!(obs || '').trim()) {
                    clickAviso('Atenção', 'Informe a observação em todas as linhas (use "." se necessário).', 'falha', null);
                    formasValidas = false;
                    return false;
                }
                //..Qoder

                formas.push({
                    FormaRecebimentoId: formaId,
                    ContaRecebimentoId: contaId,
                    Valor: valor,
                    DataRecebimento: data,
                    Observacao: obs
                });
            });

            if (!formasValidas) {
                return;
            }

            if (formas.length === 0) {
                clickAviso('Atenção', 'Informe pelo menos uma forma de recebimento.', 'falha', null);
                return;
            }

            var totalFormas = formas.reduce(function (acc, f) { return acc + f.Valor; }, 0);
            if (Math.abs(totalFormas - totalEsperado) > 0.01) {
                clickAviso('Atenção', 'A soma das formas deve ser igual ao total a receber (valor total menos desconto).', 'falha', null);
                return;
            }
        }
        //..Qoder

        var dados = {
            Origem: 1,
            InstituicaoId: instituicaoId,
            PacienteId: pacienteId,
            ValorTotal: valorTotal,
            //Feito pelo Qoder em 16/08/2026
            ValorDesconto: desconto,
            CobrancaInstituicao: cobrarInstituicao,
            //..Qoder
            DataRecebimento: $('#txtDataRecebimentoPortaria').val(),
            Observacao: $('#txtObservacaoPortaria').val(),
            ExamesRealizadosIds: [exameRealizadoId],
            Formas: formas
        };

        //Feito pelo Qoder em 16/08/2026
        // Bloqueia duplo clique no Confirmar Recebimento: desabilita o botão até a resposta.
        var btnConfirmar = $('#btnConfirmarRecebimentoPortaria');
        if (btnConfirmar.prop('disabled')) return;
        btnConfirmar.prop('disabled', true);
        //..Qoder

        //Feito pelo Qoder em 16/08/2026
        // Loading padrão do sistema (overlay modalLoading) durante o delay do confirmar recebimento.
        if (typeof ShowProgress === 'function') ShowProgress();
        //..Qoder
        $.ajax({
            url: '/CatalogoRecebimentos/SalvarRecebimentoPortaria',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dados),
            success: function (res) {
                if (res.sucesso) {
                    $('#modalRecebimentoPortaria').modal('hide');
                    $('#modeloTableRequisitar').DataTable().ajax.reload();
                    clickAviso('Sucesso', res.mensagem, 'sucesso', null);
                } else {
                    clickAviso('Atenção', res.mensagem, 'falha', null);
                }
            },
            error: function () {
                clickAviso('Erro', 'Erro ao salvar recebimento na portaria.', 'critica', null);
            },
            //Feito pelo Qoder em 16/08/2026
            complete: function () {
                if (typeof esconderLoading === 'function') esconderLoading();
                btnConfirmar.prop('disabled', false);
            }
            //..Qoder
        });
    }

    $(document).ready(function () {
        carregarDadosAuxiliaresPortaria();

        $('#btnAdicionarFormaPortaria').off('click.portaria').on('click.portaria', function () {
            adicionarLinhaFormaPortaria();
        });

        $('#tblFormasPortaria tbody').off('click.portaria').on('click.portaria', '.btn-remover-forma-portaria', function () {
            $(this).closest('tr').remove();
            calcularTotaisFormasPortaria();
        });

        $('#tblFormasPortaria tbody').off('input.portaria').on('input.portaria', '.forma-valor-portaria', function () {
            calcularTotaisFormasPortaria();
        });

        //Feito pelo Qoder em 16/08/2026 — recalcular total a receber ao digitar o desconto
        $('#txtDescontoPortaria').off('input.portaria').on('input.portaria', function () {
            calcularTotaisFormasPortaria();
        });
        //..Qoder

        //Feito pelo Qoder em 16/08/2026 — alternar modo de cobrança à instituição
        $('#chkCobrarInstituicaoPortaria').off('change.portaria').on('change.portaria', function () {
            aplicarModoCobrancaInstituicao();
            calcularTotaisFormasPortaria();
        });
        //..Qoder

        //Feito pelo Qoder em 16/08/2026 — ao clicar no campo Valor, apaga o conteúdo para nova digitação
        $('#tblFormasPortaria tbody').off('focus.portaria').on('focus.portaria', '.forma-valor-portaria', function () {
            $(this).val('');
        });
        //..Qoder

        //Feito pelo Qoder em 16/08/2026 — idem para o campo Desconto
        $('#txtDescontoPortaria').off('focus.portaria').on('focus.portaria', function () {
            $(this).val('');
        });
        //..Qoder

        $('#btnConfirmarRecebimentoPortaria').off('click.portaria').on('click.portaria', function () {
            salvarRecebimentoPortaria();
        });
    });
    // ..Qoder
</script>

<!-- Modal de Recebimento na Portaria -->
<div class="modal fade" id="modalRecebimentoPortaria" tabindex="-1" aria-labelledby="modalRecebimentoPortariaLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalRecebimentoPortariaLabel"><i class="fa-solid fa-cash-register"></i> Recebimento na Portaria</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hddExameRealizadoIdPortaria" />
                <input type="hidden" id="hddPacienteIdPortaria" />
                <input type="hidden" id="hddInstituicaoIdPortaria" />
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Paciente</label>
                        <input type="text" id="txtPacientePortaria" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Instituição</label>
                        <input type="text" id="txtInstituicaoPortaria" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Valor Total</label>
                        <input type="text" id="txtValorTotalPortaria" class="form-control form-control-sm text-end fw-bold" readonly />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Data do Recebimento</label>
                        <input type="date" id="txtDataRecebimentoPortaria" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    @*Feito pelo Qoder em 16/08/2026 — desconto concedido no recebimento e total efetivo a receber*@
                    <div class="col-md-4">
                        <label class="form-label">Desconto</label>
                        <input type="text" inputmode="decimal" id="txtDescontoPortaria" class="form-control form-control-sm text-end" value="0,00" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" id="lblTotalReceberPortaria">Total a Receber</label>
                        <input type="text" id="txtTotalReceberPortaria" class="form-control form-control-sm text-end fw-bold" readonly />
                    </div>
                    @*..Qoder*@
                </div>

                @*Feito pelo Qoder em 16/08/2026 — opção de cobrar da Instituição sem receber do paciente*@
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="chkCobrarInstituicaoPortaria" />
                    <label class="form-check-label fw-bold" for="chkCobrarInstituicaoPortaria">Não receber do paciente — cobrar da Instituição</label>
                </div>
                @*..Qoder*@

                <div class="card" id="cardFormasPortaria">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-wallet"></i> Formas de Recebimento</span>
                        <button type="button" id="btnAdicionarFormaPortaria" class="btn btn-sm btn-success"><i class="fa-solid fa-plus"></i> Adicionar</button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm" id="tblFormasPortaria">
                                <thead>
                                    <tr>
                                        <th>Forma</th>
                                        <th>Conta</th>
                                        <th>Valor</th>
                                        <th>Data</th>
                                        <th>Observação</th>
                                        <th style="width:40px;"></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="2" class="text-end">Total Informado:</th>
                                        <th class="text-end" id="lblTotalFormasPortaria">0,00</th>
                                        <th colspan="3"></th>
                                    </tr>
                                    <tr>
                                        <th colspan="2" class="text-end">Diferença:</th>
                                        <th class="text-end" id="lblDiferencaPortaria">0,00</th>
                                        <th colspan="3"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="txtObservacaoPortaria" class="form-label">Outras observações</label>
                    <textarea id="txtObservacaoPortaria" class="form-control form-control-sm" rows="2" maxlength="2000"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarRecebimentoPortaria" class="btn btn-primary"><i class="fa-solid fa-save"></i> Confirmar Recebimento</button>
            </div>
        </div>
    </div>
</div>

