        //..Qoder

        var linha = '<tr>' +
            '<td><select class="form-select form-select-sm forma-id-portaria">' + optionsFormas + '</select></td>' +
            '<td><select class="form-select form-select-sm conta-id-portaria">' + optionsContas + '</select></td>' +
            //Feito pelo Qoder em 16/08/2026
            // Campo em texto com inputmode decimal: type="number" descartava a vírgula
            // (separador decimal pt-BR), transformando 52,54 em 5254.
            '<td><input type="text" inputmode="decimal" class="form-control form-control-sm text-end forma-valor-portaria" value="" placeholder="0,00" /></td>' +
            //..Qoder
            '<td><input type="date" class="form-control form-control-sm forma-data-portaria" value="' + new Date().toISOString().split('T')[0] + '" /></td>' +
            '<td><input type="text" class="form-control form-control-sm forma-obs-portaria" maxlength="2000" /></td>' +
