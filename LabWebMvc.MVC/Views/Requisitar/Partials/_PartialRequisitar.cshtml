@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using LabWebMvc.MVC.ViewModel
@model List<vmRequisitarSimplificado>

<style>
    /* Barra superior/head igual ao rodapé/bottom */
    #wrapperRequisitar .dt-scroll-top {
        overflow-x: auto;
        overflow-y: hidden;
        height: 16px;
        margin-bottom: 4px;
    }

    #wrapperRequisitar .dt-scroll-top-inner {
        height: 1px;
    }
    /* .. */

    /*Feito pelo Kiro em 01/05/2026*/
    .btn-grid-req {
        border: none;
        border-radius: 3px;
        width: 22px;
        height: 22px;
        padding: 0;
        cursor: pointer;
        font-size: 11px;
        line-height: 22px;
        text-align: center;
        display: inline-block;
        margin: 0 1px;
    }
    /* Botões verde, amarelo e vermelho para cada linha do grid */
    .btn-grid-req-verde   { background-color: #28a745; color: white; }
    .btn-grid-req-amarelo { background-color: #ffc107; color: #333;  }
    .btn-grid-req-vermelho{ background-color: #dc3545; color: white; }
    .btn-grid-req-azul    { background-color: #0d6efd; color: white; }
    .btn-grid-req:hover   { opacity: 0.82; }

    /* Ajustando o tamanho dos fontes dos títulos dos campos, por Ricardo em 01/05/2026 */
    #wrapperRequisitar table.dataTable thead th,
    #wrapperRequisitar table.dataTable thead th span,
    #wrapperRequisitar table.dataTable thead th .dt-column-title,
    #wrapperRequisitar table.dataTable thead th .dt-column-order,
    #wrapperRequisitar table.dataTable tfoot th,
    #wrapperRequisitar table.dataTable tfoot th span,
    #wrapperRequisitar table.dataTable tfoot th .dt-column-title {
        font-size: 14px !important;
        line-height: 22px !important;
    }

    /* Larguras reais das 4 colunas fixas, por Ricardo Guilemond em 01/05/2026 */
    #modeloTableRequisitar th:nth-child(1),
    #modeloTableRequisitar td:nth-child(1) {
        min-width: 50px !important;
        width: 50px !important;
        max-width: 50px !important;
    }

    #modeloTableRequisitar th:nth-child(2),
    #modeloTableRequisitar td:nth-child(2) {
        min-width: 80px !important;
        width: 80px !important;
        max-width: 80px !important;
    }

    #modeloTableRequisitar th:nth-child(3),
    #modeloTableRequisitar td:nth-child(3) {
        min-width: 180px !important;
        width: 180px !important;
        max-width: 180px !important;
    }

    #modeloTableRequisitar th:nth-child(4),
    #modeloTableRequisitar td:nth-child(4) {
        min-width: 90px !important;
        width: 90px !important;
        max-width: 90px !important;
    }

    /* CSS sticky por Ricardo Guilemond em 01/05/2026 */
    #modeloTableRequisitar th:nth-child(1),
    #modeloTableRequisitar td:nth-child(1) {
        position: sticky !important;
        left: 0 !important;
        z-index: 10;
    }

    #modeloTableRequisitar th:nth-child(2),
    #modeloTableRequisitar td:nth-child(2) {
        position: sticky !important;
        left: 50px !important;
        z-index: 10;
    }

    #modeloTableRequisitar th:nth-child(3),
    #modeloTableRequisitar td:nth-child(3) {
        position: sticky !important;
        left: 130px !important;
        z-index: 10;
    }

    #modeloTableRequisitar th:nth-child(4),
    #modeloTableRequisitar td:nth-child(4) {
        position: sticky !important;
        left: 310px !important;
        z-index: 10;
        box-shadow: 3px 0 5px -2px rgba(0,0,0,0.25);
    }

    /* Para o cabeçalho ficar acima das células */
    #modeloTableRequisitar thead th:nth-child(-n+4) {
        z-index: 20 !important;
        background-color: #72c187 !important;
    }

    #modeloTableRequisitar tbody td:nth-child(-n+4) {
        background-color: #f8f9fa !important;
    }

    /* Impede overflow de texto em colunas com nomes longos (Instituição, Tabela, etc.) */
    #modeloTableRequisitar td {
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
    }
    /* .. */

    /* Zebra e hover nas colunas fixas */
    #modeloTableRequisitar tbody tr:nth-child(odd)  td:nth-child(-n+4) { background-color: #f2f2f2; }
    #modeloTableRequisitar tbody tr:nth-child(even) td:nth-child(-n+4) { background-color: #ffffff; }
    #modeloTableRequisitar tbody tr:hover           td:nth-child(-n+4) { background-color: #d2d2d2 !important; }

    /*
     * Sobrescreve o width:100%!important do mydatatables.css para este grid.
     * Com scrollX:true o DataTables precisa que a tabela tenha largura natural
     * (soma das colunas) para que o scroll horizontal apareça no rodapé.
     */
    #modeloTableRequisitar {
        width: auto !important;
    }
    /*..Kiro*/

    /* Feito pelo Qoder em 31/05/2026 — estilos master/detail inline */
    #modeloTableRequisitar tbody tr.detail-row {
        background-color: #f0f8f0 !important;
        font-size: 13px;
        pointer-events: none;
    }
    #modeloTableRequisitar tbody tr.detail-row td {
        padding: 4px 8px !important;
        border-top: none !important;
        color: #555;
        background-color: #f0f8f0 !important;
        white-space: normal !important;
    }
    #modeloTableRequisitar tbody tr.detail-header-row {
        background-color: #d4edda !important;
        font-size: 13px;
        font-weight: bold;
        pointer-events: none;
    }
    #modeloTableRequisitar tbody tr.detail-header-row td {
        padding: 5px 8px !important;
        color: #333;
        background-color: #d4edda !important;
        white-space: nowrap !important;
    }
    #modeloTableRequisitar tbody tr.detail-parent-highlight td:nth-child(-n+4) {
        background-color: #fff3cd !important;
    }
    #modeloTableRequisitar tbody tr.detail-parent-highlight td {
        background-color: #fff3cd !important;
    }
    /* ..Qoder */
</style>

<script>
    //Feito pelo Kiro em 01/05/2026
    // Configuração EXCLUSIVA do DataTables para o Grid de Requisições do Dia.
    // scrollX:true gera o div.dt-scroll-body com overflow-x:auto (barra horizontal no rodapé).
    // autoWidth:false respeita as larguras fixas por coluna.
    // As 4 primeiras colunas são fixadas via CSS sticky (style acima).
    // initComplete cria a barra de scroll superior no momento exato da renderização.
    $(document).ready(function () {
        if ($.fn.dataTable.isDataTable('#modeloTableRequisitar')) {
            $('#modeloTableRequisitar').DataTable().destroy();
        }

        // Cria inputs de busca por coluna no footer
        $('#modeloTableRequisitar tfoot th').each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" placeholder="' + title + '" style="max-width: 106px; padding-left: 4px; border: 1px solid gray; border-radius: 5px;" />');
        });

        const modeloTable = $('#modeloTableRequisitar').DataTable({
            ajax: {
                url: '/Requisitar/GetLancamentosHoje',
                dataSrc: 'data',
                error: function (xhr, error, thrown) {
                    console.error('GetLancamentosHoje erro:', xhr.status, xhr.responseText, thrown);
                }
            },
            columns: [
                {
                    data: 'exameRealizadoId',
                    width: '50px',
                    render: function (data) {
                        return (data === null || data === 0) ? '-' : data;
                    }
                },
                { data: 'pacienteId',         width: '80px'  },
                { data: 'nomePaciente',       width: '180px' },
                { data: 'nascimento',         width: '90px'  },
                { data: 'nomeInstituicao',    width: '280px' },
                {
                    data: 'nomePosto',
                    width: '90px',
                    render: function (data) {
                        return (data === '-') ? '-' : data;
                    }
                },
                { data: 'nomeTabela',         width: '320px' },
                {
                    data: 'laboratorioApoio',
                    width: '120px',
                    render: function (data) {
                        return (data === '-') ? '-' : data;
                    }
                },
                { data: 'dataIni',            width: '90px'  },
                {
                    data: null,
                    width: '80px',
                    orderable: false,
                    searchable: false,
                    render: function (data, type, row) {
                        var btnReceber = (row.exameRealizadoId && row.exameRealizadoId > 0)
                            ? '<button class="btn-grid-req btn-grid-req-azul" title="Receber" onclick="abrirRecebimentoPortaria(' + row.exameRealizadoId + ')"><i class="fa-solid fa-cash-register"></i></button>'
                            : '';
                        return '<button class="btn-grid-req btn-grid-req-verde"    title="Reimprimir cupom"   onclick="reimprimirCupom('   + row.pacienteId + ', \'' + row.dataIni + '\')" ><i class="fa-solid fa-print"></i></button>'
                             + '<button class="btn-grid-req btn-grid-req-amarelo"  title="Editar requisição"  onclick="editarRequisicao('  + row.pacienteId + ', \'' + row.dataIni + '\', ' + row.tabelaExamesId + ')" ><i class="fa-solid fa-pen"></i></button>'
                             + '<button class="btn-grid-req btn-grid-req-vermelho" title="Excluir requisição" onclick="excluirRequisicao(' + row.pacienteId + ', \'' + row.dataIni + '\', ' + row.tabelaExamesId + ', ' + (row.exameRealizadoId || 0) + ')" ><i class="fa-solid fa-trash"></i></button>'
                             + btnReceber;
                    }
                }
            ],
            //Feito pelo Kiro em 01/05/2026
            // Centraliza o traço (-) nas colunas Posto (5) e Lab. Apoio (7).
            // O DataTables 2.x envolve o conteúdo do <td> em <span> internos,
            // por isso o text-align é aplicado tanto no <td> quanto no <span>.
            createdRow: function (row, data) {
                if (data.nomePosto === '-') {
                    var td = $('td', row).eq(5);
                    td.css('text-align', 'center');
                    td.find('span').css('text-align', 'center');
                }
                if (data.laboratorioApoio === '-') {
                    var td = $('td', row).eq(7);
                    td.css('text-align', 'center');
                    td.find('span').css('text-align', 'center');
                }
            },
            //..Kiro
            scrollX: true,
            autoWidth: false,
            responsive: false,
            order: [[0, 'desc']],
            layout: {
                topStart: {
                    pageLength: {
                        menu: [[10, 25, 50, -1], [10, 25, 50, "Todos"]]
                    }
                },
                topEnd: {
                    search: { placeholder: 'Buscar...' }
                },
                bottomStart: 'info',
                bottomEnd: {
                    paging: { numbers: 5 }
                }
            },
            language: {
                search: "Busca:",
                lengthMenu: "Mostrar _MENU_ resultados por página",
                emptyTable: "<b style='color: red;'>Não haviam dados disponíveis para esta consulta</b>",
                info: "Exibindo: _START_/_END_ de _TOTAL_ registros",
                infoFiltered: "(Total de _MAX_ registros existentes na base de dados)",
                infoThousands: ".",
                thousands: ".",
                decimal: ",",
                loadingRecords: "Carregando...",
                zeroRecords: "<b style='color: red;'>A consulta não retornou dados para o Grid</b>",
                paginate: {
                    next: "<img src='images/icones/arrow_right_uno.png' width='28%' border='none' />",
                    previous: "<img src='images/icones/arrow_left_uno.png' width='28%' border='none' />",
                    first: "<img src='images/icones/arrow_left.png' width='28%' border='none' />",
                    last: "<img src='images/icones/arrow_right.png' width='28%' border='none' />"
                }
            },
            /* Barra de rolagem superior — criada via initComplete em vez de setTimeout.
               Executa no momento exato em que o DataTables termina de renderizar,
               eliminando o delay arbitrário de 300ms. Por Ricardo Guilemond / Kiro em 01/05/2026 */
            initComplete: function () {
                // Filtro por coluna no footer
                this.api().columns().every(function () {
                    var that = this;
                    $('input', this.footer()).on('keyup change clear', function () {
                        if (that.search() !== this.value) {
                            that.search(this.value).draw();
                        }
                    });
                });

                // Barra de rolagem superior
                var $wrapper = $('#wrapperRequisitar');
                var $bodyScroll = $wrapper.find('.dt-scroll-body');

                if ($bodyScroll.length === 0) return;

                if ($wrapper.find('.dt-scroll-top').length === 0) {
                    $bodyScroll.before(
                        '<div class="dt-scroll-top">' +
                            '<div class="dt-scroll-top-inner"></div>' +
                        '</div>'
                    );
                }

                var $topScroll = $wrapper.find('.dt-scroll-top');
                var $topInner = $wrapper.find('.dt-scroll-top-inner');

                $topInner.width($bodyScroll.get(0).scrollWidth);

                $topScroll.on('scroll', function () {
                    $bodyScroll.scrollLeft(this.scrollLeft);
                });

                $bodyScroll.on('scroll', function () {
                    $topScroll.scrollLeft(this.scrollLeft);
                });
            }
        });

    });
    //..Kiro

    //Feito pelo Kiro em 01/05/2026

    // Converte data "dd/MM/yyyy" para objeto Date e retorna no formato "yyyy-MM-dd" para o backend
    function parseDateGrid(dataBruta) {
        var partes = dataBruta.split('/');
        if (partes.length !== 3) return null;
        return partes[2] + '-' + partes[1] + '-' + partes[0]; // yyyy-MM-dd
    }

    // 3.1 — Reimprimir cupom (botão verde)
    function reimprimirCupom(pacienteId, dataIni) {
        var dataFormatada = parseDateGrid(dataIni);
        if (!dataFormatada) {
            clickAviso('Erro', 'Formato de data inválido', 'falha', null);
            return;
        }
        fetch('/Requisitar/CupomRequisicao', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idPaciente: pacienteId, data: dataFormatada })
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            clickAviso(data.titulo ?? 'Atenção', data.mensagem ?? '', data.sucesso ? 'sucesso' : 'falha', null);
        })
        .catch(function () {
            clickAviso('Erro', 'Falha ao reimprimir o cupom', 'critica', null);
        });
    }

    // 3.2 — Carregar para edição (botão amarelo)
    function editarRequisicao(pacienteId, dataIni, tabelaExamesId) {
        $.ajax({
            url: '/Requisitar/CarregarRequisicaoParaEdicao',
            type: 'GET',
            data: { pacienteId: pacienteId, data: dataIni, tabelaExamesId: tabelaExamesId },
            cache: false,
            dataType: 'json',
            success: function (data) {
                if (!data.sucesso) {
                    clickAviso('Edição não permitida', data.mensagem, 'falha', null);
                    return;
                }

                // Preenche dados do paciente
                var $pac = $("#conteudoPaciente");
                $pac.find("#pacienteId").val(data.pacienteId);
                $pac.find("#pacienteIdVisivel").val(data.pacienteId > 0 ? data.pacienteId : '');
                $pac.find("#buscaNomePaciente").val(data.nomePaciente);
                $pac.find("#Nascimento").val(data.nascimento);
                $pac.find("#CPFPaciente").val(data.cpfPaciente);
                $pac.find("#Telefone").val(data.telefone);
                $pac.find("#Email").val(data.email);
                $pac.find("#Mae").val(data.nomeMae);
                $pac.find("#Naturalidade").val(data.naturalidade);
                $pac.find("#Nacionalidade").val(data.nacionalidade);
                $pac.find("#Profissao").val(data.profissao);
                $pac.find("#CEP").val(data.cep);
                $pac.find("#Logradouro").val(data.logradouro);
                $pac.find("#Endereco").val(data.endereco);
                $pac.find("#Numero").val(data.numero);
                $pac.find("#Complemento").val(data.complemento);
                $pac.find("#Bairro").val(data.bairro);
                $pac.find("#Cidade").val(data.cidade);
                $pac.find("#Observacao").val(data.observacao);
                $pac.find("select[name='vmGeral.TipoUF']").val(data.uf);
                $pac.find("select[name='vmGeral.TipoTempoGestacao']").val(data.tempoGestacao);
                $pac.find("input[name='Sexo'][value='" + data.sexo + "']").prop("checked", true);
                $pac.find("input[name='EstadoCivil'][value='" + data.estadoCivil + "']").prop("checked", true);
                $pac.find("input[name='VmPacientes.DUM']").val(data.dum);

                // Preenche médico
                var $med = $("#conteudoMedico");
                $med.find("#medicoId").val(data.medicoId);
                $med.find("#buscaNomeMedico").val(data.nomeMedico);
                $med.find("#buscaCRM").val(data.crm);

                // Preenche instituição
                var $inst = $("#conteudoInstituicao");
                $inst.find("#instituicaoId").val(data.instituicaoId);
                $inst.find("#buscaSiglaInstituicao").val(data.siglaInstituicao);
                $inst.find("#buscaNomeInstituicao").val(data.nomeInstituicao);

                // Preenche posto
                var $posto = $("#conteudoPosto");
                $posto.find("#postoId").val(data.postoId);
                $posto.find("#buscaNomePosto").val(data.nomePosto);
                //Feito pelo Qoder em 31/05/2026 - habilita o input de Posto quando carrega Requisição existente com Instituição.
                if ((parseInt(data.instituicaoId) || 0) > 0 && typeof window.habilitarPosto === 'function') {
                    window.habilitarPosto(true);
                }
                //..Qoder

                // Preenche tabela
                var $tab = $("#conteudoTabela");
                $tab.find("#tabelaExamesId").val(data.tabelaExamesId);
                $tab.find("#buscaSiglaTabela").val(data.siglaTabela);
                $tab.find("#buscaNomeTabela").val(data.nomeTabela);

                //Feito pelo Kiro em 02/05/2026
                // Armazena o TabelaExamesId original para que o SalvarRequisicao
                // saiba qual requisição excluir ao trocar de tabela durante a edição.
                $('#tabelaExamesIdOriginal').val(data.tabelaExamesId);
                //..Kiro

                //Feito pelo Kiro em 03/05/2026
                // Armazena o ExameRealizadoId para que o SalvarRequisicao
                // saiba se é edição (> 0) ou inclusão nova (0).
                $('#exameRealizadoId').val(data.exameRealizadoId || 0);
                //..Kiro

                // Recarrega o grid de exames da tabela selecionada
                var urlPartialLancarExames = '@Url.Action("PartialLancarExames", "Requisitar")';
                $('#conteudoListaDeExames').load(urlPartialLancarExames + '?tabelaExamesId=' + data.tabelaExamesId, function () {
                    //Feito pelo Qoder em 12/08/2026
                    // A partial carregada via AJAX não executa seu $(document).ready,
                    // então é necessário re-inicializar o grid de exames manualmente.
                    if (typeof window.inicializarLancarExames === 'function') {
                        window.inicializarLancarExames();
                    }
                    //..Qoder
                });

                //Feito pelo Kiro em 02/05/2026
                // Recarrega o cupom com os itens de exame da requisição existente.
                fetch('/Requisitar/CarregarCupomEdicao?pacienteId=' + data.pacienteId + '&data=' + data.dataIni, {
                    method: 'GET'
                })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    document.getElementById('conteudoItensCupomCaixa').innerHTML = html;
                })
                .catch(function () {
                    console.error('Falha ao recarregar o cupom para edição');
                });

                // Força scroll ao topo após todas as operações assíncronas
                // (load da tabela de exames + configTableCompacta + cupom).
                // O delay de 500ms garante que o reflow do DataTables termine.
                setTimeout(function () {
                    window.scrollTo({ top: 0 });
                }, 500);
                //..Kiro
            },
            error: function () {
                clickAviso('Erro', 'Falha ao carregar a requisição para edição', 'critica', null);
            }
        });
    }

    // 3.3 — Excluir requisição (botão vermelho)
    function excluirRequisicao(pacienteId, dataIni, tabelaExamesId, exameRealizadoId) {
        var dataFormatada = parseDateGrid(dataIni);
        if (!dataFormatada) {
            clickAviso('Erro', 'Formato de data inválido', 'falha', null);
            return;
        }

        Swal.fire({
            title: 'Confirmar exclusão',
            html: 'Todos os itens de exame desta requisição serão excluídos.<br>O cadastro do paciente e do médico serão mantidos.<br><br>Deseja continuar?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sim, excluir',
            cancelButtonText: 'Cancelar'
        }).then(function (result) {
            if (!result.isConfirmed) return;

            fetch('/Requisitar/ExcluirRequisicao', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    idPaciente: pacienteId,
                    data: dataFormatada,
                    tabelaExamesId: tabelaExamesId || 0,
                    exameRealizadoId: exameRealizadoId || 0
                })
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                clickAviso(data.sucesso ? 'Excluído' : 'Não permitido', data.mensagem, data.sucesso ? 'sucesso' : 'falha', null);
                if (data.sucesso) {
                    $('#modeloTableRequisitar').DataTable().ajax.reload();
                }
            })
            .catch(function () {
                clickAviso('Erro', 'Falha ao excluir a requisição', 'critica', null);
            });
        });
    }
    //..Kiro

    // Feito pelo Qoder em 31/05/2026
    // Master/detail inline — ao clicar em uma linha do grid, expande os itens
    // de exame (tabela Requisitar) vinculados ao ExameRealizadoId daquela sessão.
    $(document).ready(function () {
        $(document).off('click.detailReq').on('click.detailReq', '#modeloTableRequisitar tbody tr', function (e) {
            // Ignora cliques nos botões de ação e nas próprias linhas de detalhe
            if ($(e.target).closest('.btn-grid-req').length) return;
            if ($(this).hasClass('detail-row') || $(this).hasClass('detail-header-row')) return;

            var $row = $(this);
            var rowData = $('#modeloTableRequisitar').DataTable().row($row).data();
            if (!rowData || !rowData.exameRealizadoId) return;
            var exameRealizadoId = rowData.exameRealizadoId;

            // Se a mesma linha já estava aberta, fecha (toggle)
            var jaAberta = $row.hasClass('detail-parent-highlight');
            $('#modeloTableRequisitar tbody tr.detail-row, #modeloTableRequisitar tbody tr.detail-header-row').remove();
            $('#modeloTableRequisitar tbody tr.detail-parent-highlight').removeClass('detail-parent-highlight');
            if (jaAberta) return;

            $row.addClass('detail-parent-highlight');
            carregarItensRequisicao($row, exameRealizadoId);
        });
    });

    function carregarItensRequisicao($row, exameRealizadoId) {
        $.ajax({
            url: '/Requisitar/GetItensRequisicao',
            data: { exameRealizadoId: exameRealizadoId },
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (data.sucesso && data.itens && data.itens.length > 0) {
                    renderizarDetailRequisicao($row, data.itens);
                } else {
                    var vazio = '<tr class="detail-row"><td colspan="10" style="text-align:center; font-style:italic;">Nenhum item encontrado para esta sessão.</td></tr>';
                    $row.after(vazio);
                }
            },
            error: function () {
                var erro = '<tr class="detail-row"><td colspan="10" style="text-align:center; color:#dc3545;">Falha ao carregar itens de exame.</td></tr>';
                $row.after(erro);
            }
        });
    }

    function renderizarDetailRequisicao($row, itens) {
        // Cabeçalho do detail — 10 colunas no grid principal
        var headerHtml = '<tr class="detail-header-row">' +
            '<td>Ordem</td>' +
            '<td colspan="2">Folha de Exame</td>' +
            '<td colspan="2" style="white-space:nowrap;">Conta Exame</td>' +
            '<td colspan="2">Descrição do Item</td>' +
            '<td style="text-align:right;">Valor</td>' +
            '<td style="text-align:center;">Etiquetas</td>' +
            '<td></td>' +
            '</tr>';
        $row.after(headerHtml);

        var $ultimo = $row.next();
        var totalGeral = 0;
        itens.forEach(function (item) {
            var rowHtml = '<tr class="detail-row">' +
                '<td>' + (item.ordemItem != null ? item.ordemItem : '-') + '</td>' +
                '<td colspan="2"> ' + (item.classeExamesNome || '-') + '</td>' +
                '<td colspan="2" style="white-space:nowrap;">' + (item.contaExame || '-') + '</td>' +
                '<td colspan="2">' + (item.descricao || '-') + '</td>' +
                '<td style="text-align:right;">' + (item.valorItem || '-') + '</td>' +
                '<td style="text-align:center;">' + (item.etiquetas != null ? item.etiquetas : 0) + '</td>' +
                '<td></td>' +
                '</tr>';
            $ultimo.after(rowHtml);
            $ultimo = $ultimo.next();

            var v = (item.valorItem || '0').replace(/\./g, '').replace(',', '.');
            var n = parseFloat(v);
            if (!isNaN(n)) totalGeral += n;
        });

        var totalFmt = totalGeral.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        var totalHtml = '<tr class="detail-row" style="font-weight:bold;">' +
            '<td colspan="7" style="text-align:right;">Total:</td>' +
            '<td style="text-align:right;">R$ ' + totalFmt + '</td>' +
            '<td colspan="2"></td>' +
            '</tr>';
        $ultimo.after(totalHtml);
    }
    // ..Qoder

    // Feito pelo Qoder em 2026
    // Catálogo de Recebimentos — Lançamento rápido na Portaria
    var _listaFormasPortaria = [];
    var _listaContasPortaria = [];
    var _dadosExamePortaria = null;

    function carregarDadosAuxiliaresPortaria() {
        $.get('/CatalogoRecebimentos/DadosAuxiliares')
            .done(function (res) {
                if (res.sucesso) {
                    _listaFormasPortaria = res.formas;
                    _listaContasPortaria = res.contas;
                }
            });
    }

    function abrirRecebimentoPortaria(exameRealizadoId) {
        var auxiliaresProntos = (_listaFormasPortaria.length > 0 && _listaContasPortaria.length > 0)
            ? $.Deferred().resolve().promise()
            : $.get('/CatalogoRecebimentos/DadosAuxiliares').done(function (res) {
                if (res.sucesso) {
                    _listaFormasPortaria = res.formas;
                    _listaContasPortaria = res.contas;
                }
            });

        auxiliaresProntos.always(function () {
            if (_listaFormasPortaria.length === 0 || _listaContasPortaria.length === 0) {
                clickAviso('Atenção', 'Formas ou contas de recebimento não disponíveis.', 'falha', null);
                return;
            }

            $.ajax({
                url: '/CatalogoRecebimentos/ObterDadosRecebimentoPortaria',
                type: 'GET',
                data: { exameRealizadoId: exameRealizadoId },
                dataType: 'json',
                success: function (res) {
                    if (!res.sucesso) {
                        clickAviso('Atenção', res.mensagem, 'falha', null);
                        return;
                    }

                    _dadosExamePortaria = res.exame;
                    $('#hddExameRealizadoIdPortaria').val(res.exame.exameRealizadoId);
                    $('#hddPacienteIdPortaria').val(res.exame.pacienteId);
                    $('#hddInstituicaoIdPortaria').val(res.exame.instituicaoId);
                    $('#txtPacientePortaria').val(res.exame.nomePaciente);
                    $('#txtInstituicaoPortaria').val(res.exame.siglaInstituicao);
                    $('#txtValorTotalPortaria').val(res.exame.valorTotal.toFixed(2).replace('.', ','));
                    $('#txtDataRecebimentoPortaria').val(new Date().toISOString().split('T')[0]);
                    $('#txtObservacaoPortaria').val('');

                    $('#tblFormasPortaria tbody').empty();
                    adicionarLinhaFormaPortaria();
                    calcularTotaisFormasPortaria();

                    $('#modalRecebimentoPortaria').modal('show');
                },
                error: function () {
                    clickAviso('Erro', 'Falha ao carregar dados do recebimento.', 'critica', null);
                }
            });
        });
    }

    function adicionarLinhaFormaPortaria() {
        var optionsFormas = _listaFormasPortaria.map(function (f) {
            return '<option value="' + f.id + '">' + f.nome + '</option>';
        }).join('');

        var optionsContas = _listaContasPortaria.map(function (c) {
            return '<option value="' + c.id + '">' + c.nome + '</option>';
        }).join('');

        var linha = '<tr>' +
            '<td><select class="form-select form-select-sm forma-id-portaria">' + optionsFormas + '</select></td>' +
            '<td><select class="form-select form-select-sm conta-id-portaria">' + optionsContas + '</select></td>' +
            '<td><input type="number" step="0.01" class="form-control form-control-sm text-end forma-valor-portaria" value="0,00" /></td>' +
            '<td><input type="date" class="form-control form-control-sm forma-data-portaria" value="' + new Date().toISOString().split('T')[0] + '" /></td>' +
            '<td><input type="text" class="form-control form-control-sm forma-obs-portaria" maxlength="2000" /></td>' +
            '<td><button type="button" class="btn btn-sm btn-danger btn-remover-forma-portaria"><i class="fa-solid fa-trash"></i></button></td>' +
            '</tr>';

        $('#tblFormasPortaria tbody').append(linha);
    }

    function calcularTotaisFormasPortaria() {
        var total = 0;
        $('#tblFormasPortaria tbody tr').each(function () {
            var valor = parseFloat($(this).find('.forma-valor-portaria').val().replace('.', '').replace(',', '.')) || 0;
            total += valor;
        });

        var valorTotalTexto = $('#txtValorTotalPortaria').val().replace('.', '').replace(',', '.');
        var valorTotal = parseFloat(valorTotalTexto) || 0;
        var diferenca = total - valorTotal;

        $('#lblTotalFormasPortaria').text(total.toFixed(2).replace('.', ','));
        $('#lblDiferencaPortaria').text(diferenca.toFixed(2).replace('.', ','));

        var cor = diferenca === 0 ? 'text-success' : 'text-danger';
        $('#lblDiferencaPortaria').removeClass('text-success text-danger').addClass(cor);
    }

    function salvarRecebimentoPortaria() {
        if (!_dadosExamePortaria) {
            clickAviso('Erro', 'Dados do exame não carregados.', 'critica', null);
            return;
        }

        var exameRealizadoId = parseInt($('#hddExameRealizadoIdPortaria').val()) || 0;
        var pacienteId = parseInt($('#hddPacienteIdPortaria').val()) || 0;
        var instituicaoId = parseInt($('#hddInstituicaoIdPortaria').val()) || 0;
        var valorTotalTexto = $('#txtValorTotalPortaria').val().replace('.', '').replace(',', '.');
        var valorTotal = parseFloat(valorTotalTexto) || 0;

        var formas = [];
        var formasValidas = true;
        $('#tblFormasPortaria tbody tr').each(function () {
            var formaId = parseInt($(this).find('.forma-id-portaria').val()) || 0;
            var contaId = parseInt($(this).find('.conta-id-portaria').val()) || 0;
            var valor = parseFloat($(this).find('.forma-valor-portaria').val().replace('.', '').replace(',', '.')) || 0;
            var data = $(this).find('.forma-data-portaria').val();
            var obs = $(this).find('.forma-obs-portaria').val();

            if (formaId <= 0 || contaId <= 0) {
                formasValidas = false;
                return false;
            }

            formas.push({
                FormaRecebimentoId: formaId,
                ContaRecebimentoId: contaId,
                Valor: valor,
                DataRecebimento: data,
                Observacao: obs
            });
        });

        if (!formasValidas) {
            clickAviso('Atenção', 'Selecione a forma e a conta em todas as linhas.', 'falha', null);
            return;
        }

        if (formas.length === 0) {
            clickAviso('Atenção', 'Informe pelo menos uma forma de recebimento.', 'falha', null);
            return;
        }

        var totalFormas = formas.reduce(function (acc, f) { return acc + f.Valor; }, 0);
        if (Math.abs(totalFormas - valorTotal) > 0.01) {
            clickAviso('Atenção', 'A soma das formas deve ser igual ao valor total do exame.', 'falha', null);
            return;
        }

        var dados = {
            Origem: 1,
            InstituicaoId: instituicaoId,
            PacienteId: pacienteId,
            ValorTotal: valorTotal,
            DataRecebimento: $('#txtDataRecebimentoPortaria').val(),
            Observacao: $('#txtObservacaoPortaria').val(),
            ExamesRealizadosIds: [exameRealizadoId],
            Formas: formas
        };

        $.ajax({
            url: '/CatalogoRecebimentos/SalvarRecebimentoPortaria',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dados),
            success: function (res) {
                if (res.sucesso) {
                    $('#modalRecebimentoPortaria').modal('hide');
                    $('#modeloTableRequisitar').DataTable().ajax.reload();
                    clickAviso('Sucesso', res.mensagem, 'sucesso', null);
                } else {
                    clickAviso('Atenção', res.mensagem, 'falha', null);
                }
            },
            error: function () {
                clickAviso('Erro', 'Erro ao salvar recebimento na portaria.', 'critica', null);
            }
        });
    }

    $(document).ready(function () {
        carregarDadosAuxiliaresPortaria();

        $('#btnAdicionarFormaPortaria').off('click.portaria').on('click.portaria', function () {
            adicionarLinhaFormaPortaria();
        });

        $('#tblFormasPortaria tbody').off('click.portaria').on('click.portaria', '.btn-remover-forma-portaria', function () {
            $(this).closest('tr').remove();
            calcularTotaisFormasPortaria();
        });

        $('#tblFormasPortaria tbody').off('input.portaria').on('input.portaria', '.forma-valor-portaria', function () {
            calcularTotaisFormasPortaria();
        });

        $('#btnConfirmarRecebimentoPortaria').off('click.portaria').on('click.portaria', function () {
            salvarRecebimentoPortaria();
        });
    });
    // ..Qoder
</script>

