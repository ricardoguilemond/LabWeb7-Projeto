    // 3.3 — Excluir requisição (botão vermelho)
    function excluirRequisicao(pacienteId, dataIni, tabelaExamesId, exameRealizadoId) {
        var dataFormatada = parseDateGrid(dataIni);
        if (!dataFormatada) {
            clickAviso('Erro', 'Formato de data inválido', 'falha', null);
            return;
        }

        Swal.fire({
            title: 'Confirmar exclusão',
            html: 'Todos os itens de exame desta requisição serão excluídos.<br>O cadastro do paciente e do médico serão mantidos.<br><br>Deseja continuar?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sim, excluir',
            cancelButtonText: 'Cancelar'
        }).then(function (result) {
            if (!result.isConfirmed) return;

            fetch('/Requisitar/ExcluirRequisicao', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    idPaciente: pacienteId,
                    data: dataFormatada,
                    tabelaExamesId: tabelaExamesId || 0,
                    exameRealizadoId: exameRealizadoId || 0
                })
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                clickAviso(data.sucesso ? 'Excluído' : 'Não permitido', data.mensagem, data.sucesso ? 'sucesso' : 'falha', null);
                if (data.sucesso) {
                    $('#modeloTableRequisitar').DataTable().ajax.reload();
                }
            })
            .catch(function () {
                clickAviso('Erro', 'Falha ao excluir a requisição', 'critica', null);
            });
        });
    }

