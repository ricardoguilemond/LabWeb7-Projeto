    function atualizarAlertaPendentes(quantidade) {
        var $contador = $('#contadorPendentesGrid');
        var $banner = $('#bannerExamesPendentes');
        var $texto = $('#textoBannerExamesPendentes');

        if (quantidade > 0) {
            $contador.text(quantidade + ' pendente' + (quantidade > 1 ? 's' : '') + ' há +24h');
            $contador.show();
            $texto.text('Atenção: há ' + quantidade + ' exame(s) lançado(s) há mais de 24 horas aguardando envio para análise. ');
            $banner.show();
        } else {
            $contador.hide();
            $banner.hide();
        }
    }

    function iniciarVerificacaoPendentes() {
        verificarExamesPendentes();
        if (intervaloVerificacaoPendentes) clearInterval(intervaloVerificacaoPendentes);
        intervaloVerificacaoPendentes = setInterval(verificarExamesPendentes, 600000); // 10 minutos
    }

    function pararVerificacaoPendentes() {
        if (intervaloVerificacaoPendentes) clearInterval(intervaloVerificacaoPendentes);
    }

    // Feito pelo Qoder em 15/08/2026 — filtro rápido "Ver" no banner: mostra apenas
    // exames com mais de 24 horas. Binding delegado ($(document).on) porque o banner
    // é renderizado DEPOIS deste script no DOM — o binding direto anterior nunca
    // era anexado e o clique não fazia nada. Segundo clique limpa o filtro.
    var filtroPendentes24hAtivo = false;

    function filtroPendentes24h(settings, data) {
        if (settings.nTable.id !== 'modeloTableRequisitar') return true;
        var dataBr = data[8]; // coluna DT Entrada (índice 8)
        if (!dataBr) return false;
        var partes = dataBr.split('/');
        var dataCell = new Date(partes[2], partes[1] - 1, partes[0]);
        var limite = new Date();
        limite.setHours(limite.getHours() - 24);
        return dataCell < limite;
    }

    $(document).on('click', '#lnkVerExamesPendentes', function () {
        var table = $('#modeloTableRequisitar').DataTable();
        if (!filtroPendentes24hAtivo) {
            $.fn.dataTable.ext.search.push(filtroPendentes24h);
            filtroPendentes24hAtivo = true;
            $(this).text('Limpar');
            table.draw();
            clickAviso('Filtro aplicado', 'Exibindo apenas exames pendentes há mais de 24 horas. Clique em "Limpar" no banner para remover o filtro.', 'sucesso', null);
        } else {
            var idx = $.fn.dataTable.ext.search.indexOf(filtroPendentes24h);
            if (idx >= 0) $.fn.dataTable.ext.search.splice(idx, 1);
            filtroPendentes24hAtivo = false;
            $(this).text('Ver');
            table.draw();
            //Feito pelo Qoder em 15/08/2026 — se não houver mais pendências,
            // o banner e o contador devem sumir da tela imediatamente.
            verificarExamesPendentes();
            //..Qoder
        }
    });
